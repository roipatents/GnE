<Project>
  <UsingTask TaskName="RoiBuildActionsWriteMacBundleVersionManifestTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestPath ParameterType="System.String" Required="true" />
      <BundleShortVersion ParameterType="System.String" Required="true" />
      <BundleVersion ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string fullPath = Path.GetFullPath(ManifestPath);
        Directory.CreateDirectory(Path.GetDirectoryName(fullPath));

        var settings = new XmlWriterSettings
        {
            Encoding = new UTF8Encoding(encoderShouldEmitUTF8Identifier: false),
            Indent = true,
            NewLineChars = Environment.NewLine
        };
        using (var writer = XmlWriter.Create(fullPath, settings))
        {
            writer.WriteStartDocument();
            writer.WriteDocType(
                "plist",
                "-//Apple//DTD PLIST 1.0//EN",
                "http://www.apple.com/DTDs/PropertyList-1.0.dtd",
                null);
            writer.WriteStartElement("plist");
            writer.WriteAttributeString("version", "1.0");
            writer.WriteStartElement("dict");
            writer.WriteElementString("key", "CFBundleShortVersionString");
            writer.WriteElementString("string", BundleShortVersion);
            writer.WriteElementString("key", "CFBundleVersion");
            writer.WriteElementString("string", BundleVersion);
            writer.WriteEndElement();
            writer.WriteEndElement();
            writer.WriteEndDocument();
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="RoiBuildActionsValidateMacBundleVersionTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestPath ParameterType="System.String" Required="true" />
      <PlutilCli ParameterType="System.String" Required="true" />
      <ExpectedBundleShortVersion ParameterType="System.String" Required="true" />
      <ExpectedBundleVersion ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string ReadXmlValue(string key)
        {
            var settings = new XmlReaderSettings
            {
                DtdProcessing = DtdProcessing.Ignore,
                XmlResolver = null
            };
            using var reader = XmlReader.Create(ManifestPath, settings);
            var document = new XmlDocument { XmlResolver = null };
            document.Load(reader);
            XmlNode node = document.SelectSingleNode(
                "/plist/dict/key[text()='" + key + "']/following-sibling::*[1]");
            return node?.InnerText;
        }

        string QuoteArgument(string argument)
        {
            return "\"" + argument.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
        }

        string ReadBinaryValue(string key)
        {
            var startInfo = new ProcessStartInfo
            {
                FileName = PlutilCli,
                Arguments = "-extract " + QuoteArgument(key) + " raw -o - " + QuoteArgument(ManifestPath),
                UseShellExecute = false,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                CreateNoWindow = true
            };
            using var process = Process.Start(startInfo);
            if (process == null)
            {
                Log.LogError($"Failed to start {PlutilCli} while reading {key} from {ManifestPath}.");
                return null;
            }

            string output = process.StandardOutput.ReadToEnd();
            string error = process.StandardError.ReadToEnd();
            process.WaitForExit();
            if (process.ExitCode != 0)
            {
                Log.LogError(
                    $"{PlutilCli} could not read {key} from {ManifestPath} (exit code {process.ExitCode}): {error.Trim()}");
                return null;
            }
            return output.Trim();
        }

        if (!File.Exists(ManifestPath))
        {
            Log.LogError($"The finished macOS application manifest does not exist: {ManifestPath}");
            return false;
        }

        string actualShortVersion;
        string actualBundleVersion;
        try
        {
            actualShortVersion = ReadXmlValue("CFBundleShortVersionString");
            actualBundleVersion = ReadXmlValue("CFBundleVersion");
        }
        catch (XmlException)
        {
            actualShortVersion = ReadBinaryValue("CFBundleShortVersionString");
            actualBundleVersion = ReadBinaryValue("CFBundleVersion");
        }

        if (!string.Equals(actualShortVersion, ExpectedBundleShortVersion, StringComparison.Ordinal))
        {
            Log.LogError(
                $"The finished macOS application has CFBundleShortVersionString '{actualShortVersion ?? "<missing>"}', " +
                $"but the expected project-derived value is '{ExpectedBundleShortVersion}'. Manifest: {ManifestPath}");
        }
        if (!string.Equals(actualBundleVersion, ExpectedBundleVersion, StringComparison.Ordinal))
        {
            Log.LogError(
                $"The finished macOS application has CFBundleVersion '{actualBundleVersion ?? "<missing>"}', " +
                $"but the expected project-derived value is '{ExpectedBundleVersion}'. Manifest: {ManifestPath}");
        }
        if (Log.HasLoggedErrors)
        {
            return false;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="RoiBuildActionsVendorHomebrewBrotliTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ApplicationBundlePath ParameterType="System.String" Required="true" />
      <ApplicationSigningIdentity ParameterType="System.String" Required="true" />
      <FallbackEntitlementsPath ParameterType="System.String" Required="true" />
      <HomebrewPrefix ParameterType="System.String" Required="true" />
      <AdditionalAllowedPrefixes ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <OtoolCli ParameterType="System.String" Required="true" />
      <InstallNameToolCli ParameterType="System.String" Required="true" />
      <LipoCli ParameterType="System.String" Required="true" />
      <CodesignCli ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.ComponentModel" />
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string QuoteArgument(string argument)
        {
            var quoted = new StringBuilder(argument.Length + 2);
            quoted.Append('"');
            int backslashCount = 0;
            foreach (char character in argument)
            {
                if (character == '\\')
                {
                    backslashCount++;
                    continue;
                }

                if (character == '"')
                {
                    quoted.Append('\\', (backslashCount * 2) + 1);
                    quoted.Append(character);
                }
                else
                {
                    quoted.Append('\\', backslashCount);
                    quoted.Append(character);
                }
                backslashCount = 0;
            }
            quoted.Append('\\', backslashCount * 2);
            quoted.Append('"');
            return quoted.ToString();
        }

        (int ExitCode, string Output, string Error) RunTool(string cliPath, params string[] arguments)
        {
            var argumentText = new StringBuilder();
            foreach (string argument in arguments)
            {
                if (argumentText.Length > 0)
                {
                    argumentText.Append(' ');
                }
                argumentText.Append(QuoteArgument(argument));
            }

            var startInfo = new ProcessStartInfo
            {
                FileName = cliPath,
                Arguments = argumentText.ToString(),
                UseShellExecute = false,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                CreateNoWindow = true
            };
            try
            {
                using var process = Process.Start(startInfo);
                if (process == null)
                {
                    throw new InvalidOperationException($"Failed to start macOS packaging tool: {cliPath}");
                }

                System.Threading.Tasks.Task<string> standardOutput = process.StandardOutput.ReadToEndAsync();
                System.Threading.Tasks.Task<string> standardError = process.StandardError.ReadToEndAsync();
                process.WaitForExit();
                System.Threading.Tasks.Task.WaitAll(standardOutput, standardError);
                return (process.ExitCode, standardOutput.Result, standardError.Result);
            }
            catch (Win32Exception exception)
            {
                throw new InvalidOperationException($"Failed to start macOS packaging tool '{cliPath}': {exception.Message}", exception);
            }
        }

        string ReadSymbolicLinkTarget(string path)
        {
            var entry = new FileInfo(path);
            entry.Refresh();
            string linkTarget = typeof(FileSystemInfo).GetProperty("LinkTarget")
                ?.GetValue(entry) as string;
            if (!string.IsNullOrWhiteSpace(linkTarget))
            {
                return linkTarget;
            }
            var readLinkResult = RunTool("/usr/bin/readlink", path);
            return readLinkResult.ExitCode == 0
                ? readLinkResult.Output.TrimEnd('\r', '\n')
                : null;
        }

        string RequireTool(string operation, string cliPath, params string[] arguments)
        {
            var result = RunTool(cliPath, arguments);
            if (result.ExitCode != 0)
            {
                throw new InvalidOperationException(
                    $"{operation} failed with exit code {result.ExitCode}: {cliPath}. {result.Error.Trim()}");
            }
            if (!string.IsNullOrWhiteSpace(result.Error))
            {
                Log.LogMessage(MessageImportance.Low, result.Error.TrimEnd());
            }
            return result.Output;
        }

        var dependencyInspectionCache = new Dictionary<string, Dictionary<string, List<string>>>(StringComparer.Ordinal);
        var installIdInspectionCache = new Dictionary<string, Dictionary<string, List<string>>>(StringComparer.Ordinal);
        var runtimeSearchPathInspectionCache = new Dictionary<string, Dictionary<string, List<string>>>(StringComparer.Ordinal);
        var weakDependencyInspectionCache = new Dictionary<string, Dictionary<string, List<string>>>(StringComparer.Ordinal);
        var machOBundleInspectionCache = new Dictionary<string, bool>(StringComparer.Ordinal);
        var machOFileTypeInspectionCache = new Dictionary<string, Dictionary<string, HashSet<string>>>(StringComparer.Ordinal);
        var architectureInspectionCache = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);
        void ClearNativeInspectionCaches()
        {
            dependencyInspectionCache.Clear();
            installIdInspectionCache.Clear();
            runtimeSearchPathInspectionCache.Clear();
            weakDependencyInspectionCache.Clear();
            machOBundleInspectionCache.Clear();
            machOFileTypeInspectionCache.Clear();
            architectureInspectionCache.Clear();
        }

        void InvalidateNativeInspectionCaches(string binaryPath)
        {
            string cacheKey = ResolvePhysicalPath(binaryPath);
            dependencyInspectionCache.Remove(cacheKey);
            installIdInspectionCache.Remove(cacheKey);
            runtimeSearchPathInspectionCache.Remove(cacheKey);
            weakDependencyInspectionCache.Remove(cacheKey);
            machOBundleInspectionCache.Remove(cacheKey);
            machOFileTypeInspectionCache.Remove(cacheKey);
            architectureInspectionCache.Remove(cacheKey);
        }

        Dictionary<string, List<string>> ReadDependenciesByArchitecture(string binaryPath)
        {
            string cacheKey = ResolvePhysicalPath(binaryPath);
            if (dependencyInspectionCache.TryGetValue(cacheKey, out var cachedDependencies))
            {
                return cachedDependencies;
            }
            string output = RequireTool("Native dependency inspection", OtoolCli, "-arch", "all", "-L", binaryPath);
            var dependencies = new Dictionary<string, List<string>>(StringComparer.Ordinal);
            string architecture = "default";
            foreach (string rawLine in output.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
            {
                string trimmedLine = rawLine.Trim();
                const string architectureMarker = " (architecture ";
                int architectureIndex = trimmedLine.LastIndexOf(architectureMarker, StringComparison.Ordinal);
                int architectureEnd = trimmedLine.LastIndexOf("):", StringComparison.Ordinal);
                if (architectureIndex >= 0 && architectureEnd > architectureIndex + architectureMarker.Length)
                {
                    architecture = trimmedLine.Substring(
                        architectureIndex + architectureMarker.Length,
                        architectureEnd - architectureIndex - architectureMarker.Length);
                    continue;
                }
                if (rawLine.Length == 0 || !char.IsWhiteSpace(rawLine[0]))
                {
                    continue;
                }

                string dependency = trimmedLine;
                int metadataIndex = dependency.IndexOf(" (compatibility version", StringComparison.Ordinal);
                dependency = metadataIndex >= 0 ? dependency.Substring(0, metadataIndex) : dependency;
                if (!dependencies.TryGetValue(architecture, out List<string> architectureDependencies))
                {
                    architectureDependencies = new List<string>();
                    dependencies[architecture] = architectureDependencies;
                }
                architectureDependencies.Add(dependency);
            }
            dependencyInspectionCache[cacheKey] = dependencies;
            return dependencies;
        }

        Dictionary<string, List<string>> ReadInstallIdsByArchitecture(string binaryPath)
        {
            string cacheKey = ResolvePhysicalPath(binaryPath);
            if (installIdInspectionCache.TryGetValue(cacheKey, out var cachedInstallIds))
            {
                return cachedInstallIds;
            }
            string output = RequireTool("Native install-name inspection", OtoolCli, "-arch", "all", "-D", binaryPath);
            var installIds = new Dictionary<string, List<string>>(StringComparer.Ordinal);
            string architecture = "default";
            foreach (string rawLine in output.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
            {
                string trimmedLine = rawLine.Trim();
                const string architectureMarker = " (architecture ";
                int architectureIndex = trimmedLine.LastIndexOf(architectureMarker, StringComparison.Ordinal);
                int architectureEnd = trimmedLine.LastIndexOf("):", StringComparison.Ordinal);
                if (architectureIndex >= 0 && architectureEnd > architectureIndex + architectureMarker.Length)
                {
                    architecture = trimmedLine.Substring(
                        architectureIndex + architectureMarker.Length,
                        architectureEnd - architectureIndex - architectureMarker.Length);
                    continue;
                }
                if (trimmedLine.Length == 0 || trimmedLine.EndsWith(":", StringComparison.Ordinal))
                {
                    continue;
                }
                if (!installIds.TryGetValue(architecture, out List<string> architectureInstallIds))
                {
                    architectureInstallIds = new List<string>();
                    installIds[architecture] = architectureInstallIds;
                }
                architectureInstallIds.Add(trimmedLine);
            }
            installIdInspectionCache[cacheKey] = installIds;
            return installIds;
        }

        Dictionary<string, List<string>> ReadRuntimeSearchPathsByArchitecture(string binaryPath)
        {
            string cacheKey = ResolvePhysicalPath(binaryPath);
            if (runtimeSearchPathInspectionCache.TryGetValue(cacheKey, out var cachedRuntimeSearchPaths))
            {
                return cachedRuntimeSearchPaths;
            }
            string output = RequireTool("Native runtime search-path inspection", OtoolCli, "-arch", "all", "-l", binaryPath);
            var runtimeSearchPaths = new Dictionary<string, List<string>>(StringComparer.Ordinal);
            string architecture = "default";
            bool awaitingPath = false;
            foreach (string rawLine in output.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
            {
                string line = rawLine.Trim();
                const string architectureMarker = " (architecture ";
                int architectureIndex = line.LastIndexOf(architectureMarker, StringComparison.Ordinal);
                int architectureEnd = line.LastIndexOf("):", StringComparison.Ordinal);
                if (architectureIndex >= 0 && architectureEnd > architectureIndex + architectureMarker.Length)
                {
                    architecture = line.Substring(
                        architectureIndex + architectureMarker.Length,
                        architectureEnd - architectureIndex - architectureMarker.Length);
                    awaitingPath = false;
                    continue;
                }
                if (line.StartsWith("cmd ", StringComparison.Ordinal))
                {
                    awaitingPath = string.Equals(line.Substring("cmd ".Length).Trim(), "LC_RPATH", StringComparison.Ordinal);
                    continue;
                }
                if (!awaitingPath || !line.StartsWith("path ", StringComparison.Ordinal))
                {
                    continue;
                }

                string path = line.Substring("path ".Length);
                int metadataIndex = path.LastIndexOf(" (offset ", StringComparison.Ordinal);
                path = metadataIndex >= 0 ? path.Substring(0, metadataIndex) : path;
                if (!runtimeSearchPaths.TryGetValue(architecture, out List<string> architecturePaths))
                {
                    architecturePaths = new List<string>();
                    runtimeSearchPaths[architecture] = architecturePaths;
                }
                architecturePaths.Add(path);
                awaitingPath = false;
            }
            runtimeSearchPathInspectionCache[cacheKey] = runtimeSearchPaths;
            return runtimeSearchPaths;
        }

        Dictionary<string, List<string>> ReadWeakDependenciesByArchitecture(string binaryPath)
        {
            string cacheKey = ResolvePhysicalPath(binaryPath);
            if (weakDependencyInspectionCache.TryGetValue(cacheKey, out var cachedWeakDependencies))
            {
                return cachedWeakDependencies;
            }
            string output = RequireTool("Native weak-dependency inspection", OtoolCli, "-arch", "all", "-l", binaryPath);
            var weakDependencies = new Dictionary<string, List<string>>(StringComparer.Ordinal);
            string architecture = "default";
            bool awaitingName = false;
            foreach (string rawLine in output.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
            {
                string line = rawLine.Trim();
                const string architectureMarker = " (architecture ";
                int architectureIndex = line.LastIndexOf(architectureMarker, StringComparison.Ordinal);
                int architectureEnd = line.LastIndexOf("):", StringComparison.Ordinal);
                if (architectureIndex >= 0 && architectureEnd > architectureIndex + architectureMarker.Length)
                {
                    architecture = line.Substring(
                        architectureIndex + architectureMarker.Length,
                        architectureEnd - architectureIndex - architectureMarker.Length);
                    awaitingName = false;
                    continue;
                }
                if (line.StartsWith("cmd ", StringComparison.Ordinal))
                {
                    awaitingName = string.Equals(
                        line.Substring("cmd ".Length).Trim(),
                        "LC_LOAD_WEAK_DYLIB",
                        StringComparison.Ordinal);
                    continue;
                }
                if (!awaitingName || !line.StartsWith("name ", StringComparison.Ordinal))
                {
                    continue;
                }
                string dependency = line.Substring("name ".Length);
                int offsetIndex = dependency.LastIndexOf(" (offset ", StringComparison.Ordinal);
                dependency = offsetIndex >= 0 ? dependency.Substring(0, offsetIndex) : dependency;
                if (!weakDependencies.TryGetValue(architecture, out List<string> architectureDependencies))
                {
                    architectureDependencies = new List<string>();
                    weakDependencies[architecture] = architectureDependencies;
                }
                architectureDependencies.Add(dependency);
                awaitingName = false;
            }
            weakDependencyInspectionCache[cacheKey] = weakDependencies;
            return weakDependencies;
        }

        string FileNameFromLoadCommand(string loadCommand)
        {
            string normalized = loadCommand.Replace('\\', '/');
            int separatorIndex = normalized.LastIndexOf('/');
            return separatorIndex >= 0 ? normalized.Substring(separatorIndex + 1) : normalized;
        }

        StringComparison pathComparison = StringComparison.Ordinal;
        StringComparer pathComparer = StringComparer.Ordinal;
        StringComparison homebrewPathComparison = StringComparison.Ordinal;
        StringComparer homebrewPathComparer = StringComparer.Ordinal;

        string SourceIdentifier(string source)
        {
            string normalizedSource = Path.GetFullPath(source);
            if (homebrewPathComparison == StringComparison.OrdinalIgnoreCase)
            {
                normalizedSource = normalizedSource.ToUpperInvariant();
            }
            using var algorithm = SHA256.Create();
            byte[] digest = algorithm.ComputeHash(Encoding.UTF8.GetBytes(normalizedSource));
            return BitConverter.ToString(digest, 0, 6).Replace("-", string.Empty).ToLowerInvariant();
        }

        string NormalizeRoot(string path)
        {
            string fullPath = Path.GetFullPath(path);
            string pathRoot = Path.GetPathRoot(fullPath) ?? string.Empty;
            return string.Equals(fullPath, pathRoot, StringComparison.Ordinal)
                ? fullPath
                : fullPath.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        }

        string ResolvePhysicalPath(string path)
        {
            var linkTargetProperty = typeof(FileSystemInfo).GetProperty("LinkTarget");
            var resolveLinkTargetMethod = typeof(FileSystemInfo).GetMethod(
                "ResolveLinkTarget",
                new[] { typeof(bool) });
            string fullPath = Path.GetFullPath(path);
            string root = Path.GetPathRoot(fullPath)!;
            string currentPath = root;
            foreach (string segment in fullPath.Substring(root.Length).Split(
                new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar },
                StringSplitOptions.RemoveEmptyEntries))
            {
                currentPath = Path.Combine(currentPath, segment);
                FileSystemInfo entry = Directory.Exists(currentPath)
                    ? new DirectoryInfo(currentPath)
                    : (FileSystemInfo)new FileInfo(currentPath);
                string linkTarget = linkTargetProperty?.GetValue(entry) as string;
                if (string.IsNullOrWhiteSpace(linkTarget))
                {
                    continue;
                }
                FileSystemInfo resolvedTarget = resolveLinkTargetMethod?.Invoke(
                    entry,
                    new object[] { true }) as FileSystemInfo;
                if (resolvedTarget == null)
                {
                    throw new InvalidOperationException($"Could not resolve symbolic link '{currentPath}'.");
                }
                currentPath = ResolvePhysicalPath(resolvedTarget.FullName);
            }
            return Path.GetFullPath(currentPath);
        }

        bool IsCaseInsensitiveFileSystem(string existingPath)
        {
            try
            {
                string name = Path.GetFileName(existingPath);
                int letterIndex = name.IndexOfAny("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".ToCharArray());
                if (letterIndex < 0)
                {
                    return false;
                }
                char[] alternateName = name.ToCharArray();
                alternateName[letterIndex] = char.IsUpper(alternateName[letterIndex])
                    ? char.ToLowerInvariant(alternateName[letterIndex])
                    : char.ToUpperInvariant(alternateName[letterIndex]);
                string parent = Path.GetDirectoryName(existingPath)!;
                string alternatePath = Path.Combine(parent, new string(alternateName));
                if (!Directory.Exists(alternatePath) && !File.Exists(alternatePath))
                {
                    return false;
                }
                return Directory.EnumerateFileSystemEntries(parent)
                    .Count(entry => string.Equals(Path.GetFileName(entry), name, StringComparison.OrdinalIgnoreCase)) == 1;
            }
            catch (IOException)
            {
                return false;
            }
            catch (UnauthorizedAccessException)
            {
                return false;
            }
        }

        string PathForCaseSensitivityProbe(string existingPath)
        {
            if (!string.IsNullOrEmpty(Path.GetFileName(existingPath)))
            {
                return existingPath;
            }
            try
            {
                return Directory.EnumerateFileSystemEntries(existingPath)
                    .FirstOrDefault(entry => Path.GetFileName(entry)
                        .Any(character => char.IsLetter(character)))
                    ?? existingPath;
            }
            catch (IOException)
            {
                return existingPath;
            }
            catch (UnauthorizedAccessException)
            {
                return existingPath;
            }
        }

        StringComparison ComparisonForPathStorage(string path)
        {
            string existingPath = Path.GetFullPath(path);
            while (!Directory.Exists(existingPath) && !File.Exists(existingPath))
            {
                string parent = Path.GetDirectoryName(existingPath);
                if (string.IsNullOrWhiteSpace(parent) || parent == existingPath)
                {
                    return StringComparison.Ordinal;
                }
                existingPath = parent;
            }
            string physicalExistingPath = ResolvePhysicalPath(existingPath);
            return IsCaseInsensitiveFileSystem(PathForCaseSensitivityProbe(physicalExistingPath))
                ? StringComparison.OrdinalIgnoreCase
                : StringComparison.Ordinal;
        }

        IReadOnlyList<string> DistinctRuntimeSearchRoots(IEnumerable<string> roots)
        {
            var distinctRoots = new List<string>();
            foreach (string root in roots)
            {
                string fullRoot = Path.GetFullPath(root);
                StringComparison comparison = ComparisonForPathStorage(fullRoot);
                if (!distinctRoots.Any(existing => string.Equals(existing, fullRoot, comparison)))
                {
                    distinctRoots.Add(fullRoot);
                }
            }
            return distinctRoots;
        }

        bool IsSafeBundleDestinationDirectory(string path, string appPath)
        {
            string existingPath = Path.GetFullPath(path);
            while (!Directory.Exists(existingPath))
            {
                string parentPath = Path.GetDirectoryName(existingPath);
                if (string.IsNullOrWhiteSpace(parentPath) || parentPath == existingPath)
                {
                    return false;
                }
                existingPath = parentPath;
            }
            string physicalAppPath = ResolvePhysicalPath(appPath);
            string physicalExistingPath = ResolvePhysicalPath(existingPath);
            if (!IsWithinRoot(physicalExistingPath, physicalAppPath))
            {
                return false;
            }
            string physicalDestinationBundle = FindSigningBundle(
                Path.Combine(physicalExistingPath, "__roi_build_actions_destination_probe__"),
                physicalAppPath);
            return string.Equals(physicalDestinationBundle, physicalAppPath, pathComparison);
        }

        bool IsWithinRoot(string path, string root)
        {
            return IsWithinRootWithComparison(path, root, pathComparison);
        }

        bool IsWithinRootWithComparison(string path, string root, StringComparison comparison)
        {
            string fullPath = Path.GetFullPath(path);
            return string.Equals(fullPath, root, comparison)
                || fullPath.StartsWith(root + Path.DirectorySeparatorChar, comparison)
                || fullPath.StartsWith(root + Path.AltDirectorySeparatorChar, comparison);
        }

        void CopyDereferenced(string source, string destination)
        {
            File.Delete(destination);
            File.Copy(source, destination, overwrite: false);
            File.SetAttributes(destination, File.GetAttributes(destination) & ~FileAttributes.ReadOnly);
        }

        HashSet<string> ReadBinaryArchitectures(string binaryPath)
        {
            string physicalPath = ResolvePhysicalPath(binaryPath);
            if (!architectureInspectionCache.TryGetValue(
                    physicalPath,
                    out HashSet<string> architectures))
            {
                architectures = new HashSet<string>(
                    RequireTool("Native architecture inspection", LipoCli, "-archs", binaryPath)
                        .Split((char[])null, StringSplitOptions.RemoveEmptyEntries),
                    StringComparer.Ordinal);
                architectureInspectionCache[physicalPath] = architectures;
            }
            return architectures;
        }

        IEnumerable<string> CompatibleArchitectureNames(string architecture)
        {
            yield return architecture;
            if (string.Equals(architecture, "x86_64h", StringComparison.Ordinal))
            {
                yield return "x86_64";
            }
            else if (string.Equals(architecture, "arm64e", StringComparison.Ordinal))
            {
                yield return "arm64";
            }
        }

        bool ArchitecturesAreCompatible(string requiredArchitecture, IEnumerable<string> availableArchitectures)
        {
            var available = new HashSet<string>(availableArchitectures, StringComparer.Ordinal);
            return CompatibleArchitectureNames(requiredArchitecture).Any(available.Contains);
        }

        bool ExistingBinarySupportsArchitecture(
            string binaryPath,
            string architecture,
            string defaultArchitectureSource = null)
        {
            if (!File.Exists(binaryPath))
            {
                return false;
            }
            if (string.Equals(architecture, "default", StringComparison.Ordinal))
            {
                return string.IsNullOrWhiteSpace(defaultArchitectureSource)
                    || ReadBinaryArchitectures(defaultArchitectureSource)
                        .All(requiredArchitecture => ArchitecturesAreCompatible(
                            requiredArchitecture,
                            ReadBinaryArchitectures(binaryPath)));
            }
            return ArchitecturesAreCompatible(architecture, ReadBinaryArchitectures(binaryPath));
        }

        void ThinBinaryToArchitectures(string binaryPath, IEnumerable<string> requiredArchitectures)
        {
            string[] requiredArchitectureList = requiredArchitectures
                .Distinct(StringComparer.Ordinal)
                .ToArray();
            var currentArchitectures = new HashSet<string>(
                RequireTool("Native architecture inspection", LipoCli, "-archs", binaryPath)
                    .Split((char[])null, StringSplitOptions.RemoveEmptyEntries),
                StringComparer.Ordinal);
            if (currentArchitectures.SetEquals(requiredArchitectureList))
            {
                return;
            }

            string temporaryDirectory = Path.Combine(
                Path.GetTempPath(),
                "roi-build-actions-thin-" + Guid.NewGuid().ToString("N"));
            Directory.CreateDirectory(temporaryDirectory);
            try
            {
                var thinPaths = new List<string>();
                foreach (string architecture in requiredArchitectureList)
                {
                    string thinPath = Path.Combine(temporaryDirectory, architecture + ".dylib");
                    RequireTool(
                        "Native architecture extraction",
                        LipoCli,
                        binaryPath,
                        "-thin",
                        architecture,
                        "-output",
                        thinPath);
                    thinPaths.Add(thinPath);
                }

                if (thinPaths.Count == 1)
                {
                    CopyDereferenced(thinPaths[0], binaryPath);
                }
                else
                {
                    string rebuiltPath = Path.Combine(temporaryDirectory, "rebuilt.dylib");
                    RequireTool(
                        "Native architecture recombination",
                        LipoCli,
                        new[] { "-create", "-output", rebuiltPath }.Concat(thinPaths).ToArray());
                    CopyDereferenced(rebuiltPath, binaryPath);
                }
                InvalidateNativeInspectionCaches(binaryPath);
            }
            finally
            {
                Directory.Delete(temporaryDirectory, recursive: true);
            }
        }

        void RewriteLoadCommands(
            string binaryPath,
            IEnumerable<Tuple<string, string, string>> changes,
            IEnumerable<string> architectures,
            bool requireSliceSpecificRewrite,
            IEnumerable<Tuple<string, string>> runtimeSearchPathsToDelete = null)
        {
            var distinctChanges = changes
                .GroupBy(change => change.Item1 + "\u001f" + change.Item2 + "\u001f" + change.Item3,
                    StringComparer.Ordinal)
                .Select(group => group.First())
                .ToList();
            if (!requireSliceSpecificRewrite)
            {
                foreach (var change in distinctChanges
                    .GroupBy(item => item.Item2 + "\u001f" + item.Item3, StringComparer.Ordinal)
                    .Select(group => group.First()))
                {
                    RequireTool(
                        "Native library relocation",
                        InstallNameToolCli,
                        "-change",
                        change.Item2,
                        change.Item3,
                        binaryPath);
                }
                foreach (string runtimeSearchPath in (runtimeSearchPathsToDelete ?? new Tuple<string, string>[0])
                    .Select(item => item.Item2)
                    .Distinct(StringComparer.Ordinal))
                {
                    RequireTool(
                        "Homebrew runtime search-path removal",
                        InstallNameToolCli,
                        "-delete_rpath",
                        runtimeSearchPath,
                        binaryPath);
                }
                InvalidateNativeInspectionCaches(binaryPath);
                return;
            }

            string[] architectureList = architectures.Distinct(StringComparer.Ordinal).ToArray();
            if (architectureList.Length < 2)
            {
                RewriteLoadCommands(
                    binaryPath,
                    distinctChanges,
                    architectureList,
                    requireSliceSpecificRewrite: false,
                    runtimeSearchPathsToDelete);
                return;
            }

            string temporaryDirectory = Path.Combine(
                Path.GetTempPath(),
                "roi-build-actions-slices-" + Guid.NewGuid().ToString("N"));
            Directory.CreateDirectory(temporaryDirectory);
            try
            {
                var thinPaths = new List<string>();
                foreach (string architecture in architectureList)
                {
                    string thinPath = Path.Combine(temporaryDirectory, architecture + ".dylib");
                    RequireTool(
                        "Native architecture extraction",
                        LipoCli,
                        binaryPath,
                        "-thin",
                        architecture,
                        "-output",
                        thinPath);
                    thinPaths.Add(thinPath);
                    foreach (var change in distinctChanges.Where(change =>
                        change.Item1 == "default" || string.Equals(change.Item1, architecture, StringComparison.Ordinal)))
                    {
                        RequireTool(
                            "Native library relocation",
                            InstallNameToolCli,
                            "-change",
                            change.Item2,
                            change.Item3,
                            thinPath);
                    }
                    foreach (string runtimeSearchPath in (runtimeSearchPathsToDelete ?? new Tuple<string, string>[0])
                        .Where(item => item.Item1 == "default"
                            || string.Equals(item.Item1, architecture, StringComparison.Ordinal))
                        .Select(item => item.Item2)
                        .Distinct(StringComparer.Ordinal))
                    {
                        RequireTool(
                            "Homebrew runtime search-path removal",
                            InstallNameToolCli,
                            "-delete_rpath",
                            runtimeSearchPath,
                            thinPath);
                    }
                }

                string rebuiltPath = Path.Combine(temporaryDirectory, "rebuilt.dylib");
                RequireTool(
                    "Native architecture recombination",
                    LipoCli,
                    new[] { "-create", "-output", rebuiltPath }.Concat(thinPaths).ToArray());
                CopyDereferenced(rebuiltPath, binaryPath);
                InvalidateNativeInspectionCaches(binaryPath);
            }
            finally
            {
                Directory.Delete(temporaryDirectory, recursive: true);
            }
        }

        string ExtractValidPlist(string text)
        {
            int startIndex = text.IndexOf("<?xml", StringComparison.Ordinal);
            if (startIndex < 0)
            {
                startIndex = text.IndexOf("<plist", StringComparison.Ordinal);
            }
            int endIndex = text.LastIndexOf("</plist>", StringComparison.Ordinal);
            if (startIndex < 0 || endIndex < startIndex)
            {
                return null;
            }

            string plist = text.Substring(startIndex, endIndex + "</plist>".Length - startIndex);
            try
            {
                XDocument.Parse(plist);
                return plist;
            }
            catch (Exception exception) when (exception is System.Xml.XmlException || exception is InvalidOperationException)
            {
                return null;
            }
        }

        IEnumerable<string> FindCompressionLibraries(string bundlePath)
        {
            var directories = new Stack<string>();
            var visitedPhysicalDirectories = new HashSet<string>(pathComparer);
            string physicalBundlePath = ResolvePhysicalPath(bundlePath);
            directories.Push(bundlePath);
            while (directories.Count > 0)
            {
                string directory = directories.Pop();
                string physicalDirectory = ResolvePhysicalPath(directory);
                if (!IsWithinRoot(physicalDirectory, physicalBundlePath))
                {
                    continue;
                }

                string parent = Path.GetDirectoryName(directory)!;
                if (string.Equals(Path.GetFileName(directory), "MonoBundle", StringComparison.OrdinalIgnoreCase)
                    && string.Equals(Path.GetFileName(parent), "Contents", StringComparison.OrdinalIgnoreCase))
                {
                    string candidate = Path.Combine(directory, "libSystem.IO.Compression.Native.dylib");
                    if (File.Exists(candidate))
                    {
                        yield return candidate;
                    }
                }

                if (!visitedPhysicalDirectories.Add(physicalDirectory))
                {
                    continue;
                }
                foreach (string child in Directory.EnumerateDirectories(directory))
                {
                    string physicalChild = ResolvePhysicalPath(child);
                    if (!IsWithinRoot(physicalChild, physicalBundlePath))
                    {
                        continue;
                    }
                    directories.Push(child);
                }
            }
        }

        string FindCompressionContentsDirectory(string compressionPath, string signingBundlePath)
        {
            string monoBundlePath = Path.GetDirectoryName(compressionPath)!;
            string contentsPath = Path.GetDirectoryName(monoBundlePath)!;
            if (!string.Equals(Path.GetFileName(monoBundlePath), "MonoBundle", StringComparison.OrdinalIgnoreCase)
                || !string.Equals(Path.GetFileName(contentsPath), "Contents", StringComparison.OrdinalIgnoreCase)
                || !IsWithinRoot(contentsPath, signingBundlePath))
            {
                throw new InvalidOperationException(
                    $"Could not identify the Contents directory for compression library '{compressionPath}'.");
            }
            return contentsPath;
        }

        bool IsMachOFile(string path)
        {
            try
            {
                using var stream = File.OpenRead(path);
                var header = new byte[32];
                if (stream.Read(header, 0, 4) != 4)
                {
                    return false;
                }

                uint ReadUInt32(byte[] bytes, int offset, bool bigEndian)
                {
                    return bigEndian
                        ? ((uint)bytes[offset] << 24) | ((uint)bytes[offset + 1] << 16) | ((uint)bytes[offset + 2] << 8) | bytes[offset + 3]
                        : ((uint)bytes[offset + 3] << 24) | ((uint)bytes[offset + 2] << 16) | ((uint)bytes[offset + 1] << 8) | bytes[offset];
                }
                ulong ReadUInt64(byte[] bytes, int offset, bool bigEndian)
                {
                    uint first = ReadUInt32(bytes, offset, bigEndian);
                    uint second = ReadUInt32(bytes, offset + 4, bigEndian);
                    return bigEndian ? ((ulong)first << 32) | second : ((ulong)second << 32) | first;
                }
                bool IsSupportedCpuType(uint cpuType)
                {
                    return cpuType == 7
                        || cpuType == 12
                        || cpuType == 18
                        || cpuType == 0x01000007
                        || cpuType == 0x0100000c
                        || cpuType == 0x01000012;
                }

                bool thinMachO = (header[0] == 0xfe && header[1] == 0xed && header[2] == 0xfa && (header[3] == 0xce || header[3] == 0xcf))
                    || ((header[0] == 0xce || header[0] == 0xcf) && header[1] == 0xfa && header[2] == 0xed && header[3] == 0xfe);
                if (thinMachO)
                {
                    bool bigEndianThin = header[0] == 0xfe;
                    bool thin64 = header[3] == 0xcf || header[0] == 0xcf;
                    int headerSize = thin64 ? 32 : 28;
                    int bytesRead = 4;
                    while (bytesRead < headerSize)
                    {
                        int count = stream.Read(header, bytesRead, headerSize - bytesRead);
                        if (count == 0)
                        {
                            return false;
                        }
                        bytesRead += count;
                    }
                    uint cpuType = ReadUInt32(header, 4, bigEndianThin);
                    uint fileType = ReadUInt32(header, 12, bigEndianThin);
                    uint loadCommandCount = ReadUInt32(header, 16, bigEndianThin);
                    uint loadCommandSize = ReadUInt32(header, 20, bigEndianThin);
                    return IsSupportedCpuType(cpuType)
                        && fileType >= 1
                        && fileType <= 12
                        && loadCommandCount <= 65535
                        && loadCommandSize >= (ulong)loadCommandCount * 8
                        && (ulong)headerSize + loadCommandSize <= (ulong)stream.Length;
                }

                bool bigEndianFat = header[0] == 0xca && header[1] == 0xfe && header[2] == 0xba
                    && (header[3] == 0xbe || header[3] == 0xbf);
                bool littleEndianFat = (header[0] == 0xbe || header[0] == 0xbf)
                    && header[1] == 0xba && header[2] == 0xfe && header[3] == 0xca;
                if (!bigEndianFat && !littleEndianFat)
                {
                    return false;
                }
                if (stream.Read(header, 4, 4) != 4)
                {
                    return false;
                }

                bool fat64 = header[3] == 0xbf || header[0] == 0xbf;
                uint architectureCount = ReadUInt32(header, 4, bigEndianFat);
                int architectureSize = fat64 ? 32 : 20;
                if (architectureCount == 0 || architectureCount > 1024)
                {
                    return false;
                }
                long tableLength = 8L + ((long)architectureCount * architectureSize);
                if (tableLength > stream.Length)
                {
                    return false;
                }

                var architecture = new byte[architectureSize];
                bool hasSupportedArchitecture = false;
                for (uint index = 0; index < architectureCount; index++)
                {
                    if (stream.Read(architecture, 0, architecture.Length) != architecture.Length)
                    {
                        return false;
                    }
                    uint cpuType = ReadUInt32(architecture, 0, bigEndianFat);
                    hasSupportedArchitecture |= IsSupportedCpuType(cpuType);
                    ulong offset = fat64
                        ? ReadUInt64(architecture, 8, bigEndianFat)
                        : ReadUInt32(architecture, 8, bigEndianFat);
                    ulong size = fat64
                        ? ReadUInt64(architecture, 16, bigEndianFat)
                        : ReadUInt32(architecture, 12, bigEndianFat);
                    if (size == 0
                        || offset < (ulong)tableLength
                        || offset > (ulong)stream.Length
                        || size > (ulong)stream.Length - offset)
                    {
                        return false;
                    }
                }
                return hasSupportedArchitecture;
            }
            catch (IOException exception)
            {
                if (string.Equals(
                        Path.GetFileName(path),
                        "Brotli-LICENSE.txt",
                        StringComparison.Ordinal)
                    && string.Equals(
                        Path.GetFileName(Path.GetDirectoryName(path)),
                        "ThirdPartyNotices",
                        StringComparison.OrdinalIgnoreCase))
                {
                    return false;
                }
                throw new InvalidOperationException($"Could not inspect application-bundle file '{path}'.", exception);
            }
            catch (UnauthorizedAccessException exception)
            {
                throw new InvalidOperationException($"Could not inspect application-bundle file '{path}'.", exception);
            }
        }

        IEnumerable<string> FindMachOBinaries(string bundlePath)
        {
            var directories = new Stack<string>();
            directories.Push(bundlePath);
            while (directories.Count > 0)
            {
                string directory = directories.Pop();
                foreach (string candidate in Directory.EnumerateFiles(directory))
                {
                    if (IsMachOFile(candidate))
                    {
                        yield return candidate;
                    }
                }
                foreach (string child in Directory.EnumerateDirectories(directory))
                {
                    var childInfo = new DirectoryInfo(child);
                    string linkTarget = typeof(FileSystemInfo).GetProperty("LinkTarget")?.GetValue(childInfo) as string;
                    if (string.IsNullOrWhiteSpace(linkTarget))
                    {
                        directories.Push(child);
                    }
                }
            }
        }

        bool IsMachOBundle(string binaryPath)
        {
            string cacheKey = ResolvePhysicalPath(binaryPath);
            if (machOBundleInspectionCache.TryGetValue(cacheKey, out bool cachedResult))
            {
                return cachedResult;
            }
            bool result = ReadMachOFileTypesByArchitecture(binaryPath).Values
                .Any(fileTypes => fileTypes.Contains("BUNDLE") || fileTypes.Contains("MH_BUNDLE"));
            machOBundleInspectionCache[cacheKey] = result;
            return result;
        }

        Dictionary<string, HashSet<string>> ReadMachOFileTypesByArchitecture(string binaryPath)
        {
            string cacheKey = ResolvePhysicalPath(binaryPath);
            if (!machOFileTypeInspectionCache.TryGetValue(
                    cacheKey,
                    out Dictionary<string, HashSet<string>> fileTypesByArchitecture))
            {
                string output = RequireTool(
                        "Native file-type inspection",
                        OtoolCli,
                        "-arch",
                        "all",
                        "-hv",
                        binaryPath);
                fileTypesByArchitecture = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);
                string architecture = "default";
                foreach (string rawLine in output.Split(
                    new[] { '\r', '\n' },
                    StringSplitOptions.RemoveEmptyEntries))
                {
                    string line = rawLine.Trim();
                    const string architectureMarker = " (architecture ";
                    int architectureIndex = line.LastIndexOf(architectureMarker, StringComparison.Ordinal);
                    int architectureEnd = line.LastIndexOf("):", StringComparison.Ordinal);
                    if (architectureIndex >= 0
                        && architectureEnd > architectureIndex + architectureMarker.Length)
                    {
                        architecture = line.Substring(
                            architectureIndex + architectureMarker.Length,
                            architectureEnd - architectureIndex - architectureMarker.Length);
                        continue;
                    }
                    foreach (string token in line.Split((char[])null, StringSplitOptions.RemoveEmptyEntries))
                    {
                        if (!string.Equals(token, "BUNDLE", StringComparison.Ordinal)
                            && !string.Equals(token, "MH_BUNDLE", StringComparison.Ordinal)
                            && !string.Equals(token, "EXECUTE", StringComparison.Ordinal)
                            && !string.Equals(token, "MH_EXECUTE", StringComparison.Ordinal))
                        {
                            continue;
                        }
                        if (!fileTypesByArchitecture.TryGetValue(
                                architecture,
                                out HashSet<string> architectureFileTypes))
                        {
                            architectureFileTypes = new HashSet<string>(StringComparer.Ordinal);
                            fileTypesByArchitecture[architecture] = architectureFileTypes;
                        }
                        architectureFileTypes.Add(token);
                    }
                }
                machOFileTypeInspectionCache[cacheKey] = fileTypesByArchitecture;
            }
            return fileTypesByArchitecture;
        }

        bool HasMachOFileType(string binaryPath, string architecture, params string[] expectedTypes)
        {
            var fileTypesByArchitecture = ReadMachOFileTypesByArchitecture(binaryPath);
            HashSet<string> fileTypes;
            if (!fileTypesByArchitecture.TryGetValue(architecture, out fileTypes)
                && !fileTypesByArchitecture.TryGetValue("default", out fileTypes))
            {
                return false;
            }
            return expectedTypes.Any(fileTypes.Contains);
        }

        bool IsMachOExecutableForArchitecture(string binaryPath, string architecture)
        {
            return HasMachOFileType(binaryPath, architecture, "EXECUTE", "MH_EXECUTE");
        }

        bool IsMachOBundleForArchitecture(string binaryPath, string architecture)
        {
            return HasMachOFileType(binaryPath, architecture, "BUNDLE", "MH_BUNDLE");
        }

        IEnumerable<Tuple<string, string, IReadOnlyList<string>, IReadOnlyList<Tuple<string, string, string>>>> FindReachableHostBinaries(
            string bundlePath,
            string compressionPath,
            bool includeLaunchScopeFallback = true)
        {
            string launchScopeRoot = NormalizeRoot(bundlePath);
            var binaries = FindMachOBinaries(bundlePath).ToList();
            string physicalCompressionIdentity = ResolvePhysicalPath(compressionPath);
            var binariesByLogicalPath = binaries.ToDictionary(
                Path.GetFullPath,
                binary => binary,
                pathComparer);
            var binariesByPhysicalPath = binaries
                .GroupBy(ResolvePhysicalPath, pathComparer)
                .ToDictionary(
                    group => group.Key,
                    group => group.ToList(),
                    pathComparer);
            var dependenciesByBinary = binaries.ToDictionary(
                binary => binary,
                ReadDependenciesByArchitecture,
                pathComparer);
            var installIdsByBinary = binaries.ToDictionary(
                binary => binary,
                ReadInstallIdsByArchitecture,
                pathComparer);
            var runtimeSearchPathsByBinary = binaries.ToDictionary(
                binary => binary,
                ReadRuntimeSearchPathsByArchitecture,
                pathComparer);
            var reachableContexts = new Dictionary<string, Tuple<string, string, IReadOnlyList<string>, IReadOnlyList<Tuple<string, string, string>>>>(
                StringComparer.Ordinal);
            var reachability = new Dictionary<string, bool>(StringComparer.Ordinal);
            void RecordReachableContext(
                string launchBinary,
                string architecture,
                IReadOnlyList<string> effectiveRuntimeSearchRoots,
                IReadOnlyList<Tuple<string, string, string>> effectiveRuntimeSearchPathOwners)
            {
                string key = launchBinary + "\u001f" + architecture + "\u001f"
                    + string.Join("\u001f", effectiveRuntimeSearchRoots) + "\u001f"
                    + string.Join("\u001f", effectiveRuntimeSearchPathOwners.Select(owner =>
                        owner.Item1 + "\u001e" + owner.Item2 + "\u001e" + owner.Item3));
                reachableContexts[key] = Tuple.Create(
                    launchBinary,
                    architecture,
                    effectiveRuntimeSearchRoots,
                    effectiveRuntimeSearchPathOwners);
            }
            IEnumerable<string> ValuesForArchitecture(
                Dictionary<string, List<string>> values,
                string architecture)
            {
                foreach (string compatibleArchitecture in CompatibleArchitectureNames(architecture))
                {
                    if (values.TryGetValue(
                            compatibleArchitecture,
                            out List<string> architectureValues))
                    {
                        return architectureValues;
                    }
                }
                return values.TryGetValue("default", out List<string> defaultValues)
                    ? defaultValues
                    : new string[0];
            }
            IEnumerable<string> DependenciesForArchitecture(string binary, string architecture)
            {
                var installIds = new HashSet<string>(
                    ValuesForArchitecture(installIdsByBinary[binary], architecture),
                    StringComparer.Ordinal);
                return ValuesForArchitecture(dependenciesByBinary[binary], architecture)
                    .Where(dependency => !installIds.Contains(dependency));
            }
            string ResolveLaunchRelativePath(string value, string loaderBinary, string launchBinary)
            {
                const string loaderPrefix = "@loader_path/";
                const string executablePrefix = "@executable_path/";
                if (string.Equals(value, "@loader_path", StringComparison.Ordinal))
                {
                    return Path.GetDirectoryName(loaderBinary)!;
                }
                if (value.StartsWith(loaderPrefix, StringComparison.Ordinal))
                {
                    return Path.GetFullPath(Path.Combine(
                        Path.GetDirectoryName(loaderBinary)!,
                        value.Substring(loaderPrefix.Length)));
                }
                if (string.Equals(value, "@executable_path", StringComparison.Ordinal))
                {
                    return Path.GetDirectoryName(launchBinary)!;
                }
                if (value.StartsWith(executablePrefix, StringComparison.Ordinal))
                {
                    return Path.GetFullPath(Path.Combine(
                        Path.GetDirectoryName(launchBinary)!,
                        value.Substring(executablePrefix.Length)));
                }
                return Path.IsPathRooted(value) ? Path.GetFullPath(value) : string.Empty;
            }
            IEnumerable<string> OwnRuntimeSearchRoots(
                string binary,
                string launchBinary,
                string architecture)
            {
                return OwnRuntimeSearchPathEntries(binary, launchBinary, architecture)
                    .Select(entry => entry.Item3);
            }
            IEnumerable<Tuple<string, string, string>> OwnRuntimeSearchPathEntries(
                string binary,
                string launchBinary,
                string architecture)
            {
                return ValuesForArchitecture(runtimeSearchPathsByBinary[binary], architecture)
                    .Select(path => Tuple.Create(
                        binary,
                        path,
                        ResolveLaunchRelativePath(path, binary, launchBinary)))
                    .Where(entry => entry.Item3.Length > 0);
            }
            string ResolveDependency(
                string dependency,
                string loaderBinary,
                string launchBinary,
                string architecture,
                IEnumerable<string> effectiveRuntimeSearchRoots)
            {
                string resolved = ResolveLaunchRelativePath(dependency, loaderBinary, launchBinary);
                if (resolved.Length > 0)
                {
                    return resolved;
                }
                const string rpathPrefix = "@rpath/";
                if (!dependency.StartsWith(rpathPrefix, StringComparison.Ordinal))
                {
                    return string.Empty;
                }
                string suffix = dependency.Substring(rpathPrefix.Length);
                foreach (string root in effectiveRuntimeSearchRoots)
                {
                    string candidate = Path.GetFullPath(Path.Combine(root, suffix));
                    if (ExistingBinarySupportsArchitecture(candidate, architecture, loaderBinary))
                    {
                        return candidate;
                    }
                }
                return string.Empty;
            }
            bool ReachesCompression(
                string binary,
                string launchBinary,
                string architecture,
                IReadOnlyList<string> inheritedRuntimeSearchRoots,
                IReadOnlyList<Tuple<string, string, string>> inheritedRuntimeSearchPathOwners,
                HashSet<string> visiting)
            {
                string cacheKey = binary + "\u001f" + launchBinary + "\u001f" + architecture + "\u001f"
                    + string.Join("\u001f", inheritedRuntimeSearchRoots) + "\u001f"
                    + string.Join("\u001f", inheritedRuntimeSearchPathOwners.Select(owner =>
                        owner.Item1 + "\u001e" + owner.Item2 + "\u001e" + owner.Item3));
                if (reachability.TryGetValue(cacheKey, out bool knownResult))
                {
                    return knownResult;
                }
                if (!visiting.Add(binary))
                {
                    return false;
                }
                var effectiveRuntimeSearchRoots = DistinctRuntimeSearchRoots(
                    OwnRuntimeSearchRoots(binary, launchBinary, architecture).Concat(
                        inheritedRuntimeSearchRoots));
                var effectiveRuntimeSearchPathOwners = OwnRuntimeSearchPathEntries(
                        binary,
                        launchBinary,
                        architecture)
                    .Concat(inheritedRuntimeSearchPathOwners)
                    .GroupBy(owner => owner.Item1 + "\u001f" + owner.Item2 + "\u001f" + owner.Item3,
                        StringComparer.Ordinal)
                    .Select(group => group.First())
                    .ToList();
                void RecordCompressionContext(string loadedCompressionBinary)
                {
                    var ownCompressionRuntimeSearchRoots = runtimeSearchPathsByBinary.ContainsKey(
                            loadedCompressionBinary)
                        ? OwnRuntimeSearchRoots(
                            loadedCompressionBinary,
                            launchBinary,
                            architecture)
                        : Enumerable.Empty<string>();
                    var ownCompressionRuntimeSearchPathOwners = runtimeSearchPathsByBinary.ContainsKey(
                            loadedCompressionBinary)
                        ? OwnRuntimeSearchPathEntries(
                            loadedCompressionBinary,
                            launchBinary,
                            architecture)
                        : Enumerable.Empty<Tuple<string, string, string>>();
                    var compressionRuntimeSearchRoots = DistinctRuntimeSearchRoots(
                        ownCompressionRuntimeSearchRoots.Concat(effectiveRuntimeSearchRoots));
                    var compressionRuntimeSearchPathOwners = ownCompressionRuntimeSearchPathOwners
                        .Concat(effectiveRuntimeSearchPathOwners)
                        .GroupBy(owner => owner.Item1 + "\u001f" + owner.Item2 + "\u001f" + owner.Item3,
                            StringComparer.Ordinal)
                        .Select(group => group.First())
                        .ToList();
                    RecordReachableContext(
                        launchBinary,
                        architecture,
                        compressionRuntimeSearchRoots,
                        compressionRuntimeSearchPathOwners);
                }
                bool reachesCompression = false;
                foreach (string dependency in DependenciesForArchitecture(binary, architecture))
                {
                    string resolvedDependency = ResolveDependency(
                        dependency,
                        binary,
                        launchBinary,
                        architecture,
                        effectiveRuntimeSearchRoots);
                    if (resolvedDependency.Length == 0)
                    {
                        continue;
                    }
                    string logicalDependencyPath = Path.GetFullPath(resolvedDependency);
                    if (ValuesForArchitecture(
                            ReadWeakDependenciesByArchitecture(binary),
                            architecture).Contains(dependency, StringComparer.Ordinal)
                        && !File.Exists(logicalDependencyPath))
                    {
                        continue;
                    }
                    if (string.Equals(
                        logicalDependencyPath,
                        Path.GetFullPath(compressionPath),
                        pathComparison))
                    {
                        RecordCompressionContext(compressionPath);
                        reachesCompression = true;
                        break;
                    }
                    string physicalDependencyPath = ResolvePhysicalPath(logicalDependencyPath);
                    if (string.Equals(
                        physicalDependencyPath,
                        physicalCompressionIdentity,
                        pathComparison))
                    {
                        string loadedCompressionBinary;
                        RecordCompressionContext(
                            binariesByLogicalPath.TryGetValue(
                                logicalDependencyPath,
                                out loadedCompressionBinary)
                                ? loadedCompressionBinary
                                : compressionPath);
                        reachesCompression = true;
                        break;
                    }
                    string candidate = null;
                    if (!binariesByLogicalPath.TryGetValue(logicalDependencyPath, out candidate))
                    {
                        if (binariesByPhysicalPath.TryGetValue(
                                physicalDependencyPath,
                                out List<string> physicalCandidates))
                        {
                            var compatiblePhysicalCandidates = physicalCandidates
                                .GroupBy(physicalCandidate => string.Join(
                                    "\u001d",
                                    string.Join("\u001e", DependenciesForArchitecture(
                                        physicalCandidate,
                                        architecture)),
                                    string.Join("\u001e", ValuesForArchitecture(
                                        runtimeSearchPathsByBinary[physicalCandidate],
                                        architecture))),
                                    StringComparer.Ordinal)
                                .ToList();
                            if (compatiblePhysicalCandidates.Count == 1)
                            {
                                string physicalCandidate = compatiblePhysicalCandidates[0].First();
                                dependenciesByBinary[logicalDependencyPath] =
                                    dependenciesByBinary[physicalCandidate];
                                installIdsByBinary[logicalDependencyPath] =
                                    installIdsByBinary[physicalCandidate];
                                runtimeSearchPathsByBinary[logicalDependencyPath] =
                                    runtimeSearchPathsByBinary[physicalCandidate];
                                binariesByLogicalPath[logicalDependencyPath] = logicalDependencyPath;
                                candidate = logicalDependencyPath;
                            }
                        }
                    }
                    if (candidate != null
                        && ReachesCompression(
                            candidate,
                            launchBinary,
                            architecture,
                            effectiveRuntimeSearchRoots,
                            effectiveRuntimeSearchPathOwners,
                            visiting))
                    {
                        reachesCompression = true;
                        break;
                    }
                }
                visiting.Remove(binary);
                reachability[cacheKey] = reachesCompression;
                return reachesCompression;
            }
            var launchers = binaries
                .Where(binary => ReadMachOFileTypesByArchitecture(binary).Values.Any(fileTypes =>
                    fileTypes.Contains("EXECUTE") || fileTypes.Contains("MH_EXECUTE")))
                .ToList();
            bool IsIndependentLaunchBundle(string directory)
            {
                string extension = Path.GetExtension(directory);
                return string.Equals(extension, ".app", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(extension, ".appex", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(extension, ".xpc", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(extension, ".service", StringComparison.OrdinalIgnoreCase);
            }
            string LaunchScopeForBinary(string binary)
            {
                string directory = Path.GetDirectoryName(Path.GetFullPath(binary))!;
                while (IsWithinRoot(directory, launchScopeRoot))
                {
                    if (string.Equals(directory, launchScopeRoot, pathComparison))
                    {
                        return launchScopeRoot;
                    }
                    if (IsIndependentLaunchBundle(directory))
                    {
                        return directory;
                    }
                    string parent = Path.GetDirectoryName(directory);
                    if (string.IsNullOrWhiteSpace(parent) || parent == directory)
                    {
                        break;
                    }
                    directory = parent;
                }
                return launchScopeRoot;
            }
            foreach (string launcher in launchers)
            {
                var architectures = dependenciesByBinary[launcher].Keys
                    .Concat(runtimeSearchPathsByBinary[launcher].Keys)
                    .Concat(ReadMachOFileTypesByArchitecture(launcher).Keys)
                    .Distinct(StringComparer.Ordinal)
                    .DefaultIfEmpty("default")
                    .Where(architecture => IsMachOExecutableForArchitecture(launcher, architecture));
                foreach (string architecture in architectures)
                {
                    ReachesCompression(
                        launcher,
                        launcher,
                        architecture,
                        new string[0],
                        new Tuple<string, string, string>[0],
                        new HashSet<string>(pathComparer));
                }
            }
            foreach (string plugin in binaries.Where(IsMachOBundle))
            {
                string pluginLaunchScope = LaunchScopeForBinary(plugin);
                foreach (string launcher in launchers.Where(candidate => string.Equals(
                    LaunchScopeForBinary(candidate),
                    pluginLaunchScope,
                    pathComparison)))
                {
                    var pluginArchitectures = dependenciesByBinary[plugin].Keys
                        .Concat(runtimeSearchPathsByBinary[plugin].Keys)
                        .Concat(ReadMachOFileTypesByArchitecture(plugin).Keys)
                        .Distinct(StringComparer.Ordinal)
                        .DefaultIfEmpty("default")
                        .Where(architecture => IsMachOBundleForArchitecture(plugin, architecture));
                    var launcherArchitectures = dependenciesByBinary[launcher].Keys
                        .Concat(runtimeSearchPathsByBinary[launcher].Keys)
                        .Concat(ReadMachOFileTypesByArchitecture(launcher).Keys)
                        .Distinct(StringComparer.Ordinal)
                        .DefaultIfEmpty("default")
                        .Where(architecture => IsMachOExecutableForArchitecture(launcher, architecture));
                    foreach (string pluginArchitecture in pluginArchitectures)
                    {
                        foreach (string launcherArchitecture in launcherArchitectures.Where(
                            architecture => architecture == "default"
                                || pluginArchitecture == "default"
                                || ArchitecturesAreCompatible(
                                    architecture,
                                    new[] { pluginArchitecture })))
                        {
                            var launcherRuntimeSearchRoots = DistinctRuntimeSearchRoots(
                                OwnRuntimeSearchRoots(launcher, launcher, launcherArchitecture));
                            var launcherRuntimeSearchPathOwners = OwnRuntimeSearchPathEntries(
                                    launcher,
                                    launcher,
                                    launcherArchitecture)
                                .ToList();
                            ReachesCompression(
                                plugin,
                                launcher,
                                pluginArchitecture,
                                launcherRuntimeSearchRoots,
                                launcherRuntimeSearchPathOwners,
                                new HashSet<string>(pathComparer));
                        }
                    }
                }
            }
            if (includeLaunchScopeFallback)
            {
                string compressionLaunchScope = LaunchScopeForBinary(compressionPath);
                foreach (string launcher in launchers.Where(candidate => string.Equals(
                    LaunchScopeForBinary(candidate),
                    compressionLaunchScope,
                    pathComparison)))
                {
                    var architectures = dependenciesByBinary[launcher].Keys
                        .Concat(runtimeSearchPathsByBinary[launcher].Keys)
                        .Concat(ReadMachOFileTypesByArchitecture(launcher).Keys)
                        .Distinct(StringComparer.Ordinal)
                        .DefaultIfEmpty("default")
                        .Where(architecture => IsMachOExecutableForArchitecture(launcher, architecture));
                    foreach (string architecture in architectures)
                    {
                        RecordReachableContext(
                            launcher,
                            architecture,
                            DistinctRuntimeSearchRoots(
                                (runtimeSearchPathsByBinary.ContainsKey(compressionPath)
                                    ? OwnRuntimeSearchRoots(
                                        compressionPath,
                                        launcher,
                                        architecture)
                                    : Enumerable.Empty<string>())
                                .Concat(OwnRuntimeSearchRoots(
                                    launcher,
                                    launcher,
                                    architecture))),
                            (runtimeSearchPathsByBinary.ContainsKey(compressionPath)
                                    ? OwnRuntimeSearchPathEntries(
                                        compressionPath,
                                        launcher,
                                        architecture)
                                    : Enumerable.Empty<Tuple<string, string, string>>())
                                .Concat(OwnRuntimeSearchPathEntries(
                                    launcher,
                                    launcher,
                                    architecture))
                                .ToList());
                    }
                }
            }
            return reachableContexts.Values;
        }

        bool IsCodeSigningBundle(string directory, string outerBundlePath)
        {
            if (string.Equals(directory, outerBundlePath, pathComparison))
            {
                return true;
            }
            if (File.Exists(Path.Combine(directory, "Contents", "Info.plist")))
            {
                return true;
            }
            string extension = Path.GetExtension(directory);
            bool recognizedCodeEnvelope = string.Equals(extension, ".app", StringComparison.OrdinalIgnoreCase)
                || string.Equals(extension, ".appex", StringComparison.OrdinalIgnoreCase)
                || string.Equals(extension, ".bundle", StringComparison.OrdinalIgnoreCase)
                || string.Equals(extension, ".framework", StringComparison.OrdinalIgnoreCase)
                || string.Equals(extension, ".plugin", StringComparison.OrdinalIgnoreCase)
                || string.Equals(extension, ".service", StringComparison.OrdinalIgnoreCase)
                || string.Equals(extension, ".xpc", StringComparison.OrdinalIgnoreCase);
            if (!recognizedCodeEnvelope)
            {
                return false;
            }
            return File.Exists(Path.Combine(directory, "Info.plist"))
                || File.Exists(Path.Combine(directory, "Resources", "Info.plist"))
                || File.Exists(Path.Combine(directory, "Versions", "Current", "Resources", "Info.plist"));
        }

        string FindSigningBundle(string binaryPath, string outerBundlePath)
        {
            string directory = Path.GetDirectoryName(binaryPath)!;
            while (IsWithinRoot(directory, outerBundlePath))
            {
                if (IsCodeSigningBundle(directory, outerBundlePath))
                {
                    return directory;
                }
                string parent = Path.GetDirectoryName(directory);
                if (string.IsNullOrWhiteSpace(parent) || parent == directory)
                {
                    break;
                }
                directory = parent;
            }
            return outerBundlePath;
        }

        var compressionBackupPaths = new Dictionary<string, string>(StringComparer.Ordinal);
        var outputBackupPaths = new Dictionary<string, string>(StringComparer.Ordinal);
        var outputLinkTargets = new Dictionary<string, string>(StringComparer.Ordinal);
        var newlyCreatedOutputPaths = new HashSet<string>(StringComparer.Ordinal);
        var newlyCreatedOutputDirectories = new HashSet<string>(StringComparer.Ordinal);
        var signingDirectorySnapshots = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);
        void TrackOutputMutation(string path)
        {
            string fullPath = Path.GetFullPath(path);
            if (outputBackupPaths.ContainsKey(fullPath)
                || outputLinkTargets.ContainsKey(fullPath)
                || newlyCreatedOutputPaths.Contains(fullPath))
            {
                return;
            }

            string linkTarget = ReadSymbolicLinkTarget(fullPath);
            if (!string.IsNullOrWhiteSpace(linkTarget))
            {
                outputLinkTargets[fullPath] = linkTarget;
                return;
            }
            if (!File.Exists(fullPath))
            {
                newlyCreatedOutputPaths.Add(fullPath);
                return;
            }

            string backupPath = Path.Combine(
                Path.GetTempPath(),
                "roi-build-actions-output-backup-" + Guid.NewGuid().ToString("N"));
            CopyDereferenced(fullPath, backupPath);
            outputBackupPaths[fullPath] = backupPath;
        }

        void CreateTrackedDirectory(string path)
        {
            string fullPath = Path.GetFullPath(path);
            string missingPath = fullPath;
            while (!Directory.Exists(missingPath))
            {
                newlyCreatedOutputDirectories.Add(missingPath);
                string parentPath = Path.GetDirectoryName(missingPath);
                if (string.IsNullOrWhiteSpace(parentPath) || parentPath == missingPath)
                {
                    break;
                }
                missingPath = parentPath;
            }
            Directory.CreateDirectory(fullPath);
        }

        void TrackSigningDirectory(string path)
        {
            string fullPath = Path.GetFullPath(path);
            if (signingDirectorySnapshots.ContainsKey(fullPath))
            {
                return;
            }
            var originalEntries = Directory.Exists(fullPath)
                ? new HashSet<string>(
                    Directory.EnumerateFileSystemEntries(fullPath, "*", SearchOption.AllDirectories)
                        .Select(Path.GetFullPath),
                    StringComparer.Ordinal)
                : new HashSet<string>(StringComparer.Ordinal);
            signingDirectorySnapshots[fullPath] = originalEntries;
            if (!Directory.Exists(fullPath))
            {
                newlyCreatedOutputDirectories.Add(fullPath);
                return;
            }
            foreach (string file in Directory.EnumerateFiles(fullPath, "*", SearchOption.AllDirectories))
            {
                TrackOutputMutation(file);
            }
        }

        void TrackBundleSigningMutations(string bundlePath)
        {
            string contentsPath = Path.Combine(bundlePath, "Contents");
            string flatInfoPlistPath = Path.Combine(bundlePath, "Info.plist");
            string resourcesInfoPlistPath = Path.Combine(bundlePath, "Resources", "Info.plist");
            if (File.Exists(flatInfoPlistPath) || File.Exists(resourcesInfoPlistPath))
            {
                foreach (string flatBundleFile in Directory.EnumerateFiles(
                    bundlePath,
                    "*",
                    SearchOption.TopDirectoryOnly))
                {
                    TrackOutputMutation(flatBundleFile);
                }
            }
            foreach (string executableDirectory in new[]
            {
                Path.Combine(contentsPath, "MacOS"),
                Path.Combine(bundlePath, "MacOS")
            }.Where(Directory.Exists))
            {
                foreach (string executable in Directory.EnumerateFiles(
                    executableDirectory,
                    "*",
                    SearchOption.AllDirectories))
                {
                    TrackOutputMutation(executable);
                }
            }
            if (Directory.Exists(contentsPath))
            {
                TrackSigningDirectory(Path.Combine(contentsPath, "_CodeSignature"));
                TrackOutputMutation(Path.Combine(contentsPath, "CodeResources"));
            }
            TrackSigningDirectory(Path.Combine(bundlePath, "_CodeSignature"));
            TrackOutputMutation(Path.Combine(bundlePath, "CodeResources"));
            string versionsPath = Path.Combine(bundlePath, "Versions");
            if (Directory.Exists(versionsPath))
            {
                foreach (string versionPath in Directory.EnumerateDirectories(versionsPath))
                {
                    var versionEntry = new DirectoryInfo(versionPath);
                    string versionLinkTarget = typeof(FileSystemInfo).GetProperty("LinkTarget")
                        ?.GetValue(versionEntry) as string;
                    if (!string.IsNullOrWhiteSpace(versionLinkTarget))
                    {
                        continue;
                    }
                    TrackSigningDirectory(Path.Combine(versionPath, "_CodeSignature"));
                    TrackOutputMutation(Path.Combine(versionPath, "CodeResources"));
                    foreach (string versionExecutable in Directory.EnumerateFiles(
                        versionPath,
                        "*",
                        SearchOption.TopDirectoryOnly))
                    {
                        TrackOutputMutation(versionExecutable);
                    }
                }
            }
        }

        void RestoreTrackedOutputs()
        {
            foreach (var snapshot in signingDirectorySnapshots)
            {
                if (!Directory.Exists(snapshot.Key))
                {
                    continue;
                }
                foreach (string entry in Directory.EnumerateFileSystemEntries(
                    snapshot.Key,
                    "*",
                    SearchOption.AllDirectories)
                    .Select(Path.GetFullPath)
                    .Where(entry => !snapshot.Value.Contains(entry))
                    .OrderByDescending(entry => entry.Length))
                {
                    if (Directory.Exists(entry))
                    {
                        if (!Directory.EnumerateFileSystemEntries(entry).Any())
                        {
                            Directory.Delete(entry);
                        }
                    }
                    else
                    {
                        File.Delete(entry);
                    }
                }
            }
            foreach (string path in newlyCreatedOutputPaths)
            {
                File.Delete(path);
            }
            foreach (var backup in outputBackupPaths)
            {
                CopyDereferenced(backup.Value, backup.Key);
            }
            foreach (var link in outputLinkTargets)
            {
                File.Delete(link.Key);
                var createSymbolicLinkMethod = typeof(File).GetMethod(
                    "CreateSymbolicLink",
                    new[] { typeof(string), typeof(string) });
                if (createSymbolicLinkMethod == null)
                {
                    throw new InvalidOperationException(
                        $"Could not restore symbolic-link output '{link.Key}' after a failed Brotli repair.");
                }
                createSymbolicLinkMethod.Invoke(null, new object[] { link.Key, link.Value });
            }
            foreach (string directory in newlyCreatedOutputDirectories.OrderByDescending(path => path.Length))
            {
                if (Directory.Exists(directory) && !Directory.EnumerateFileSystemEntries(directory).Any())
                {
                    Directory.Delete(directory);
                }
            }
        }
        bool repairSucceeded = false;
        try
        {
            string appPath = NormalizeRoot(ApplicationBundlePath);
            if (!Path.IsPathRooted(HomebrewPrefix))
            {
                Log.LogError(
                    $"The Homebrew prefix must be an absolute path: {HomebrewPrefix}");
                return false;
            }
            string homebrewRoot = NormalizeRoot(HomebrewPrefix);
            string physicalHomebrewRoot = ResolvePhysicalPath(homebrewRoot);
            string physicalAppPath = ResolvePhysicalPath(appPath);
            string LogicalBundlePathForPhysicalBundle(string physicalBundlePath)
            {
                if (string.Equals(physicalBundlePath, physicalAppPath, pathComparison))
                {
                    return appPath;
                }
                string relativeSuffix = physicalBundlePath
                    .Substring(physicalAppPath.Length)
                    .TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                return Path.GetFullPath(Path.Combine(appPath, relativeSuffix));
            }
            bool caseInsensitiveAppPaths = IsCaseInsensitiveFileSystem(physicalAppPath);
            bool caseInsensitiveHomebrewPaths = IsCaseInsensitiveFileSystem(physicalHomebrewRoot);
            pathComparison = caseInsensitiveAppPaths
                ? StringComparison.OrdinalIgnoreCase
                : StringComparison.Ordinal;
            pathComparer = caseInsensitiveAppPaths
                ? StringComparer.OrdinalIgnoreCase
                : StringComparer.Ordinal;
            homebrewPathComparison = caseInsensitiveHomebrewPaths
                ? StringComparison.OrdinalIgnoreCase
                : StringComparison.Ordinal;
            homebrewPathComparer = caseInsensitiveHomebrewPaths
                ? StringComparer.OrdinalIgnoreCase
                : StringComparer.Ordinal;
            StringComparison ComparisonForRoot(string root)
            {
                return ComparisonForPathStorage(root);
            }
            var explicitlyAllowedPrefixValues = (AdditionalAllowedPrefixes ?? new Microsoft.Build.Framework.ITaskItem[0])
                .Select(item => item.ItemSpec.Trim())
                .Where(prefix => prefix.Length > 0)
                .ToList();
            string relativeAllowedPrefix = explicitlyAllowedPrefixValues.FirstOrDefault(prefix => !Path.IsPathRooted(prefix));
            if (!string.IsNullOrWhiteSpace(relativeAllowedPrefix))
            {
                Log.LogError(
                    $"Additional allowed native dependency prefixes must be absolute paths: {relativeAllowedPrefix}");
                return false;
            }
            var explicitlyAllowedRoots = explicitlyAllowedPrefixValues
                .Select(NormalizeRoot)
                .Select(root => Tuple.Create(root, ComparisonForRoot(root)))
                .ToList();
            bool IsExplicitlyAllowedPath(string path)
            {
                return explicitlyAllowedRoots.Any(root =>
                    IsWithinRootWithComparison(path, root.Item1, root.Item2));
            }
            bool IsWithinHomebrewRoot(string path, string root)
            {
                return IsWithinRootWithComparison(path, root, homebrewPathComparison);
            }
            const string reservedBrotliPrefix = "ROI.BuildActions.Homebrew.";
            bool IsReservedBrotliFileName(string fileName)
            {
                return fileName.StartsWith(reservedBrotliPrefix, StringComparison.Ordinal)
                    && fileName.EndsWith(".dylib", StringComparison.Ordinal);
            }
            IEnumerable<string> FindSigningBundlesForReservedOutputReconciliation(string outerBundlePath)
            {
                var directories = new Stack<string>();
                directories.Push(outerBundlePath);
                while (directories.Count > 0)
                {
                    string directory = directories.Pop();
                    if (IsCodeSigningBundle(directory, outerBundlePath))
                    {
                        yield return directory;
                    }
                    foreach (string child in Directory.EnumerateDirectories(directory))
                    {
                        var childInfo = new DirectoryInfo(child);
                        string linkTarget = typeof(FileSystemInfo).GetProperty("LinkTarget")
                            ?.GetValue(childInfo) as string;
                        if (string.IsNullOrWhiteSpace(linkTarget))
                        {
                            directories.Push(child);
                        }
                    }
                }
            }
            bool FileSystemEntryExists(string path)
            {
                return File.Exists(path)
                    || Directory.Exists(path)
                    || !string.IsNullOrWhiteSpace(ReadSymbolicLinkTarget(path));
            }
            bool IsReadableContainedNotice(string path, string signingBundlePath)
            {
                if (!File.Exists(path))
                {
                    return false;
                }
                try
                {
                    string physicalPath = ResolvePhysicalPath(path);
                    string physicalSigningBundlePath = ResolvePhysicalPath(signingBundlePath);
                    if (!IsWithinRoot(physicalPath, physicalSigningBundlePath))
                    {
                        return false;
                    }
                    using var stream = File.OpenRead(physicalPath);
                    return stream.CanRead;
                }
                catch (IOException)
                {
                    return false;
                }
                catch (UnauthorizedAccessException)
                {
                    return false;
                }
            }
            IEnumerable<Tuple<string, string>> FindContentsDirectoriesForReservedOutputReconciliation(
                string outerBundlePath)
            {
                var directories = new Stack<string>();
                var visitedPhysicalDirectories = new HashSet<string>(pathComparer);
                string physicalOuterBundlePath = ResolvePhysicalPath(outerBundlePath);
                directories.Push(outerBundlePath);
                while (directories.Count > 0)
                {
                    string directory = directories.Pop();
                    string physicalDirectory = ResolvePhysicalPath(directory);
                    if (!IsWithinRoot(physicalDirectory, physicalOuterBundlePath))
                    {
                        continue;
                    }
                    if (string.Equals(Path.GetFileName(directory), "Contents", StringComparison.OrdinalIgnoreCase))
                    {
                        string frameworksPath = Path.Combine(directory, "Frameworks");
                        string noticePath = Path.Combine(
                            directory,
                            "Resources",
                            "ThirdPartyNotices",
                            "Brotli-LICENSE.txt");
                        bool hasReservedOutput = Directory.Exists(frameworksPath)
                            && Directory.EnumerateFileSystemEntries(
                                    frameworksPath,
                                    reservedBrotliPrefix + "*",
                                    SearchOption.TopDirectoryOnly)
                                .Any(path => IsReservedBrotliFileName(Path.GetFileName(path)));
                        if (hasReservedOutput || FileSystemEntryExists(noticePath))
                        {
                            string signingBundlePath = FindSigningBundle(
                                Path.Combine(directory, "__roi_build_actions_reconciliation_probe__"),
                                outerBundlePath);
                            yield return Tuple.Create(directory, signingBundlePath);
                        }
                    }
                    if (!visitedPhysicalDirectories.Add(physicalDirectory))
                    {
                        continue;
                    }
                    foreach (string child in Directory.EnumerateDirectories(directory))
                    {
                        string physicalChild = ResolvePhysicalPath(child);
                        if (IsWithinRoot(physicalChild, physicalOuterBundlePath))
                        {
                            directories.Push(child);
                        }
                    }
                }
            }
            var compressionPaths = FindCompressionLibraries(appPath).ToList();
            if (compressionPaths.Count == 0)
            {
                Log.LogMessage(MessageImportance.Normal,
                    "Homebrew Brotli vendoring not needed: compression library was not present.");
            }

            var repairedSigningBundles = new HashSet<string>(pathComparer);
            var candidateSigningBundles = compressionPaths
                .Select(compressionPath => FindSigningBundle(compressionPath, appPath))
                .Concat(FindSigningBundlesForReservedOutputReconciliation(appPath))
                .Distinct(pathComparer)
                .ToList();
            var candidateContentsDirectories = candidateSigningBundles
                .Select(signingBundle => Tuple.Create(
                    Path.Combine(signingBundle, "Contents"),
                    signingBundle))
                .Concat(compressionPaths.Select(compressionPath =>
                {
                    string signingBundle = FindSigningBundle(compressionPath, appPath);
                    return Tuple.Create(
                        FindCompressionContentsDirectory(compressionPath, signingBundle),
                        signingBundle);
                }))
                .Concat(FindContentsDirectoriesForReservedOutputReconciliation(appPath))
                .GroupBy(item => item.Item1, pathComparer)
                .Select(group => group.First())
                .ToList();
            var plannedReservedFileNamesByContentsDirectory = candidateContentsDirectories.ToDictionary(
                item => item.Item1,
                item => new HashSet<string>(StringComparer.Ordinal),
                pathComparer);
            var attributedLicenseBySigningBundle = new Dictionary<string, Tuple<string, byte[]>>(
                pathComparer);
            var requiredArchitecturesByReservedOutput = new Dictionary<string, HashSet<string>>(
                pathComparer);
            var commonChangesByReservedOutput = new Dictionary<string, List<Tuple<string, string, string>>>(
                pathComparer);
            var completedRepairByPhysicalCompressionPath = new Dictionary<string, Tuple<string, HashSet<string>>>(
                pathComparer);

            string[] RequiredArchitecturesForReservedOutput(
                string destination,
                IEnumerable<string> requiredArchitectures)
            {
                if (!requiredArchitecturesByReservedOutput.TryGetValue(
                        destination,
                        out HashSet<string> accumulatedArchitectures))
                {
                    accumulatedArchitectures = new HashSet<string>(StringComparer.Ordinal);
                    requiredArchitecturesByReservedOutput[destination] = accumulatedArchitectures;
                }
                accumulatedArchitectures.UnionWith(requiredArchitectures);
                return accumulatedArchitectures.ToArray();
            }

            List<Tuple<string, string, string>> CommonChangesForReservedOutput(
                string destination,
                IEnumerable<Tuple<string, string, string>> commonChanges)
            {
                if (!commonChangesByReservedOutput.TryGetValue(
                        destination,
                        out List<Tuple<string, string, string>> accumulatedChanges))
                {
                    accumulatedChanges = new List<Tuple<string, string, string>>();
                    commonChangesByReservedOutput[destination] = accumulatedChanges;
                }
                foreach (var change in commonChanges)
                {
                    if (!accumulatedChanges.Any(existing =>
                        string.Equals(existing.Item1, change.Item1, StringComparison.Ordinal)
                        && string.Equals(existing.Item2, change.Item2, StringComparison.Ordinal)
                        && string.Equals(existing.Item3, change.Item3, StringComparison.Ordinal)))
                    {
                        accumulatedChanges.Add(change);
                    }
                }
                return accumulatedChanges;
            }

            foreach (string compressionPath in compressionPaths)
            {
                ClearNativeInspectionCaches();
                string signingBundlePath = FindSigningBundle(compressionPath, appPath);
                string physicalCompressionPath = ResolvePhysicalPath(compressionPath);
                string physicalCompressionSigningBundlePath = FindSigningBundle(
                    physicalCompressionPath,
                    physicalAppPath);
                if (!string.Equals(
                    signingBundlePath,
                    LogicalBundlePathForPhysicalBundle(physicalCompressionSigningBundlePath),
                    pathComparison))
                {
                    Log.LogError(
                        $"Cannot vendor Homebrew Brotli because compression library '{compressionPath}' resolves into a different signing bundle '{physicalCompressionSigningBundlePath}'.");
                    return false;
                }
                string signingBundleLaunchDirectory = Path.Combine(signingBundlePath, "Contents", "MacOS");
                string linkPath = compressionPath;
                while (true)
                {
                    var linkEntry = new FileInfo(linkPath);
                    string linkTarget = typeof(FileSystemInfo).GetProperty("LinkTarget")
                        ?.GetValue(linkEntry) as string;
                    if (string.IsNullOrWhiteSpace(linkTarget))
                    {
                        break;
                    }
                    linkPath = Path.GetFullPath(Path.IsPathRooted(linkTarget)
                        ? linkTarget
                        : Path.Combine(Path.GetDirectoryName(linkPath)!, linkTarget));
                    string linkSigningBundlePath = FindSigningBundle(linkPath, appPath);
                    if (!string.Equals(signingBundlePath, linkSigningBundlePath, pathComparison))
                    {
                        Log.LogError(
                            $"Cannot vendor Homebrew Brotli because compression library '{compressionPath}' resolves into a different signing bundle '{linkSigningBundlePath}'.");
                        return false;
                    }
                }
                if (!IsWithinRoot(physicalCompressionPath, ResolvePhysicalPath(signingBundlePath)))
                {
                    Log.LogError(
                        $"Cannot vendor Homebrew Brotli because compression library '{compressionPath}' resolves outside its signing bundle to '{physicalCompressionPath}'.");
                    return false;
                }

                string compressionContentsPath = FindCompressionContentsDirectory(
                    compressionPath,
                    signingBundlePath);
                if (completedRepairByPhysicalCompressionPath.TryGetValue(
                        physicalCompressionPath,
                        out Tuple<string, HashSet<string>> completedRepair))
                {
                    string completedContentsPath = completedRepair.Item1;
                    if (!string.Equals(compressionContentsPath, completedContentsPath, pathComparison))
                    {
                        string sourceFrameworksPath = Path.Combine(completedContentsPath, "Frameworks");
                        string destinationFrameworksPath = Path.Combine(compressionContentsPath, "Frameworks");
                        string destinationNoticesPath = Path.Combine(
                            compressionContentsPath,
                            "Resources",
                            "ThirdPartyNotices");
                        if (!IsSafeBundleDestinationDirectory(destinationFrameworksPath, signingBundlePath)
                            || !IsSafeBundleDestinationDirectory(destinationNoticesPath, signingBundlePath))
                        {
                            Log.LogError(
                                "Cannot vendor Homebrew Brotli because a destination directory resolves outside the application bundle.");
                            return false;
                        }
                        CreateTrackedDirectory(destinationFrameworksPath);
                        CreateTrackedDirectory(destinationNoticesPath);
                        foreach (string reservedFileName in completedRepair.Item2)
                        {
                            string sourceOutput = Path.Combine(sourceFrameworksPath, reservedFileName);
                            if (!File.Exists(sourceOutput))
                            {
                                Log.LogError(
                                    $"Cannot populate shared compression destination because required Brotli output '{sourceOutput}' is missing.");
                                return false;
                            }
                            string destinationOutput = Path.Combine(
                                destinationFrameworksPath,
                                reservedFileName);
                            TrackOutputMutation(destinationOutput);
                            CopyDereferenced(sourceOutput, destinationOutput);
                            plannedReservedFileNamesByContentsDirectory[compressionContentsPath].Add(
                                reservedFileName);
                        }
                        string sourceNoticePath = Path.Combine(
                            completedContentsPath,
                            "Resources",
                            "ThirdPartyNotices",
                            "Brotli-LICENSE.txt");
                        if (File.Exists(sourceNoticePath))
                        {
                            string destinationNoticePath = Path.Combine(
                                destinationNoticesPath,
                                "Brotli-LICENSE.txt");
                            TrackOutputMutation(destinationNoticePath);
                            CopyDereferenced(sourceNoticePath, destinationNoticePath);
                        }
                        TrackBundleSigningMutations(signingBundlePath);
                        RequireTool(
                            "Application re-signing for shared compression destination",
                            CodesignCli,
                            "--force",
                            "--sign",
                            ApplicationSigningIdentity,
                            "--timestamp",
                            "--options",
                            "runtime",
                            "--preserve-metadata=entitlements,requirements",
                            signingBundlePath);
                        repairedSigningBundles.Add(signingBundlePath);
                    }
                    continue;
                }

            string ResolveRuntimeSearchPath(string path, string loaderBinaryPath, string executableDirectory)
            {
                const string loaderPrefix = "@loader_path/";
                const string executablePrefix = "@executable_path/";
                if (string.Equals(path, "@loader_path", StringComparison.Ordinal))
                {
                    return Path.GetDirectoryName(loaderBinaryPath)!;
                }
                if (path.StartsWith(loaderPrefix, StringComparison.Ordinal))
                {
                    return Path.GetFullPath(Path.Combine(
                        Path.GetDirectoryName(loaderBinaryPath)!,
                        path.Substring(loaderPrefix.Length)));
                }
                if (string.Equals(path, "@executable_path", StringComparison.Ordinal))
                {
                    return executableDirectory;
                }
                if (path.StartsWith(executablePrefix, StringComparison.Ordinal))
                {
                    return Path.GetFullPath(Path.Combine(
                        executableDirectory,
                        path.Substring(executablePrefix.Length)));
                }
                return Path.IsPathRooted(path) ? Path.GetFullPath(path) : string.Empty;
            }
            var rawRuntimeSearchPathsByArchitecture = ReadRuntimeSearchPathsByArchitecture(compressionPath);
            var reachableLaunchContexts = FindReachableHostBinaries(appPath, compressionPath).ToList();
            var weakDependenciesByArchitecture = ReadWeakDependenciesByArchitecture(compressionPath);
            bool IsWeakDependency(string architecture, string dependency)
            {
                if (weakDependenciesByArchitecture.TryGetValue(architecture, out List<string> architectureDependencies)
                    && architectureDependencies.Contains(dependency, StringComparer.Ordinal))
                {
                    return true;
                }
                return weakDependenciesByArchitecture.TryGetValue("default", out List<string> defaultDependencies)
                    && defaultDependencies.Contains(dependency, StringComparer.Ordinal);
            }
            IEnumerable<string> RawRuntimeSearchPathsForArchitecture(string architecture)
            {
                if (rawRuntimeSearchPathsByArchitecture.TryGetValue(architecture, out List<string> architecturePaths))
                {
                    return architecturePaths;
                }
                return rawRuntimeSearchPathsByArchitecture.TryGetValue("default", out List<string> defaultPaths)
                    ? defaultPaths
                    : new string[0];
            }
            IEnumerable<Tuple<string, IReadOnlyList<string>>> RuntimeSearchPathContextsForArchitecture(string architecture)
            {
                var launchContexts = reachableLaunchContexts
                    .Where(context => context.Item2 == "default"
                        || architecture == "default"
                        || CompatibleArchitectureNames(context.Item2).Contains(
                            architecture,
                            StringComparer.Ordinal))
                    .ToList();
                if (launchContexts.Count == 0)
                {
                    launchContexts.Add(Tuple.Create(
                        Path.Combine(signingBundleLaunchDirectory, "__default__"),
                        "default",
                        (IReadOnlyList<string>)new string[0],
                        (IReadOnlyList<Tuple<string, string, string>>)new Tuple<string, string, string>[0]));
                }
                foreach (var launchContext in launchContexts)
                {
                    string launchBinaryPath = launchContext.Item1;
                    string executableDirectory = Path.GetDirectoryName(launchBinaryPath)!;
                    var roots = new List<string>(launchContext.Item3);
                    roots.AddRange(RawRuntimeSearchPathsForArchitecture(architecture)
                        .Select(path => ResolveRuntimeSearchPath(path, compressionPath, executableDirectory))
                        .Where(path => path.Length > 0));
                    yield return Tuple.Create(
                        launchBinaryPath,
                        DistinctRuntimeSearchRoots(roots));
                }
            }
            var sourceArchitecturesByPhysicalPath = new Dictionary<string, HashSet<string>>(
                homebrewPathComparer);
            string[] defaultReferenceArchitectures = null;
            bool ExistingSourceSupportsArchitecture(string candidate, string architecture)
            {
                if (!File.Exists(candidate))
                {
                    return false;
                }
                IEnumerable<string> requiredSourceArchitectures;
                if (architecture == "default")
                {
                    if (defaultReferenceArchitectures == null)
                    {
                        defaultReferenceArchitectures = RequireTool(
                                "Compression-library architecture inspection",
                                LipoCli,
                                "-archs",
                                compressionPath)
                            .Split((char[])null, StringSplitOptions.RemoveEmptyEntries)
                            .Distinct(StringComparer.Ordinal)
                            .ToArray();
                    }
                    requiredSourceArchitectures = defaultReferenceArchitectures;
                }
                else
                {
                    requiredSourceArchitectures = new[] { architecture };
                }
                string physicalCandidate = ResolvePhysicalPath(candidate);
                if (!sourceArchitecturesByPhysicalPath.TryGetValue(
                        physicalCandidate,
                        out HashSet<string> sourceArchitectures))
                {
                    sourceArchitectures = new HashSet<string>(
                        RequireTool("Brotli source architecture inspection", LipoCli, "-archs", candidate)
                            .Split((char[])null, StringSplitOptions.RemoveEmptyEntries),
                        StringComparer.Ordinal);
                    sourceArchitecturesByPhysicalPath[physicalCandidate] = sourceArchitectures;
                }
                return requiredSourceArchitectures.All(requiredArchitecture =>
                    ArchitecturesAreCompatible(requiredArchitecture, sourceArchitectures));
            }
            IEnumerable<Tuple<string, string, IReadOnlyList<string>>> ResolveBrotliSources(
                string architecture,
                string loadCommand)
            {
                var contexts = RuntimeSearchPathContextsForArchitecture(architecture).ToList();
                if (Path.IsPathRooted(loadCommand))
                {
                    string source = Path.GetFullPath(loadCommand);
                    return contexts.Select(context => Tuple.Create(source, context.Item1, context.Item2));
                }
                if (loadCommand.StartsWith("@loader_path/", StringComparison.Ordinal))
                {
                    string source = Path.GetFullPath(Path.Combine(
                        Path.GetDirectoryName(compressionPath)!,
                        loadCommand.Substring("@loader_path/".Length)));
                    return contexts.Select(context => Tuple.Create(source, context.Item1, context.Item2));
                }
                if (loadCommand.StartsWith("@executable_path/", StringComparison.Ordinal))
                {
                    string suffix = loadCommand.Substring("@executable_path/".Length);
                    return contexts
                        .Select(context =>
                        {
                            string candidate = Path.GetFullPath(Path.Combine(
                                Path.GetDirectoryName(context.Item1)!,
                                suffix));
                            return Tuple.Create(
                                File.Exists(candidate) || IsExplicitlyAllowedPath(candidate)
                                    ? candidate
                                    : string.Empty,
                                context.Item1,
                                context.Item2);
                        });
                }
                if (loadCommand.StartsWith("@rpath/", StringComparison.Ordinal))
                {
                    string suffix = loadCommand.Substring("@rpath/".Length);
                    return contexts
                        .Select(context => Tuple.Create(
                            context.Item2
                                .Select(root => Path.GetFullPath(Path.Combine(root, suffix)))
                                .FirstOrDefault(candidate =>
                                    File.Exists(candidate)
                                        ? ExistingSourceSupportsArchitecture(candidate, architecture)
                                        : IsExplicitlyAllowedPath(candidate))
                                ?? string.Empty,
                            context.Item1,
                            context.Item2));
                }
                return contexts.Select(context => Tuple.Create(string.Empty, context.Item1, context.Item2));
            }
            var allBrotliReferences = ReadDependenciesByArchitecture(compressionPath)
                .SelectMany(pair => pair.Value.Select(dependency => new
                {
                    Architecture = pair.Key,
                    LoadCommand = dependency
                }))
                .Where(reference =>
                {
                    string fileName = FileNameFromLoadCommand(reference.LoadCommand);
                    return string.Equals(fileName, "libbrotlidec.1.dylib", homebrewPathComparison)
                        || string.Equals(fileName, "libbrotlienc.1.dylib", homebrewPathComparison);
                })
                .SelectMany(reference => ResolveBrotliSources(reference.Architecture, reference.LoadCommand)
                    .Select(resolution => new
                    {
                        reference.Architecture,
                        reference.LoadCommand,
                        IsWeak = IsWeakDependency(reference.Architecture, reference.LoadCommand),
                        Source = resolution.Item1,
                        LaunchBinary = resolution.Item2,
                        RuntimeSearchRoots = resolution.Item3
                    }))
                .ToList();
            var vendorableBrotliReferences = allBrotliReferences
                .Where(reference => reference.Source.Length > 0
                    && (!reference.IsWeak || File.Exists(reference.Source))
                    && !IsExplicitlyAllowedPath(reference.Source)
                    && IsWithinHomebrewRoot(reference.Source, homebrewRoot)
                    && IsWithinHomebrewRoot(ResolvePhysicalPath(reference.Source), physicalHomebrewRoot))
                .ToList();
            var canonicalBrotliSourceByPhysicalPath = vendorableBrotliReferences
                .GroupBy(reference => ResolvePhysicalPath(reference.Source), homebrewPathComparer)
                .ToDictionary(group => group.Key, group => group.First().Source, homebrewPathComparer);
            var brotliReferences = vendorableBrotliReferences
                .Select(reference => new
                {
                    reference.Architecture,
                    reference.LoadCommand,
                    reference.IsWeak,
                    Source = canonicalBrotliSourceByPhysicalPath[ResolvePhysicalPath(reference.Source)],
                    reference.LaunchBinary,
                    reference.RuntimeSearchRoots
                })
                .ToList();
            var ambiguousBrotliReferences = allBrotliReferences
                .Where(reference => reference.Source.Length > 0
                    && (!reference.IsWeak || File.Exists(reference.Source)))
                .GroupBy(reference => reference.Architecture + "\u001f" + reference.LoadCommand, StringComparer.Ordinal)
                .FirstOrDefault(group =>
                    group.Any(reference => !IsExplicitlyAllowedPath(reference.Source)
                        && IsWithinHomebrewRoot(reference.Source, homebrewRoot)
                        && IsWithinHomebrewRoot(ResolvePhysicalPath(reference.Source), physicalHomebrewRoot))
                    && group.Select(reference => ResolvePhysicalPath(reference.Source))
                        .Distinct(homebrewPathComparer)
                        .Skip(1)
                        .Any());
            if (ambiguousBrotliReferences != null)
            {
                Log.LogError(
                    $"Cannot vendor Homebrew Brotli because '{ambiguousBrotliReferences.First().LoadCommand}' resolves to multiple physical sources for architecture '{ambiguousBrotliReferences.First().Architecture}'.");
                return false;
            }
            var brotliSources = brotliReferences
                .Select(reference => reference.Source)
                .Distinct(homebrewPathComparer)
                .ToList();
            if (brotliSources.Count == 0)
            {
                Log.LogMessage(MessageImportance.Normal,
                    "Homebrew Brotli vendoring not needed: no matching dependency was detected.");
                continue;
            }

            if (string.IsNullOrWhiteSpace(ApplicationSigningIdentity) || ApplicationSigningIdentity == "-")
            {
                Log.LogError("Detected Homebrew Brotli dependencies, but no application signing identity was configured.");
                return false;
            }

            var brotliFormulaDirectories = brotliSources
                .Select(source => Path.GetDirectoryName(Path.GetDirectoryName(ResolvePhysicalPath(source))!)!)
                .Distinct(homebrewPathComparer)
                .ToList();
            var licenseSources = brotliFormulaDirectories
                .Select(formulaDirectory => Path.Combine(formulaDirectory, "LICENSE"))
                .ToList();
            string licenseSource = licenseSources[0];
            var requiredArchitectures = RequireTool(
                    "Compression-library architecture inspection",
                    LipoCli,
                    "-archs",
                    compressionPath)
                .Split((char[])null, StringSplitOptions.RemoveEmptyEntries)
                .Distinct(StringComparer.Ordinal)
                .ToArray();
            if (requiredArchitectures.Length == 0)
            {
                Log.LogError($"Could not determine the architectures in {compressionPath}.");
                return false;
            }
            var requiredArchitecturesBySource = brotliReferences
                .GroupBy(reference => reference.Source,
                    homebrewPathComparer)
                .ToDictionary(
                    group => group.Key,
                    group => group
                        .SelectMany(reference => reference.Architecture == "default"
                            ? requiredArchitectures
                            : new[] { reference.Architecture })
                        .Distinct(StringComparer.Ordinal)
                        .ToArray(),
                    homebrewPathComparer);
            var sourceArchitecturesBySource = new Dictionary<string, HashSet<string>>(
                homebrewPathComparer);
            HashSet<string> SourceArchitectures(string source)
            {
                if (!sourceArchitecturesBySource.TryGetValue(source, out HashSet<string> architectures))
                {
                    architectures = new HashSet<string>(
                        RequireTool("Brotli architecture inspection", LipoCli, "-archs", source)
                            .Split((char[])null, StringSplitOptions.RemoveEmptyEntries),
                        StringComparer.Ordinal);
                    sourceArchitecturesBySource[source] = architectures;
                }
                return architectures;
            }
            foreach (string source in brotliSources)
            {
                var sourceArchitectures = SourceArchitectures(source);
                requiredArchitecturesBySource[source] = requiredArchitecturesBySource[source]
                    .Select(architecture => CompatibleArchitectureNames(architecture)
                        .FirstOrDefault(sourceArchitectures.Contains) ?? architecture)
                    .Distinct(StringComparer.Ordinal)
                    .ToArray();
            }
            var rawSourceRuntimeSearchPathsByArchitecture = new Dictionary<string, Dictionary<string, List<string>>>(
                homebrewPathComparer);
            IEnumerable<string> RuntimeSearchPathsForSourceArchitecture(
                string source,
                string architecture,
                string launchBinary)
            {
                if (!rawSourceRuntimeSearchPathsByArchitecture.TryGetValue(source, out var rawSourceRuntimeSearchPaths))
                {
                    rawSourceRuntimeSearchPaths = ReadRuntimeSearchPathsByArchitecture(source);
                    rawSourceRuntimeSearchPathsByArchitecture[source] = rawSourceRuntimeSearchPaths;
                }
                IEnumerable<string> paths = rawSourceRuntimeSearchPaths.TryGetValue(
                        architecture,
                        out List<string> architecturePaths)
                    ? architecturePaths
                    : rawSourceRuntimeSearchPaths.TryGetValue("default", out List<string> defaultPaths)
                        ? defaultPaths
                        : new string[0];
                return paths
                    .Select(path => ResolveRuntimeSearchPath(
                        path,
                        source,
                        Path.GetDirectoryName(launchBinary)!))
                    .Where(path => path.Length > 0);
            }
            IEnumerable<string> ExecutableDirectoriesForArchitecture(string architecture)
            {
                var executableDirectories = reachableLaunchContexts
                    .Where(context => context.Item2 == "default"
                        || architecture == "default"
                        || CompatibleArchitectureNames(context.Item2).Contains(
                            architecture,
                            StringComparer.Ordinal))
                    .Select(context => Path.GetDirectoryName(context.Item1)!)
                    .Distinct(pathComparer)
                    .ToList();
                return executableDirectories.Count > 0
                    ? executableDirectories
                    : new[] { signingBundleLaunchDirectory };
            }
            IEnumerable<Tuple<string, string>> ObsoleteHomebrewRuntimeSearchPaths(string source)
            {
                if (!rawSourceRuntimeSearchPathsByArchitecture.TryGetValue(source, out var rawSourceRuntimeSearchPaths))
                {
                    rawSourceRuntimeSearchPaths = ReadRuntimeSearchPathsByArchitecture(source);
                    rawSourceRuntimeSearchPathsByArchitecture[source] = rawSourceRuntimeSearchPaths;
                }
                return rawSourceRuntimeSearchPaths
                    .SelectMany(pair => pair.Value.Select(path => Tuple.Create(pair.Key, path)))
                    .Where(item =>
                    {
                        var resolvedPaths = ExecutableDirectoriesForArchitecture(item.Item1)
                            .Select(directory => ResolveRuntimeSearchPath(item.Item2, source, directory))
                            .Where(resolvedPath => resolvedPath.Length > 0)
                            .ToList();
                        return resolvedPaths.Count > 0
                            && resolvedPaths.All(resolvedPath =>
                                IsWithinHomebrewRoot(resolvedPath, homebrewRoot)
                                && !IsExplicitlyAllowedPath(resolvedPath));
                    });
            }
            IEnumerable<string> ResolveCommonSources(string source, string architecture, string commonReference)
            {
                if (string.IsNullOrWhiteSpace(commonReference))
                {
                    return new[] { Path.Combine(Path.GetDirectoryName(source)!, "libbrotlicommon.1.dylib") };
                }
                if (Path.IsPathRooted(commonReference))
                {
                    return new[] { Path.GetFullPath(commonReference) };
                }
                const string loaderPrefix = "@loader_path/";
                if (commonReference.StartsWith(loaderPrefix, StringComparison.Ordinal))
                {
                    return new[]
                    {
                        Path.GetFullPath(Path.Combine(
                            Path.GetDirectoryName(source)!,
                            commonReference.Substring(loaderPrefix.Length)))
                    };
                }
                const string executablePrefix = "@executable_path/";
                if (commonReference.StartsWith(executablePrefix, StringComparison.Ordinal))
                {
                    string suffix = commonReference.Substring(executablePrefix.Length);
                    return ExecutableDirectoriesForArchitecture(architecture)
                        .Select(directory => Path.GetFullPath(Path.Combine(directory, suffix)))
                        .Where(File.Exists)
                        .DefaultIfEmpty(string.Empty);
                }
                const string runtimeSearchPrefix = "@rpath/";
                if (commonReference.StartsWith(runtimeSearchPrefix, StringComparison.Ordinal))
                {
                    string suffix = commonReference.Substring(runtimeSearchPrefix.Length);
                    var activeContexts = brotliReferences
                        .Where(reference => string.Equals(reference.Source, source, homebrewPathComparison)
                            && (reference.Architecture == "default"
                                || architecture == "default"
                                || CompatibleArchitectureNames(reference.Architecture).Contains(
                                    architecture,
                                    StringComparer.Ordinal)))
                        .ToList();
                    if (activeContexts.Count == 0)
                    {
                        return new[] { string.Empty };
                    }
                    return activeContexts
                        .Select(context => DistinctRuntimeSearchRoots(
                            RuntimeSearchPathsForSourceArchitecture(
                                source,
                                architecture,
                                context.LaunchBinary).Concat(context.RuntimeSearchRoots))
                            .Select(root => Path.GetFullPath(Path.Combine(root, suffix)))
                            .FirstOrDefault(candidate => ExistingSourceSupportsArchitecture(
                                candidate,
                                architecture))
                            ?? string.Empty)
                        .Distinct(homebrewPathComparer);
                }
                return new[]
                {
                    Path.Combine(Path.GetDirectoryName(source)!, FileNameFromLoadCommand(commonReference))
                };
            }
            var commonReferences = brotliSources.SelectMany(source =>
            {
                var references = ReadDependenciesByArchitecture(source)
                    .SelectMany(pair => pair.Value
                        .Where(dependency => string.Equals(
                            FileNameFromLoadCommand(dependency),
                            "libbrotlicommon.1.dylib",
                            homebrewPathComparison))
                        .SelectMany(dependency => (pair.Key == "default"
                                ? requiredArchitecturesBySource[source]
                                : requiredArchitecturesBySource[source].Contains(pair.Key, StringComparer.Ordinal)
                                    ? new[] { pair.Key }
                                    : new string[0])
                            .SelectMany(architecture => ResolveCommonSources(source, architecture, dependency)
                                .Select(commonSource => new
                                {
                                    BrotliSource = source,
                                    Architecture = architecture,
                                    LoadCommand = dependency,
                                    Source = commonSource
                                }))))
                    .ToList();
                return references.Count > 0
                    ? references
                    : requiredArchitecturesBySource[source]
                        .Select(architecture => new
                        {
                            BrotliSource = source,
                            Architecture = architecture,
                            LoadCommand = string.Empty,
                            Source = Path.Combine(Path.GetDirectoryName(source)!, "libbrotlicommon.1.dylib")
                        });
            }).ToList();
            var ambiguousCommonReferences = commonReferences
                .GroupBy(reference => (homebrewPathComparison == StringComparison.OrdinalIgnoreCase
                        ? reference.BrotliSource.ToUpperInvariant()
                        : reference.BrotliSource)
                    + "\u001f" + reference.Architecture + "\u001f" + reference.LoadCommand,
                    StringComparer.Ordinal)
                .FirstOrDefault(group => group
                    .Select(reference => ResolvePhysicalPath(reference.Source))
                    .Distinct(homebrewPathComparer)
                    .Skip(1)
                    .Any());
            if (ambiguousCommonReferences != null)
            {
                var firstReference = ambiguousCommonReferences.First();
                Log.LogError(
                    $"Cannot vendor Homebrew Brotli because '{firstReference.LoadCommand}' resolves to multiple companion libraries for architecture '{firstReference.Architecture}' in '{firstReference.BrotliSource}'.");
                return false;
            }
            foreach (var commonReference in commonReferences)
            {
                string physicalBrotliDirectory = Path.GetDirectoryName(
                    ResolvePhysicalPath(commonReference.BrotliSource))!;
                if (string.IsNullOrWhiteSpace(commonReference.Source)
                    || !IsWithinRootWithComparison(
                        ResolvePhysicalPath(commonReference.Source),
                        physicalBrotliDirectory,
                        homebrewPathComparison))
                {
                    Log.LogError(
                        $"Cannot vendor Homebrew Brotli because companion library '{commonReference.Source}' does not belong to the detected Homebrew source '{commonReference.BrotliSource}'.");
                    return false;
                }
            }
            var canonicalCommonSourceByPhysicalPath = commonReferences
                .GroupBy(reference => ResolvePhysicalPath(reference.Source), homebrewPathComparer)
                .ToDictionary(group => group.Key, group => group.Key, homebrewPathComparer);
            var canonicalCommonReferences = commonReferences
                .Select(reference => new
                {
                    reference.BrotliSource,
                    reference.Architecture,
                    reference.LoadCommand,
                    Source = canonicalCommonSourceByPhysicalPath[ResolvePhysicalPath(reference.Source)]
                })
                .ToList();
            var commonSources = canonicalCommonReferences.Select(reference => reference.Source)
                .Distinct(homebrewPathComparer)
                .ToList();
            var allSources = brotliSources.Concat(commonSources)
                .Distinct(homebrewPathComparer)
                .ToList();
            foreach (string commonSource in commonSources)
            {
                requiredArchitecturesBySource[commonSource] = canonicalCommonReferences
                    .Where(reference => string.Equals(
                        reference.Source,
                        commonSource,
                        homebrewPathComparison))
                    .Select(reference => reference.Architecture)
                    .Distinct(StringComparer.Ordinal)
                    .ToArray();
            }
            foreach (string source in allSources)
            {
                if (!File.Exists(source))
                {
                    Log.LogError($"Detected Homebrew Brotli dependency was not found: {source}");
                    return false;
                }

                var sourceArchitectures = SourceArchitectures(source);
                string[] requiredSourceArchitectures = requiredArchitecturesBySource[source]
                    .Select(architecture => CompatibleArchitectureNames(architecture)
                        .FirstOrDefault(sourceArchitectures.Contains))
                    .ToArray();
                var missingArchitectures = requiredArchitecturesBySource[source]
                    .Where((architecture, index) => requiredSourceArchitectures[index] == null)
                    .ToArray();
                if (missingArchitectures.Length > 0)
                {
                    Log.LogError(
                        $"Detected Homebrew Brotli dependency does not contain all application architectures ({string.Join(", ", missingArchitectures)} missing): {source}");
                    return false;
                }
                requiredArchitecturesBySource[source] = requiredSourceArchitectures
                    .Distinct(StringComparer.Ordinal)
                    .ToArray();
            }
            foreach (string currentLicenseSource in licenseSources)
            {
                if (!File.Exists(currentLicenseSource))
                {
                    Log.LogError($"Detected Homebrew Brotli dependencies, but their license was not found at {currentLicenseSource}.");
                    return false;
                }
                string currentFormulaDirectory = Path.GetDirectoryName(currentLicenseSource)!;
                string physicalLicenseSource = ResolvePhysicalPath(currentLicenseSource);
                string physicalFormulaDirectory = ResolvePhysicalPath(currentFormulaDirectory);
                if (!IsWithinRootWithComparison(
                    physicalLicenseSource,
                    physicalFormulaDirectory,
                    homebrewPathComparison))
                {
                    Log.LogError(
                        $"Detected Homebrew Brotli license resolves outside its formula directory: {currentLicenseSource} -> {physicalLicenseSource}.");
                    return false;
                }
            }
            byte[] attributedLicense = File.ReadAllBytes(licenseSource);
            string physicalAttributedLicenseSource = ResolvePhysicalPath(licenseSource);
            string conflictingLicenseSource = licenseSources
                .Skip(1)
                .FirstOrDefault(source => !File.ReadAllBytes(source).SequenceEqual(attributedLicense));
            if (conflictingLicenseSource != null)
            {
                Log.LogError(
                    $"Detected Homebrew Brotli dependencies from multiple formula roots with conflicting license text: {licenseSource} and {conflictingLicenseSource}.");
                return false;
            }
            string physicalSigningBundle = ResolvePhysicalPath(signingBundlePath);
            if (attributedLicenseBySigningBundle.TryGetValue(
                    physicalSigningBundle,
                    out Tuple<string, byte[]> previousAttribution)
                && !previousAttribution.Item2.SequenceEqual(attributedLicense))
            {
                Log.LogError(
                    $"Detected Homebrew Brotli dependencies in signing bundle '{signingBundlePath}' with conflicting license text: {previousAttribution.Item1} and {licenseSource}.");
                return false;
            }
            attributedLicenseBySigningBundle[physicalSigningBundle] = Tuple.Create(
                licenseSource,
                attributedLicense);

            string entitlements = null;
            var entitlementResult = RunTool(CodesignCli, "-d", "--entitlements", ":-", signingBundlePath);
            bool confirmedNoEntitlements = entitlementResult.ExitCode == 0
                && string.IsNullOrWhiteSpace(entitlementResult.Output);
            if (entitlementResult.ExitCode == 0)
            {
                entitlements = ExtractValidPlist(entitlementResult.Output);
            }
            if (entitlements == null
                && !string.IsNullOrWhiteSpace(FallbackEntitlementsPath)
                && FallbackEntitlementsPath != "-"
                && string.Equals(signingBundlePath, appPath, pathComparison))
            {
                if (!File.Exists(FallbackEntitlementsPath))
                {
                    Log.LogError($"The fallback entitlement file does not exist: {FallbackEntitlementsPath}");
                    return false;
                }

                entitlements = File.ReadAllText(FallbackEntitlementsPath);
                if (ExtractValidPlist(entitlements) == null)
                {
                    Log.LogError($"The fallback entitlement file is not a valid property list: {FallbackEntitlementsPath}");
                    return false;
                }
            }
            if (entitlements == null && !confirmedNoEntitlements)
            {
                string detail = entitlementResult.ExitCode == 0
                    ? "the returned entitlement payload was not a valid property list"
                    : $"codesign exited with code {entitlementResult.ExitCode}: {entitlementResult.Error.Trim()}";
                Log.LogError(
                    $"Could not preserve the application's effective entitlements because {detail}. Configure a valid fallback entitlement file before vendoring Brotli.");
                return false;
            }

            string frameworksPath = Path.Combine(compressionContentsPath, "Frameworks");
            string noticesPath = Path.Combine(compressionContentsPath, "Resources", "ThirdPartyNotices");
            if (!IsSafeBundleDestinationDirectory(frameworksPath, signingBundlePath)
                || !IsSafeBundleDestinationDirectory(noticesPath, signingBundlePath))
            {
                Log.LogError(
                    "Cannot vendor Homebrew Brotli because a destination directory resolves outside its signing bundle or into a nested signing envelope.");
                return false;
            }
            CreateTrackedDirectory(frameworksPath);
            CreateTrackedDirectory(noticesPath);
            var mixedResolutionLoadCommands = new HashSet<string>(
                allBrotliReferences
                    .Where(reference =>
                        !brotliReferences.Any(vendoredReference =>
                            string.Equals(vendoredReference.Architecture, reference.Architecture, StringComparison.Ordinal)
                            && string.Equals(vendoredReference.LoadCommand, reference.LoadCommand, StringComparison.Ordinal))
                        && brotliReferences.Any(vendoredReference =>
                            string.Equals(vendoredReference.LoadCommand, reference.LoadCommand, StringComparison.Ordinal)))
                    .Select(reference => reference.LoadCommand),
                StringComparer.Ordinal);
            var vendoredFileNameBySource = brotliSources.ToDictionary(
                source => source,
                source => "ROI.BuildActions.Homebrew." + SourceIdentifier(source) + "." + Path.GetFileName(source),
                homebrewPathComparer);
            var commonFileNameBySource = commonSources.ToDictionary(
                source => source,
                source => "ROI.BuildActions.Homebrew." + SourceIdentifier(source) + "." + Path.GetFileName(source),
                homebrewPathComparer);
            plannedReservedFileNamesByContentsDirectory[compressionContentsPath].UnionWith(
                vendoredFileNameBySource.Values.Concat(commonFileNameBySource.Values));
            string compressionBackupPath;
            if (!compressionBackupPaths.TryGetValue(physicalCompressionPath, out compressionBackupPath))
            {
                compressionBackupPath = Path.Combine(
                    Path.GetTempPath(),
                    "roi-build-actions-compression-backup-" + Guid.NewGuid().ToString("N") + ".dylib");
                CopyDereferenced(physicalCompressionPath, compressionBackupPath);
                compressionBackupPaths[physicalCompressionPath] = compressionBackupPath;
            }
            try
            {
            foreach (string source in brotliSources)
            {
                string destination = Path.Combine(frameworksPath, vendoredFileNameBySource[source]);
                TrackOutputMutation(destination);
                CopyDereferenced(source, destination);
                ThinBinaryToArchitectures(
                    destination,
                    RequiredArchitecturesForReservedOutput(
                        destination,
                        requiredArchitecturesBySource[source]));
            }
            foreach (string commonSource in commonSources)
            {
                string destination = Path.Combine(frameworksPath, commonFileNameBySource[commonSource]);
                TrackOutputMutation(destination);
                CopyDereferenced(commonSource, destination);
                ThinBinaryToArchitectures(
                    destination,
                    RequiredArchitecturesForReservedOutput(
                        destination,
                        requiredArchitecturesBySource[commonSource]));
            }
            string licenseDestination = Path.Combine(noticesPath, "Brotli-LICENSE.txt");
            TrackOutputMutation(licenseDestination);
            CopyDereferenced(physicalAttributedLicenseSource, licenseDestination);

            var compressionChanges = brotliReferences
                .Select(reference => Tuple.Create(
                    reference.Architecture,
                    reference.LoadCommand,
                    "@loader_path/../Frameworks/" + vendoredFileNameBySource[reference.Source]))
                .ToList();
            IEnumerable<string> ValuesForCleanupArchitecture(
                Dictionary<string, List<string>> values,
                string architecture)
            {
                foreach (string compatibleArchitecture in CompatibleArchitectureNames(architecture))
                {
                    if (values.TryGetValue(
                            compatibleArchitecture,
                            out List<string> architectureValues))
                    {
                        return architectureValues;
                    }
                }
                return values.TryGetValue("default", out List<string> defaultValues)
                    ? defaultValues
                    : new string[0];
            }
            var reachableContextsByBinary = new Dictionary<string, List<Tuple<string, string, IReadOnlyList<string>, IReadOnlyList<Tuple<string, string, string>>>>>(
                pathComparer);
            IEnumerable<IReadOnlyList<string>> EffectiveRuntimeSearchRootContexts(
                string binary,
                string runtimeSearchPathOwner,
                string runtimeSearchRoot,
                string architecture)
            {
                if (!reachableContextsByBinary.TryGetValue(binary, out var binaryContexts))
                {
                    binaryContexts = FindReachableHostBinaries(appPath, binary, false).ToList();
                    reachableContextsByBinary[binary] = binaryContexts;
                }
                string physicalOwner = ResolvePhysicalPath(runtimeSearchPathOwner);
                bool binaryIsOwner = string.Equals(
                        Path.GetFullPath(binary),
                        Path.GetFullPath(runtimeSearchPathOwner),
                        pathComparison)
                    || string.Equals(ResolvePhysicalPath(binary), physicalOwner, pathComparison);
                var contexts = binaryContexts
                    .Where(context => context.Item2 == "default"
                        || architecture == "default"
                        || CompatibleArchitectureNames(context.Item2).Contains(
                            architecture,
                            StringComparer.Ordinal))
                    .ToList();
                if (binaryIsOwner && contexts.Count == 0)
                {
                    contexts.Add(Tuple.Create(
                        binary,
                        architecture,
                        (IReadOnlyList<string>)new string[0],
                        (IReadOnlyList<Tuple<string, string, string>>)new Tuple<string, string, string>[0]));
                }
                foreach (var context in contexts)
                {
                    string executableDirectory = Path.GetDirectoryName(context.Item1)!;
                    var ownEntries = ValuesForCleanupArchitecture(
                            ReadRuntimeSearchPathsByArchitecture(binary),
                            architecture)
                        .Select(path => Tuple.Create(
                            binary,
                            path,
                            ResolveRuntimeSearchPath(path, binary, executableDirectory)))
                        .Where(entry => entry.Item3.Length > 0)
                        .ToList();
                    bool rootCanParticipate = context.Item4.Concat(ownEntries).Any(owner =>
                        string.Equals(ResolvePhysicalPath(owner.Item1), physicalOwner, pathComparison)
                        && string.Equals(owner.Item3, runtimeSearchRoot, homebrewPathComparison));
                    if (rootCanParticipate)
                    {
                        yield return DistinctRuntimeSearchRoots(
                            context.Item3.Concat(ownEntries.Select(entry => entry.Item3)));
                    }
                }
            }
            bool RuntimeSearchRootIsRequiredAfterRewrite(
                string runtimeSearchRoot,
                string architecture,
                string runtimeSearchPathOwner)
            {
                foreach (string binary in new[] { runtimeSearchPathOwner }
                    .Concat(FindMachOBinaries(appPath))
                    .Distinct(pathComparer)
                    .Where(binary => !Path.GetFileName(binary).StartsWith(
                        "ROI.BuildActions.Homebrew.",
                        StringComparison.Ordinal)))
                {
                    var installIds = new HashSet<string>(
                        ValuesForCleanupArchitecture(ReadInstallIdsByArchitecture(binary), architecture),
                        StringComparer.Ordinal);
                    foreach (string dependency in ValuesForCleanupArchitecture(
                        ReadDependenciesByArchitecture(binary),
                        architecture))
                    {
                        if (installIds.Contains(dependency)
                            || !dependency.StartsWith("@rpath/", StringComparison.Ordinal))
                        {
                            continue;
                        }
                        bool isPlannedCompressionRewrite = string.Equals(
                                ResolvePhysicalPath(binary),
                                physicalCompressionPath,
                                pathComparison)
                            && compressionChanges.Any(change =>
                                (change.Item1 == "default"
                                    || architecture == "default"
                                    || CompatibleArchitectureNames(architecture).Contains(
                                        change.Item1,
                                        StringComparer.Ordinal))
                                && string.Equals(change.Item2, dependency, StringComparison.Ordinal));
                        if (isPlannedCompressionRewrite)
                        {
                            continue;
                        }
                        string suffix = dependency.Substring("@rpath/".Length);
                        foreach (var effectiveRoots in EffectiveRuntimeSearchRootContexts(
                            binary,
                            runtimeSearchPathOwner,
                            runtimeSearchRoot,
                            architecture))
                        {
                            string firstEffectiveRoot = effectiveRoots.FirstOrDefault(root =>
                            {
                                string candidate = Path.GetFullPath(Path.Combine(root, suffix));
                                return File.Exists(candidate)
                                    ? ExistingBinarySupportsArchitecture(candidate, architecture, binary)
                                    : IsExplicitlyAllowedPath(candidate);
                            });
                            if (firstEffectiveRoot != null
                                && string.Equals(firstEffectiveRoot, runtimeSearchRoot, homebrewPathComparison))
                            {
                                return true;
                            }
                        }
                    }
                }
                return false;
            }
            var homebrewRuntimeSearchPaths = rawRuntimeSearchPathsByArchitecture
                .SelectMany(pair => pair.Value.Select(path => Tuple.Create(pair.Key, path)))
                .Where(item =>
                {
                    var resolvedRoots = DistinctRuntimeSearchRoots(
                        ExecutableDirectoriesForArchitecture(item.Item1)
                            .Select(directory => ResolveRuntimeSearchPath(item.Item2, compressionPath, directory))
                            .Where(resolvedPath => resolvedPath.Length > 0));
                    return resolvedRoots.Any(resolvedPath =>
                        IsWithinHomebrewRoot(resolvedPath, homebrewRoot)
                        && !IsExplicitlyAllowedPath(resolvedPath))
                        && !resolvedRoots.Any(resolvedPath =>
                            RuntimeSearchRootIsRequiredAfterRewrite(
                                resolvedPath,
                                item.Item1,
                                compressionPath));
                })
                .ToList();
            var inheritedRuntimeSearchPathsToDelete = reachableLaunchContexts
                .SelectMany(context => context.Item4.Select(owner => new
                {
                    Owner = owner.Item1,
                    Architecture = context.Item2,
                    RuntimeSearchPath = owner.Item2,
                    ResolvedRoot = owner.Item3
                }))
                .Where(item => !string.Equals(
                    ResolvePhysicalPath(item.Owner),
                    physicalCompressionPath,
                    pathComparison))
                .GroupBy(item => string.Join("\u001f",
                    ResolvePhysicalPath(item.Owner),
                    item.Architecture,
                    item.RuntimeSearchPath),
                    StringComparer.Ordinal)
                .Where(group => group.All(item =>
                    IsWithinHomebrewRoot(item.ResolvedRoot, homebrewRoot)
                    && !IsExplicitlyAllowedPath(item.ResolvedRoot)))
                .Where(group => !group.Any(item => RuntimeSearchRootIsRequiredAfterRewrite(
                    item.ResolvedRoot,
                    item.Architecture,
                    item.Owner)))
                .Select(group => group.First())
                .GroupBy(item => ResolvePhysicalPath(item.Owner), pathComparer)
                .ToList();
            RewriteLoadCommands(
                physicalCompressionPath,
                compressionChanges,
                requiredArchitectures,
                (requiredArchitectures.Length > 1 && homebrewRuntimeSearchPaths.Count > 0)
                    || mixedResolutionLoadCommands.Count > 0
                    || brotliReferences
                        .GroupBy(reference => reference.LoadCommand, StringComparer.Ordinal)
                        .Any(group => group
                            .Select(reference => reference.Source)
                            .Distinct(homebrewPathComparer)
                            .Skip(1)
                            .Any()),
                homebrewRuntimeSearchPaths);

            foreach (string source in brotliSources)
            {
                string fileName = vendoredFileNameBySource[source];
                string destination = Path.Combine(frameworksPath, fileName);
                var sourceCommonReferences = canonicalCommonReferences
                    .Where(reference => string.Equals(
                        reference.BrotliSource,
                        source,
                        homebrewPathComparison)
                        && reference.LoadCommand.Length > 0)
                    .ToList();
                var commonChanges = sourceCommonReferences
                    .Select(reference => Tuple.Create(
                        reference.Architecture,
                        reference.LoadCommand,
                        "@loader_path/" + commonFileNameBySource[reference.Source]))
                    .ToList();
                var accumulatedCommonChanges = CommonChangesForReservedOutput(
                    destination,
                    commonChanges);
                var sourceHomebrewRuntimeSearchPaths = ObsoleteHomebrewRuntimeSearchPaths(source).ToList();
                if (accumulatedCommonChanges.Count > 0)
                {
                    RewriteLoadCommands(
                        destination,
                        accumulatedCommonChanges,
                        RequiredArchitecturesForReservedOutput(
                            destination,
                            requiredArchitecturesBySource[source]),
                        (RequiredArchitecturesForReservedOutput(
                                destination,
                                requiredArchitecturesBySource[source]).Length > 1
                            && sourceHomebrewRuntimeSearchPaths.Count > 0)
                            || accumulatedCommonChanges
                                .GroupBy(change => change.Item2, StringComparer.Ordinal)
                                .Any(group => group
                                    .Select(change => change.Item3)
                                    .Distinct(StringComparer.Ordinal)
                                    .Skip(1)
                                    .Any()),
                        sourceHomebrewRuntimeSearchPaths);
                }
                RequireTool("Brotli install-name update", InstallNameToolCli, "-id", "@rpath/" + fileName, destination);
            }
            var commonDestinations = commonSources
                .Select(source => Path.Combine(frameworksPath, commonFileNameBySource[source]))
                .ToList();
            foreach (string commonSource in commonSources)
            {
                string commonFileName = commonFileNameBySource[commonSource];
                RequireTool(
                    "Brotli common-library install-name update",
                    InstallNameToolCli,
                    "-id",
                    "@rpath/" + commonFileName,
                    Path.Combine(frameworksPath, commonFileName));
            }

            var modifiedRuntimeSearchPathOwners = new List<string>();
            var modifiedRuntimeSearchPathOwnerBundles = new HashSet<string>(pathComparer);
            foreach (var deletionGroup in inheritedRuntimeSearchPathsToDelete)
            {
                string physicalOwnerPath = deletionGroup.Key;
                if (!IsWithinRoot(physicalOwnerPath, ResolvePhysicalPath(appPath)))
                {
                    Log.LogError(
                        $"Cannot remove inherited Homebrew runtime search path because its owner resolves outside the application bundle: {physicalOwnerPath}.");
                    return false;
                }
                var ownerArchitectures = RequireTool(
                        "Runtime-search-path owner architecture inspection",
                        LipoCli,
                        "-archs",
                        physicalOwnerPath)
                    .Split((char[])null, StringSplitOptions.RemoveEmptyEntries)
                    .Distinct(StringComparer.Ordinal)
                    .ToArray();
                var ownerRuntimeSearchPathsToDelete = deletionGroup
                    .Select(item => Tuple.Create(item.Architecture, item.RuntimeSearchPath))
                    .GroupBy(item => item.Item1 + "\u001f" + item.Item2, StringComparer.Ordinal)
                    .Select(group => group.First())
                    .ToList();
                TrackOutputMutation(physicalOwnerPath);
                RewriteLoadCommands(
                    physicalOwnerPath,
                    new Tuple<string, string, string>[0],
                    ownerArchitectures,
                    ownerArchitectures.Length > 1
                        && ownerRuntimeSearchPathsToDelete.Any(item => item.Item1 != "default"),
                    ownerRuntimeSearchPathsToDelete);
                modifiedRuntimeSearchPathOwners.Add(physicalOwnerPath);
                modifiedRuntimeSearchPathOwnerBundles.Add(LogicalBundlePathForPhysicalBundle(
                    FindSigningBundle(physicalOwnerPath, physicalAppPath)));
            }

            string entitlementsPath = null;
            try
            {
                if (entitlements != null)
                {
                    entitlementsPath = Path.Combine(
                        Path.GetTempPath(),
                        "roi-build-actions-entitlements-" + Guid.NewGuid().ToString("N") + ".plist");
                    File.WriteAllText(entitlementsPath, entitlements);
                }

                foreach (string path in commonDestinations
                    .Concat(brotliSources.Select(source => Path.Combine(frameworksPath, vendoredFileNameBySource[source])))
                    .Concat(new[] { physicalCompressionPath })
                    .Distinct(pathComparer))
                {
                    RequireTool(
                        "Hardened native-library signing",
                        CodesignCli,
                        "--force",
                        "--sign",
                        ApplicationSigningIdentity,
                        "--timestamp",
                        "--options",
                        "runtime",
                        path);
                }
                foreach (string path in modifiedRuntimeSearchPathOwners.Distinct(pathComparer))
                {
                    RequireTool(
                        "Runtime-search-path owner signing",
                        CodesignCli,
                        "--force",
                        "--sign",
                        ApplicationSigningIdentity,
                        "--timestamp",
                        "--options",
                        "runtime",
                        "--preserve-metadata=entitlements,requirements",
                        path);
                }

                void SignRuntimeSearchPathOwnerBundle(string ownerSigningBundle)
                {
                    TrackBundleSigningMutations(ownerSigningBundle);
                    RequireTool(
                        "Runtime-search-path owner bundle re-signing",
                        CodesignCli,
                        "--force",
                        "--sign",
                        ApplicationSigningIdentity,
                        "--timestamp",
                        "--options",
                        "runtime",
                        "--preserve-metadata=entitlements,requirements",
                        ownerSigningBundle);
                    repairedSigningBundles.Add(ownerSigningBundle);
                }
                var distinctOwnerSigningBundles = modifiedRuntimeSearchPathOwnerBundles
                    .Where(bundle => !string.Equals(bundle, signingBundlePath, pathComparison))
                    .Distinct(pathComparer)
                    .ToList();
                foreach (string ownerSigningBundle in distinctOwnerSigningBundles
                    .Where(bundle => IsWithinRoot(bundle, signingBundlePath))
                    .OrderByDescending(path => path.Length))
                {
                    SignRuntimeSearchPathOwnerBundle(ownerSigningBundle);
                }

                var applicationSigningArguments = new List<string>
                {
                    "--force",
                    "--sign",
                    ApplicationSigningIdentity,
                    "--timestamp",
                    "--options",
                    "runtime",
                    "--preserve-metadata=requirements"
                };
                if (entitlementsPath != null)
                {
                    applicationSigningArguments.Add("--entitlements");
                    applicationSigningArguments.Add(entitlementsPath);
                }
                applicationSigningArguments.Add(signingBundlePath);
                TrackBundleSigningMutations(signingBundlePath);
                RequireTool("Application re-signing", CodesignCli, applicationSigningArguments.ToArray());
                repairedSigningBundles.Add(signingBundlePath);
                foreach (string ownerSigningBundle in distinctOwnerSigningBundles.Where(bundle =>
                    !IsWithinRoot(bundle, signingBundlePath)))
                {
                    SignRuntimeSearchPathOwnerBundle(ownerSigningBundle);
                }
            }
            finally
            {
                if (entitlementsPath != null)
                {
                    File.Delete(entitlementsPath);
                }
            }

            Log.LogMessage(MessageImportance.Normal,
                "Vendored detected Homebrew Brotli dependencies and included Brotli-LICENSE.txt.");
            completedRepairByPhysicalCompressionPath[physicalCompressionPath] = Tuple.Create(
                compressionContentsPath,
                new HashSet<string>(
                    plannedReservedFileNamesByContentsDirectory[compressionContentsPath],
                    StringComparer.Ordinal));
            }
            catch
            {
                CopyDereferenced(compressionBackupPath, physicalCompressionPath);
                throw;
            }
            }
            string FindNearestContentsDirectory(string path, string signingBundlePath)
            {
                string directory = Path.GetDirectoryName(Path.GetFullPath(path))!;
                while (IsWithinRoot(directory, signingBundlePath))
                {
                    if (string.Equals(
                        Path.GetFileName(directory),
                        "Contents",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        return directory;
                    }
                    if (string.Equals(directory, signingBundlePath, pathComparison))
                    {
                        break;
                    }
                    string parent = Path.GetDirectoryName(directory);
                    if (string.IsNullOrWhiteSpace(parent) || parent == directory)
                    {
                        break;
                    }
                    directory = parent;
                }
                return string.Empty;
            }
            string ResolveReservedDependencyPathForRetention(string loadCommand, string binaryPath)
            {
                if (Path.IsPathRooted(loadCommand))
                {
                    return Path.GetFullPath(loadCommand);
                }
                const string loaderToken = "@loader_path";
                if (string.Equals(loadCommand, loaderToken, StringComparison.Ordinal))
                {
                    return Path.GetDirectoryName(Path.GetFullPath(binaryPath))!;
                }
                string loaderPrefix = loaderToken + "/";
                if (loadCommand.StartsWith(loaderPrefix, StringComparison.Ordinal))
                {
                    return Path.GetFullPath(Path.Combine(
                        Path.GetDirectoryName(Path.GetFullPath(binaryPath))!,
                        loadCommand.Substring(loaderPrefix.Length)));
                }
                return string.Empty;
            }
            bool PathsReferToSameReservedOutput(string candidatePath, string resolvedPath)
            {
                if (string.Equals(
                    Path.GetFullPath(candidatePath),
                    Path.GetFullPath(resolvedPath),
                    pathComparison))
                {
                    return true;
                }
                return FileSystemEntryExists(candidatePath)
                    && FileSystemEntryExists(resolvedPath)
                    && string.Equals(
                        ResolvePhysicalPath(candidatePath),
                        ResolvePhysicalPath(resolvedPath),
                        pathComparison);
            }
            bool DependencyRetainsReservedOutput(
                string loadCommand,
                string binaryPath,
                string architecture,
                string contentsPath,
                string signingBundlePath,
                IDictionary<string, string> reservedOutputsByName,
                out string retainedFileName)
            {
                retainedFileName = FileNameFromLoadCommand(loadCommand);
                if (!IsReservedBrotliFileName(retainedFileName)
                    || !reservedOutputsByName.TryGetValue(retainedFileName, out string candidatePath))
                {
                    return false;
                }
                if (loadCommand.StartsWith("@rpath/", StringComparison.Ordinal))
                {
                    string suffix = loadCommand.Substring("@rpath/".Length);
                    foreach (var context in FindReachableHostBinaries(appPath, candidatePath, false)
                        .Where(context => CompatibleArchitectureNames(context.Item2).Contains(
                                architecture,
                                StringComparer.Ordinal)
                            || string.Equals(context.Item2, "default", StringComparison.Ordinal)
                            || string.Equals(architecture, "default", StringComparison.Ordinal)))
                    {
                        string resolvedCandidate = context.Item3
                            .Select(root => Path.GetFullPath(Path.Combine(root, suffix)))
                            .FirstOrDefault(path =>
                                FileSystemEntryExists(path)
                                && ExistingBinarySupportsArchitecture(
                                    path,
                                    architecture,
                                    binaryPath));
                        if (!string.IsNullOrWhiteSpace(resolvedCandidate)
                            && PathsReferToSameReservedOutput(candidatePath, resolvedCandidate))
                        {
                            return true;
                        }
                    }
                    return false;
                }
                string resolvedPath = ResolveReservedDependencyPathForRetention(loadCommand, binaryPath);
                if (string.IsNullOrWhiteSpace(resolvedPath))
                {
                    return string.Equals(
                        FindNearestContentsDirectory(binaryPath, signingBundlePath),
                        contentsPath,
                        pathComparison);
                }
                return PathsReferToSameReservedOutput(candidatePath, resolvedPath);
            }
            foreach (var candidateContentsDirectory in candidateContentsDirectories)
            {
                string contentsPath = candidateContentsDirectory.Item1;
                string signingBundlePath = candidateContentsDirectory.Item2;
                string frameworksPath = Path.Combine(contentsPath, "Frameworks");
                if (Directory.Exists(frameworksPath)
                    && !IsSafeBundleDestinationDirectory(frameworksPath, signingBundlePath))
                {
                    Log.LogError(
                        "Cannot reconcile Homebrew Brotli outputs because the Frameworks directory resolves outside the application bundle.");
                    return false;
                }

                var reservedOutputsByName = Directory.Exists(frameworksPath)
                    ? Directory.EnumerateFileSystemEntries(
                            frameworksPath,
                            reservedBrotliPrefix + "*",
                            SearchOption.TopDirectoryOnly)
                        .Where(path => IsReservedBrotliFileName(Path.GetFileName(path)))
                        .ToDictionary(Path.GetFileName, path => path, StringComparer.Ordinal)
                    : new Dictionary<string, string>(StringComparer.Ordinal);
                var retainedFileNames = new HashSet<string>(
                    plannedReservedFileNamesByContentsDirectory[contentsPath],
                    StringComparer.Ordinal);
                string logicalCompressionPath = Path.Combine(
                    contentsPath,
                    "MonoBundle",
                    "libSystem.IO.Compression.Native.dylib");
                var retentionBinaries = FindMachOBinaries(signingBundlePath)
                    .Where(binaryPath => string.Equals(
                        FindSigningBundle(binaryPath, appPath),
                        signingBundlePath,
                        pathComparison))
                    .Where(binaryPath => !reservedOutputsByName.Values.Contains(binaryPath, pathComparer));
                if (File.Exists(logicalCompressionPath)
                    && string.Equals(
                        FindSigningBundle(logicalCompressionPath, appPath),
                        signingBundlePath,
                        pathComparison))
                {
                    retentionBinaries = retentionBinaries.Append(logicalCompressionPath);
                }
                foreach (string binaryPath in retentionBinaries.Distinct(pathComparer))
                {
                    foreach (var dependencyGroup in ReadDependenciesByArchitecture(binaryPath))
                    {
                        foreach (string loadCommand in dependencyGroup.Value)
                        {
                            if (DependencyRetainsReservedOutput(
                                loadCommand,
                                binaryPath,
                                dependencyGroup.Key,
                                contentsPath,
                                signingBundlePath,
                                reservedOutputsByName,
                                out string retainedFileName))
                            {
                                retainedFileNames.Add(retainedFileName);
                            }
                        }
                    }
                }
                var pendingRetainedFileNames = new Queue<string>(retainedFileNames);
                while (pendingRetainedFileNames.Count > 0)
                {
                    string retainedFileName = pendingRetainedFileNames.Dequeue();
                    if (!reservedOutputsByName.TryGetValue(retainedFileName, out string retainedPath)
                        || !IsMachOFile(retainedPath))
                    {
                        continue;
                    }
                    foreach (var dependencyGroup in ReadDependenciesByArchitecture(retainedPath))
                    {
                        foreach (string loadCommand in dependencyGroup.Value)
                        {
                            if (DependencyRetainsReservedOutput(
                                loadCommand,
                                retainedPath,
                                dependencyGroup.Key,
                                contentsPath,
                                signingBundlePath,
                                reservedOutputsByName,
                                out string dependencyFileName)
                                && retainedFileNames.Add(dependencyFileName))
                            {
                                pendingRetainedFileNames.Enqueue(dependencyFileName);
                            }
                        }
                    }
                }

                var staleReservedOutputs = reservedOutputsByName
                    .Where(output => !retainedFileNames.Contains(output.Key))
                    .Select(output => output.Value)
                    .ToList();
                string noticeDirectory = Path.Combine(
                    contentsPath,
                    "Resources",
                    "ThirdPartyNotices");
                string noticePath = Path.Combine(noticeDirectory, "Brotli-LICENSE.txt");
                if (retainedFileNames.Count > 0
                    && !IsReadableContainedNotice(noticePath, signingBundlePath))
                {
                    Log.LogError(
                        $"Retained Homebrew Brotli outputs under '{frameworksPath}' require '{noticePath}', but the notice is missing, unreadable, or resolves outside its signing bundle. Rebuild the application bundle from a clean output directory.");
                    return false;
                }
                bool staleNoticeExists = staleReservedOutputs.Count > 0
                    && retainedFileNames.Count == 0
                    && FileSystemEntryExists(noticePath);
                if (staleReservedOutputs.Count == 0 && !staleNoticeExists)
                {
                    continue;
                }
                if (string.IsNullOrWhiteSpace(ApplicationSigningIdentity) || ApplicationSigningIdentity == "-")
                {
                    Log.LogError("Detected stale Homebrew Brotli outputs or notice, but no application signing identity was configured.");
                    return false;
                }
                foreach (string staleReservedOutput in staleReservedOutputs)
                {
                    TrackOutputMutation(staleReservedOutput);
                    File.Delete(staleReservedOutput);
                }
                if (staleNoticeExists)
                {
                    if (!IsSafeBundleDestinationDirectory(noticeDirectory, signingBundlePath))
                    {
                        Log.LogError(
                            "Cannot reconcile the Homebrew Brotli notice because its directory resolves outside the application bundle.");
                        return false;
                    }
                    TrackOutputMutation(noticePath);
                    File.Delete(noticePath);
                }
                TrackBundleSigningMutations(signingBundlePath);
                RequireTool(
                    "Application re-signing after stale Brotli cleanup",
                    CodesignCli,
                    "--force",
                    "--sign",
                    ApplicationSigningIdentity,
                    "--timestamp",
                    "--options",
                    "runtime",
                    "--preserve-metadata=entitlements,requirements",
                    signingBundlePath);
                repairedSigningBundles.Add(signingBundlePath);
                Log.LogMessage(
                    MessageImportance.Normal,
                    $"Removed {staleReservedOutputs.Count} unreferenced reserved Homebrew Brotli output(s)"
                    + (staleNoticeExists ? " and its stale notice." : "."));
            }
            var enclosingSigningBundles = new HashSet<string>(pathComparer);
            foreach (string repairedBundle in repairedSigningBundles)
            {
                if (string.Equals(repairedBundle, appPath, pathComparison))
                {
                    continue;
                }
                string bundle = Path.GetDirectoryName(repairedBundle)!;
                while (IsWithinRoot(bundle, appPath))
                {
                    if (IsCodeSigningBundle(bundle, appPath))
                    {
                        enclosingSigningBundles.Add(bundle);
                    }
                    if (string.Equals(bundle, appPath, pathComparison))
                    {
                        break;
                    }
                    bundle = Path.GetDirectoryName(bundle)!;
                }
                enclosingSigningBundles.Add(appPath);
            }
            foreach (string bundle in enclosingSigningBundles.OrderByDescending(path => path.Length))
            {
                TrackBundleSigningMutations(bundle);
                RequireTool(
                    "Enclosing application re-signing",
                    CodesignCli,
                    "--force",
                    "--sign",
                    ApplicationSigningIdentity,
                    "--timestamp",
                    "--options",
                    "runtime",
                    "--preserve-metadata=entitlements,requirements",
                    bundle);
            }
            repairSucceeded = true;
        }
        catch (Exception exception) when (
            exception is IOException
            || exception is UnauthorizedAccessException
            || exception is InvalidOperationException
            || exception is NotSupportedException)
        {
            Log.LogError(exception.Message);
            return false;
        }
        finally
        {
            if (!repairSucceeded)
            {
                RestoreTrackedOutputs();
                foreach (var backup in compressionBackupPaths)
                {
                    if (File.Exists(backup.Value))
                    {
                        CopyDereferenced(backup.Value, backup.Key);
                    }
                }
            }
            foreach (string backupPath in compressionBackupPaths.Values)
            {
                File.Delete(backupPath);
            }
            foreach (string backupPath in outputBackupPaths.Values)
            {
                File.Delete(backupPath);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="RoiBuildActionsValidateMacNativeDependenciesTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <CliPath ParameterType="System.String" Required="true" />
      <LipoCliPath ParameterType="System.String" Required="true" />
      <ApplicationBundlePath ParameterType="System.String" Required="true" />
      <AdditionalAllowedPrefixes ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string QuoteArgument(string argument)
        {
            var quoted = new StringBuilder(argument.Length + 2);
            quoted.Append('"');
            int backslashCount = 0;
            foreach (char character in argument)
            {
                if (character == '\\')
                {
                    backslashCount++;
                    continue;
                }

                if (character == '"')
                {
                    quoted.Append('\\', (backslashCount * 2) + 1);
                    quoted.Append(character);
                }
                else
                {
                    quoted.Append('\\', backslashCount);
                    quoted.Append(character);
                }
                backslashCount = 0;
            }
            quoted.Append('\\', backslashCount * 2);
            quoted.Append('"');
            return quoted.ToString();
        }

        bool IsMachO(string path)
        {
            try
            {
                using var stream = File.OpenRead(path);
                var header = new byte[32];
                if (stream.Read(header, 0, 4) != 4)
                {
                    return false;
                }

                uint ReadUInt32(byte[] bytes, int offset, bool bigEndian)
                {
                    return bigEndian
                        ? ((uint)bytes[offset] << 24) | ((uint)bytes[offset + 1] << 16) | ((uint)bytes[offset + 2] << 8) | bytes[offset + 3]
                        : ((uint)bytes[offset + 3] << 24) | ((uint)bytes[offset + 2] << 16) | ((uint)bytes[offset + 1] << 8) | bytes[offset];
                }
                ulong ReadUInt64(byte[] bytes, int offset, bool bigEndian)
                {
                    uint first = ReadUInt32(bytes, offset, bigEndian);
                    uint second = ReadUInt32(bytes, offset + 4, bigEndian);
                    return bigEndian ? ((ulong)first << 32) | second : ((ulong)second << 32) | first;
                }
                bool IsSupportedCpuType(uint cpuType)
                {
                    return cpuType == 7
                        || cpuType == 12
                        || cpuType == 18
                        || cpuType == 0x01000007
                        || cpuType == 0x0100000c
                        || cpuType == 0x01000012;
                }

                bool thinMachO = (header[0] == 0xfe && header[1] == 0xed && header[2] == 0xfa && (header[3] == 0xce || header[3] == 0xcf))
                    || ((header[0] == 0xce || header[0] == 0xcf) && header[1] == 0xfa && header[2] == 0xed && header[3] == 0xfe);
                if (thinMachO)
                {
                    bool bigEndianThin = header[0] == 0xfe;
                    bool thin64 = header[3] == 0xcf || header[0] == 0xcf;
                    int headerSize = thin64 ? 32 : 28;
                    int bytesRead = 4;
                    while (bytesRead < headerSize)
                    {
                        int count = stream.Read(header, bytesRead, headerSize - bytesRead);
                        if (count == 0)
                        {
                            return false;
                        }
                        bytesRead += count;
                    }
                    uint cpuType = ReadUInt32(header, 4, bigEndianThin);
                    uint fileType = ReadUInt32(header, 12, bigEndianThin);
                    uint loadCommandCount = ReadUInt32(header, 16, bigEndianThin);
                    uint loadCommandSize = ReadUInt32(header, 20, bigEndianThin);
                    return IsSupportedCpuType(cpuType)
                        && fileType >= 1
                        && fileType <= 12
                        && loadCommandCount <= 65535
                        && loadCommandSize >= (ulong)loadCommandCount * 8
                        && (ulong)headerSize + loadCommandSize <= (ulong)stream.Length;
                }

                bool bigEndianFat = header[0] == 0xca && header[1] == 0xfe && header[2] == 0xba
                    && (header[3] == 0xbe || header[3] == 0xbf);
                bool littleEndianFat = (header[0] == 0xbe || header[0] == 0xbf)
                    && header[1] == 0xba && header[2] == 0xfe && header[3] == 0xca;
                if (!bigEndianFat && !littleEndianFat)
                {
                    return false;
                }
                if (stream.Read(header, 4, 4) != 4)
                {
                    return false;
                }

                bool fat64 = header[3] == 0xbf || header[0] == 0xbf;
                uint architectureCount = ReadUInt32(header, 4, bigEndianFat);
                int architectureSize = fat64 ? 32 : 20;
                if (architectureCount == 0 || architectureCount > 1024)
                {
                    return false;
                }
                long tableLength = 8L + ((long)architectureCount * architectureSize);
                if (tableLength > stream.Length)
                {
                    return false;
                }

                var architecture = new byte[architectureSize];
                bool hasSupportedArchitecture = false;
                for (uint index = 0; index < architectureCount; index++)
                {
                    if (stream.Read(architecture, 0, architecture.Length) != architecture.Length)
                    {
                        return false;
                    }
                    uint cpuType = ReadUInt32(architecture, 0, bigEndianFat);
                    hasSupportedArchitecture |= IsSupportedCpuType(cpuType);
                    ulong offset = fat64
                        ? ReadUInt64(architecture, 8, bigEndianFat)
                        : ReadUInt32(architecture, 8, bigEndianFat);
                    ulong size = fat64
                        ? ReadUInt64(architecture, 16, bigEndianFat)
                        : ReadUInt32(architecture, 12, bigEndianFat);
                    if (size == 0
                        || offset < (ulong)tableLength
                        || offset > (ulong)stream.Length
                        || size > (ulong)stream.Length - offset)
                    {
                        return false;
                    }
                }
                return hasSupportedArchitecture;
            }
            catch (IOException exception)
            {
                throw new InvalidOperationException($"Could not inspect application-bundle file '{path}'.", exception);
            }
            catch (UnauthorizedAccessException exception)
            {
                throw new InvalidOperationException($"Could not inspect application-bundle file '{path}'.", exception);
            }
        }

        string bundleFullPath = Path.GetFullPath(ApplicationBundlePath)
            .TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        var linkTargetProperty = typeof(FileSystemInfo).GetProperty("LinkTarget");
        var resolveLinkTargetMethod = typeof(FileSystemInfo).GetMethod(
            "ResolveLinkTarget",
            new[] { typeof(bool) });

        string ResolvePhysicalPath(string path)
        {
            string fullPath = Path.GetFullPath(path);
            string root = Path.GetPathRoot(fullPath)!;
            string currentPath = root;
            string[] segments = fullPath.Substring(root.Length)
                .Split(
                    new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar },
                    StringSplitOptions.RemoveEmptyEntries);
            for (int index = 0; index < segments.Length; index++)
            {
                currentPath = Path.Combine(currentPath, segments[index]);
                FileSystemInfo fileSystemInfo = index == segments.Length - 1
                    ? new FileInfo(currentPath)
                    : new DirectoryInfo(currentPath);
                string linkTarget = linkTargetProperty?.GetValue(fileSystemInfo) as string;
                if (string.IsNullOrWhiteSpace(linkTarget))
                {
                    continue;
                }

                var resolvedTarget = resolveLinkTargetMethod?.Invoke(
                    fileSystemInfo,
                    new object[] { true }) as FileSystemInfo;
                if (resolvedTarget == null)
                {
                    throw new InvalidOperationException(
                        $"Could not resolve symbolic link '{currentPath}'.");
                }
                currentPath = ResolvePhysicalPath(resolvedTarget.FullName);
            }
            return Path.GetFullPath(currentPath);
        }

        string bundlePhysicalPath = ResolvePhysicalPath(bundleFullPath)
            .TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        bool IsCaseInsensitiveFileSystem(string existingPath)
        {
            try
            {
                string name = Path.GetFileName(existingPath);
                int letterIndex = name.IndexOfAny("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".ToCharArray());
                if (letterIndex < 0)
                {
                    return false;
                }
                char[] alternateName = name.ToCharArray();
                alternateName[letterIndex] = char.IsUpper(alternateName[letterIndex])
                    ? char.ToLowerInvariant(alternateName[letterIndex])
                    : char.ToUpperInvariant(alternateName[letterIndex]);
                string parent = Path.GetDirectoryName(existingPath)!;
                string alternatePath = Path.Combine(parent, new string(alternateName));
                if (!Directory.Exists(alternatePath) && !File.Exists(alternatePath))
                {
                    return false;
                }
                return Directory.EnumerateFileSystemEntries(parent)
                    .Count(entry => string.Equals(Path.GetFileName(entry), name, StringComparison.OrdinalIgnoreCase)) == 1;
            }
            catch (IOException)
            {
                return false;
            }
            catch (UnauthorizedAccessException)
            {
                return false;
            }
        }

        StringComparison pathComparison = IsCaseInsensitiveFileSystem(bundlePhysicalPath)
            ? StringComparison.OrdinalIgnoreCase
            : StringComparison.Ordinal;

        bool IsWithinRootWithComparison(string path, string root, StringComparison comparison)
        {
            string fullPath = Path.GetFullPath(path);
            return string.Equals(fullPath, root, comparison)
                || fullPath.StartsWith(root + Path.DirectorySeparatorChar, comparison)
                || fullPath.StartsWith(root + Path.AltDirectorySeparatorChar, comparison);
        }

        bool IsWithinRoot(string path, string root)
        {
            return IsWithinRootWithComparison(path, root, pathComparison);
        }

        string PathForCaseSensitivityProbe(string existingPath)
        {
            if (!string.IsNullOrEmpty(Path.GetFileName(existingPath)))
            {
                return existingPath;
            }
            try
            {
                return Directory.EnumerateFileSystemEntries(existingPath)
                    .FirstOrDefault(entry => Path.GetFileName(entry)
                        .Any(character => char.IsLetter(character)))
                    ?? existingPath;
            }
            catch (IOException)
            {
                return existingPath;
            }
            catch (UnauthorizedAccessException)
            {
                return existingPath;
            }
        }

        string NormalizeAllowedRoot(string path)
        {
            string fullPath = Path.GetFullPath(path);
            string pathRoot = Path.GetPathRoot(fullPath) ?? string.Empty;
            return string.Equals(fullPath, pathRoot, StringComparison.Ordinal)
                ? fullPath
                : fullPath.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        }

        StringComparison ComparisonForAllowedRoot(string root)
        {
            string existingPath = root;
            while (!Directory.Exists(existingPath) && !File.Exists(existingPath))
            {
                string parent = Path.GetDirectoryName(existingPath);
                if (string.IsNullOrWhiteSpace(parent) || parent == existingPath)
                {
                    return StringComparison.Ordinal;
                }
                existingPath = parent;
            }
            return IsCaseInsensitiveFileSystem(PathForCaseSensitivityProbe(existingPath))
                ? StringComparison.OrdinalIgnoreCase
                : StringComparison.Ordinal;
        }

        IReadOnlyList<string> DistinctRuntimeSearchRoots(IEnumerable<string> roots)
        {
            var distinctRoots = new List<string>();
            foreach (string root in roots)
            {
                string fullRoot = Path.GetFullPath(root);
                StringComparison comparison = ComparisonForAllowedRoot(fullRoot);
                if (!distinctRoots.Any(existing => string.Equals(existing, fullRoot, comparison)))
                {
                    distinctRoots.Add(fullRoot);
                }
            }
            return distinctRoots;
        }

        var allowedAbsoluteRoots = new List<Tuple<string, StringComparison>>
        {
            Tuple.Create(NormalizeAllowedRoot("/usr/lib"), ComparisonForAllowedRoot(NormalizeAllowedRoot("/usr/lib"))),
            Tuple.Create(NormalizeAllowedRoot("/System"), ComparisonForAllowedRoot(NormalizeAllowedRoot("/System")))
        };
        var explicitlyAllowedAbsoluteRoots = new List<Tuple<string, StringComparison>>();
        if (AdditionalAllowedPrefixes != null)
        {
            string relativeAllowedPrefix = AdditionalAllowedPrefixes
                .Select(item => item.ItemSpec.Trim())
                .Where(prefix => prefix.Length > 0)
                .FirstOrDefault(prefix => !Path.IsPathRooted(prefix));
            if (!string.IsNullOrWhiteSpace(relativeAllowedPrefix))
            {
                Log.LogError(
                    $"Additional allowed native dependency prefixes must be absolute paths: {relativeAllowedPrefix}");
                return false;
            }
            explicitlyAllowedAbsoluteRoots.AddRange(
                AdditionalAllowedPrefixes
                    .Select(item => item.ItemSpec.Trim())
                    .Where(prefix => prefix.Length > 0)
                    .Select(prefix =>
                    {
                        string root = NormalizeAllowedRoot(prefix);
                        return Tuple.Create(root, ComparisonForAllowedRoot(root));
                    }));
            allowedAbsoluteRoots.AddRange(explicitlyAllowedAbsoluteRoots);
        }
        string mutableSystemVolumesRoot = NormalizeAllowedRoot("/System/Volumes");
        StringComparison mutableSystemVolumesComparison = ComparisonForAllowedRoot(mutableSystemVolumesRoot);
        string systemLibraryRoot = NormalizeAllowedRoot("/System/Library");
        StringComparison systemLibraryComparison = ComparisonForAllowedRoot(systemLibraryRoot);

        string RunInspection(string option, string binaryPath)
        {
            var startInfo = new ProcessStartInfo
            {
                FileName = CliPath,
                Arguments = "-arch all " + option + " " + QuoteArgument(binaryPath),
                UseShellExecute = false,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                CreateNoWindow = true
            };

            using var process = Process.Start(startInfo);
            if (process == null)
            {
                throw new InvalidOperationException($"Failed to start macOS native dependency inspection tool: {CliPath}");
            }

            System.Threading.Tasks.Task<string> standardOutput = process.StandardOutput.ReadToEndAsync();
            System.Threading.Tasks.Task<string> standardError = process.StandardError.ReadToEndAsync();
            process.WaitForExit();
            System.Threading.Tasks.Task.WaitAll(standardOutput, standardError);
            if (process.ExitCode != 0)
            {
                throw new InvalidOperationException(
                    $"Native dependency inspection {option} failed for {binaryPath} with exit code {process.ExitCode}: {standardError.Result.Trim()}");
            }

            return standardOutput.Result;
        }

        string[] InspectArchitectures(string binaryPath)
        {
            var startInfo = new ProcessStartInfo
            {
                FileName = LipoCliPath,
                Arguments = "-archs " + QuoteArgument(binaryPath),
                UseShellExecute = false,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                CreateNoWindow = true
            };
            using var process = Process.Start(startInfo);
            if (process == null)
            {
                throw new InvalidOperationException($"Failed to start macOS architecture inspection tool: {LipoCliPath}");
            }
            System.Threading.Tasks.Task<string> standardOutput = process.StandardOutput.ReadToEndAsync();
            System.Threading.Tasks.Task<string> standardError = process.StandardError.ReadToEndAsync();
            process.WaitForExit();
            System.Threading.Tasks.Task.WaitAll(standardOutput, standardError);
            if (process.ExitCode != 0)
            {
                throw new InvalidOperationException(
                    $"Architecture inspection failed for {binaryPath} with exit code {process.ExitCode}: {standardError.Result.Trim()}");
            }
            return standardOutput.Result
                .Split((char[])null, StringSplitOptions.RemoveEmptyEntries)
                .Distinct(StringComparer.Ordinal)
                .ToArray();
        }

        bool IsWithinBundle(string path)
        {
            return IsWithinRoot(path, bundleFullPath);
        }

        bool IsWithinPhysicalBundle(string path)
        {
            return IsWithinRoot(path, bundlePhysicalPath);
        }

        bool IsAllowedAbsolutePath(string path)
        {
            if (!Path.IsPathRooted(path))
            {
                return false;
            }

            string normalizedPath = Path.GetFullPath(path);
            if (IsWithinRootWithComparison(
                normalizedPath,
                mutableSystemVolumesRoot,
                mutableSystemVolumesComparison))
            {
                return false;
            }
            return allowedAbsoluteRoots.Any(root => IsWithinRootWithComparison(normalizedPath, root.Item1, root.Item2));
        }

        bool IsExplicitlyAllowedAbsolutePath(string path)
        {
            if (!IsAllowedAbsolutePath(path))
            {
                return false;
            }
            string normalizedPath = Path.GetFullPath(path);
            return explicitlyAllowedAbsoluteRoots.Any(root => IsWithinRootWithComparison(normalizedPath, root.Item1, root.Item2));
        }

        bool IsAppleManagedSystemLibraryPath(string path)
        {
            return Path.IsPathRooted(path)
                && IsWithinRootWithComparison(
                    Path.GetFullPath(path),
                    systemLibraryRoot,
                    systemLibraryComparison);
        }

        bool IsPhysicallyWithinAllowedAbsoluteRoot(string path)
        {
            string logicalPath = Path.GetFullPath(path);
            // /System/Library is part of Apple's sealed system volume. Modern macOS may
            // represent its frameworks as Cryptex redirects, arm64e shared-cache images,
            // or dangling on-disk stubs whose implementations exist only in the dyld cache.
            // Those Apple-managed forms cannot be validated like ordinary mutable symlinks.
            if (IsAppleManagedSystemLibraryPath(logicalPath))
            {
                return true;
            }

            string physicalPath = ResolvePhysicalPath(logicalPath);
            string physicalMutableSystemVolumesRoot = ResolvePhysicalPath(mutableSystemVolumesRoot);
            if (IsWithinRootWithComparison(
                physicalPath,
                physicalMutableSystemVolumesRoot,
                ComparisonForAllowedRoot(physicalMutableSystemVolumesRoot)))
            {
                return false;
            }
            return allowedAbsoluteRoots.Any(root =>
            {
                string physicalRoot = ResolvePhysicalPath(root.Item1);
                return IsWithinRootWithComparison(
                    physicalPath,
                    physicalRoot,
                    ComparisonForAllowedRoot(physicalRoot));
            });
        }

        string GetExecutableDirectory(string binaryPath)
        {
            var directory = new DirectoryInfo(Path.GetDirectoryName(binaryPath)!);
            while (directory != null)
            {
                if (string.Equals(directory.Name, "Contents", StringComparison.OrdinalIgnoreCase)
                    && Directory.Exists(Path.Combine(directory.FullName, "MacOS")))
                {
                    string bundleExtension = directory.Parent == null
                        ? string.Empty
                        : directory.Parent.Extension;
                    if (string.Equals(bundleExtension, ".app", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(bundleExtension, ".xpc", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(bundleExtension, ".appex", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(bundleExtension, ".service", StringComparison.OrdinalIgnoreCase)
                        || File.Exists(Path.Combine(directory.FullName, "Info.plist")))
                    {
                        return Path.Combine(directory.FullName, "MacOS");
                    }
                }
                directory = directory.Parent;
            }
            return Path.Combine(bundleFullPath, "Contents", "MacOS");
        }

        string ResolveBundleRelativeReference(
            string value,
            string binaryPath,
            string executableDirectory)
        {
            const string loaderMarker = "@loader_path";
            const string executableMarker = "@executable_path";
            if (value == loaderMarker || value.StartsWith(loaderMarker + "/", StringComparison.Ordinal))
            {
                string suffix = value.Substring(loaderMarker.Length).TrimStart('/');
                return Path.GetFullPath(Path.Combine(Path.GetDirectoryName(binaryPath)!, suffix));
            }
            if (value == executableMarker || value.StartsWith(executableMarker + "/", StringComparison.Ordinal))
            {
                string suffix = value.Substring(executableMarker.Length).TrimStart('/');
                return Path.GetFullPath(Path.Combine(executableDirectory, suffix));
            }
            return null;
        }

        string ResolveRuntimeSearchRoot(
            string value,
            string binaryPath,
            string executableDirectory)
        {
            string resolvedPath = ResolveBundleRelativeReference(value, binaryPath, executableDirectory);
            if (resolvedPath != null && IsWithinBundle(resolvedPath))
            {
                return resolvedPath;
            }
            if (IsAllowedAbsolutePath(value))
            {
                string allowedPath = Path.GetFullPath(value);
                return IsPhysicallyWithinAllowedAbsoluteRoot(allowedPath)
                    ? allowedPath
                    : null;
            }
            return null;
        }

        bool IsExistingPhysicalBundleFile(string path)
        {
            return IsWithinBundle(path)
                && File.Exists(path)
                && IsWithinPhysicalBundle(ResolvePhysicalPath(path));
        }

        bool ExistingFileSupportsArchitecture(string path, string architecture)
        {
            if (IsAppleManagedSystemLibraryPath(path))
            {
                return true;
            }
            if (string.Equals(architecture, "default", StringComparison.Ordinal))
            {
                return true;
            }
            var availableArchitectures = new HashSet<string>(
                InspectArchitectures(path),
                StringComparer.Ordinal);
            return CompatibleValidationArchitectureNames(architecture)
                .Any(availableArchitectures.Contains);
        }

        bool TryResolveDependency(
            string dependency,
            string binaryPath,
            string architecture,
            string executableDirectory,
            IEnumerable<string> effectiveRuntimeSearchRoots,
            out string resolvedBundlePath,
            out bool rejectedExistingCandidate)
        {
            resolvedBundlePath = null;
            rejectedExistingCandidate = false;
            const string rpathMarker = "@rpath";
            try
            {
                string resolvedPath = ResolveBundleRelativeReference(
                    dependency,
                    binaryPath,
                    executableDirectory);
                if (resolvedPath != null)
                {
                    if (!IsExistingPhysicalBundleFile(resolvedPath))
                    {
                        rejectedExistingCandidate = File.Exists(resolvedPath);
                        return false;
                    }
                    resolvedBundlePath = Path.GetFullPath(resolvedPath);
                    return true;
                }
                if (dependency == rpathMarker || dependency.StartsWith(rpathMarker + "/", StringComparison.Ordinal))
                {
                    string suffix = dependency.Substring(rpathMarker.Length).TrimStart('/');
                    foreach (string runtimeSearchRoot in effectiveRuntimeSearchRoots)
                    {
                        string candidatePath = Path.GetFullPath(Path.Combine(runtimeSearchRoot, suffix));
                        if (IsWithinBundle(candidatePath))
                        {
                            if (File.Exists(candidatePath)
                                && !IsWithinPhysicalBundle(ResolvePhysicalPath(candidatePath)))
                            {
                                rejectedExistingCandidate = true;
                                return false;
                            }
                            if (IsExistingPhysicalBundleFile(candidatePath)
                                && StateForDependency(candidatePath, architecture) != null)
                            {
                                resolvedBundlePath = candidatePath;
                                return true;
                            }
                            continue;
                        }
                        if (IsAllowedAbsolutePath(candidatePath))
                        {
                            if (File.Exists(candidatePath))
                            {
                                rejectedExistingCandidate = true;
                                if (IsPhysicallyWithinAllowedAbsoluteRoot(candidatePath)
                                    && ExistingFileSupportsArchitecture(candidatePath, architecture))
                                {
                                    rejectedExistingCandidate = false;
                                    return true;
                                }
                                if (!IsPhysicallyWithinAllowedAbsoluteRoot(candidatePath)
                                    && ExistingFileSupportsArchitecture(candidatePath, architecture))
                                {
                                    return false;
                                }
                                rejectedExistingCandidate = false;
                                continue;
                            }
                            if (IsExplicitlyAllowedAbsolutePath(candidatePath)
                                && IsPhysicallyWithinAllowedAbsoluteRoot(candidatePath))
                            {
                                return true;
                            }
                            continue;
                        }
                        if (File.Exists(candidatePath))
                        {
                            rejectedExistingCandidate = true;
                            if (ExistingFileSupportsArchitecture(candidatePath, architecture))
                            {
                                return false;
                            }
                            rejectedExistingCandidate = false;
                        }
                        continue;
                    }
                    return false;
                }

                bool dependencyExists = File.Exists(dependency);
                bool allowedAbsolutePath = IsAllowedAbsolutePath(dependency)
                    && IsPhysicallyWithinAllowedAbsoluteRoot(dependency)
                    && (!dependencyExists
                        || ExistingFileSupportsArchitecture(dependency, architecture));
                rejectedExistingCandidate = !allowedAbsolutePath && dependencyExists;
                return allowedAbsolutePath;
            }
            catch (Exception exception) when (
                exception is ArgumentException
                || exception is NotSupportedException
                || exception is InvalidOperationException)
            {
                return false;
            }
        }

        string ParseArchitectureHeader(string rawLine)
        {
            string line = rawLine.Trim();
            if (!line.EndsWith(":", StringComparison.Ordinal))
            {
                return null;
            }
            const string architectureMarker = " (architecture ";
            int architectureIndex = line.LastIndexOf(architectureMarker, StringComparison.Ordinal);
            if (architectureIndex < 0)
            {
                return "default";
            }
            int architectureEnd = line.LastIndexOf("):", StringComparison.Ordinal);
            if (architectureEnd <= architectureIndex + architectureMarker.Length)
            {
                return null;
            }
            return line.Substring(
                architectureIndex + architectureMarker.Length,
                architectureEnd - architectureIndex - architectureMarker.Length);
        }

        Dictionary<string, List<string>> ParseLibrariesByArchitecture(
            string output,
            bool acceptUnindented)
        {
            var libraries = new Dictionary<string, List<string>>(StringComparer.Ordinal);
            string architecture = "default";
            foreach (string rawLine in output.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
            {
                string trimmedLine = rawLine.Trim();
                if (trimmedLine.EndsWith(":", StringComparison.Ordinal)
                    && trimmedLine.LastIndexOf(" (architecture ", StringComparison.Ordinal) < 0)
                {
                    architecture = "default";
                    continue;
                }
                string parsedArchitecture = ParseArchitectureHeader(rawLine);
                if (parsedArchitecture != null)
                {
                    architecture = parsedArchitecture;
                    continue;
                }
                if (rawLine.Length == 0 || (!acceptUnindented && !char.IsWhiteSpace(rawLine[0])))
                {
                    continue;
                }

                string library = trimmedLine;
                int metadataIndex = library.IndexOf(" (compatibility version", StringComparison.Ordinal);
                if (metadataIndex >= 0)
                {
                    library = library.Substring(0, metadataIndex);
                }
                if (library.Length > 0)
                {
                    if (!libraries.TryGetValue(architecture, out List<string> architectureLibraries))
                    {
                        architectureLibraries = new List<string>();
                        libraries[architecture] = architectureLibraries;
                    }
                    architectureLibraries.Add(library);
                }
            }
            return libraries;
        }

        Dictionary<string, List<string>> ParseRuntimeSearchPathsByArchitecture(string output)
        {
            var runtimeSearchPaths = new Dictionary<string, List<string>>(StringComparer.Ordinal);
            string architecture = "default";
            foreach (string rawLine in output.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
            {
                string parsedArchitecture = ParseArchitectureHeader(rawLine);
                if (parsedArchitecture != null)
                {
                    architecture = parsedArchitecture;
                    continue;
                }
                string trimmedLine = rawLine.Trim();
                if (!trimmedLine.StartsWith("path ", StringComparison.Ordinal))
                {
                    continue;
                }

                string runtimeSearchPath = trimmedLine.Substring("path ".Length);
                int offsetIndex = runtimeSearchPath.IndexOf(" (offset ", StringComparison.Ordinal);
                if (offsetIndex >= 0)
                {
                    runtimeSearchPath = runtimeSearchPath.Substring(0, offsetIndex);
                }
                if (runtimeSearchPath.Length > 0)
                {
                    if (!runtimeSearchPaths.TryGetValue(architecture, out List<string> architecturePaths))
                    {
                        architecturePaths = new List<string>();
                        runtimeSearchPaths[architecture] = architecturePaths;
                    }
                    architecturePaths.Add(runtimeSearchPath);
                }
            }
            return runtimeSearchPaths;
        }

        Dictionary<string, List<string>> ParseWeakLibrariesByArchitecture(string output)
        {
            var weakLibraries = new Dictionary<string, List<string>>(StringComparer.Ordinal);
            string architecture = "default";
            bool awaitingWeakLibraryName = false;
            foreach (string rawLine in output.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
            {
                string parsedArchitecture = ParseArchitectureHeader(rawLine);
                if (parsedArchitecture != null)
                {
                    architecture = parsedArchitecture;
                    awaitingWeakLibraryName = false;
                    continue;
                }

                string line = rawLine.Trim();
                if (line.StartsWith("cmd ", StringComparison.Ordinal))
                {
                    awaitingWeakLibraryName = string.Equals(
                        line.Substring("cmd ".Length).Trim(),
                        "LC_LOAD_WEAK_DYLIB",
                        StringComparison.Ordinal);
                    continue;
                }
                if (!awaitingWeakLibraryName || !line.StartsWith("name ", StringComparison.Ordinal))
                {
                    continue;
                }

                string library = line.Substring("name ".Length);
                int offsetIndex = library.LastIndexOf(" (offset ", StringComparison.Ordinal);
                library = offsetIndex >= 0 ? library.Substring(0, offsetIndex) : library;
                if (!weakLibraries.TryGetValue(architecture, out List<string> architectureLibraries))
                {
                    architectureLibraries = new List<string>();
                    weakLibraries[architecture] = architectureLibraries;
                }
                architectureLibraries.Add(library);
                awaitingWeakLibraryName = false;
            }
            return weakLibraries;
        }

        Dictionary<string, HashSet<string>> ParseMachOFileTypesByArchitecture(string output)
        {
            var fileTypes = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);
            string architecture = "default";
            foreach (string rawLine in output.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
            {
                string parsedArchitecture = ParseArchitectureHeader(rawLine);
                if (parsedArchitecture != null)
                {
                    architecture = parsedArchitecture;
                    continue;
                }
                foreach (string token in rawLine.Split((char[])null, StringSplitOptions.RemoveEmptyEntries))
                {
                    if (!string.Equals(token, "BUNDLE", StringComparison.Ordinal)
                        && !string.Equals(token, "MH_BUNDLE", StringComparison.Ordinal)
                        && !string.Equals(token, "EXECUTE", StringComparison.Ordinal)
                        && !string.Equals(token, "MH_EXECUTE", StringComparison.Ordinal))
                    {
                        continue;
                    }
                    if (!fileTypes.TryGetValue(architecture, out HashSet<string> architectureFileTypes))
                    {
                        architectureFileTypes = new HashSet<string>(StringComparer.Ordinal);
                        fileTypes[architecture] = architectureFileTypes;
                    }
                    architectureFileTypes.Add(token);
                }
            }
            return fileTypes;
        }

        bool HasMachOFileType(
            Dictionary<string, HashSet<string>> fileTypes,
            string architecture,
            params string[] expectedTypes)
        {
            HashSet<string> architectureFileTypes;
            if (!fileTypes.TryGetValue(architecture, out architectureFileTypes)
                && !fileTypes.TryGetValue("default", out architectureFileTypes))
            {
                return false;
            }
            return expectedTypes.Any(architectureFileTypes.Contains);
        }

        bool validationSucceeded = true;
        var binaryPaths = new List<string>();
        var directoriesToInspect = new Stack<string>();
        directoriesToInspect.Push(bundleFullPath);
        while (directoriesToInspect.Count > 0)
        {
            string directoryPath = directoriesToInspect.Pop();
            foreach (string childDirectoryPath in Directory.EnumerateDirectories(directoryPath))
            {
                var childDirectory = new DirectoryInfo(childDirectoryPath);
                if ((childDirectory.Attributes & FileAttributes.ReparsePoint) != 0)
                {
                    string physicalDirectoryPath;
                    try
                    {
                        physicalDirectoryPath = ResolvePhysicalPath(childDirectoryPath);
                    }
                    catch (InvalidOperationException exception)
                    {
                        Log.LogError(exception.Message);
                        validationSucceeded = false;
                        continue;
                    }
                    if (!IsWithinPhysicalBundle(physicalDirectoryPath))
                    {
                        string relativeDirectoryPath = childDirectoryPath.Substring(bundleFullPath.Length + 1);
                        Log.LogError(
                            $"The macOS application bundle is not self-contained: directory symlink '{relativeDirectoryPath}' resolves outside the application bundle to '{physicalDirectoryPath}'.");
                        validationSucceeded = false;
                    }
                    continue;
                }
                directoriesToInspect.Push(childDirectoryPath);
            }

            foreach (string candidatePath in Directory.EnumerateFiles(directoryPath))
            {
                if (!IsMachO(candidatePath))
                {
                    continue;
                }

                string physicalBinaryPath;
                try
                {
                    physicalBinaryPath = ResolvePhysicalPath(candidatePath);
                }
                catch (InvalidOperationException exception)
                {
                    Log.LogError(exception.Message);
                    validationSucceeded = false;
                    continue;
                }
                if (!IsWithinPhysicalBundle(physicalBinaryPath))
                {
                    string relativeBinaryPath = candidatePath.StartsWith(
                            bundleFullPath + Path.DirectorySeparatorChar,
                            pathComparison)
                        ? candidatePath.Substring(bundleFullPath.Length + 1)
                        : candidatePath;
                    Log.LogError(
                        $"The macOS application bundle is not self-contained: Mach-O file '{relativeBinaryPath}' resolves outside the application bundle to '{physicalBinaryPath}'.");
                    validationSucceeded = false;
                    continue;
                }
                binaryPaths.Add(Path.GetFullPath(candidatePath));
            }
        }

        var pathComparer = pathComparison == StringComparison.OrdinalIgnoreCase
            ? StringComparer.OrdinalIgnoreCase
            : StringComparer.Ordinal;
        var dependenciesByState = new Dictionary<string, List<string>>(StringComparer.Ordinal);
        var runtimeSearchPathsByState = new Dictionary<string, List<string>>(StringComparer.Ordinal);
        var weakDependenciesByState = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);
        var binaryByState = new Dictionary<string, string>(StringComparer.Ordinal);
        var architectureByState = new Dictionary<string, string>(StringComparer.Ordinal);
        var hasInstallIdByState = new Dictionary<string, bool>(StringComparer.Ordinal);
        var isMachOBundleByState = new Dictionary<string, bool>(StringComparer.Ordinal);
        var isMachOExecutableByState = new Dictionary<string, bool>(StringComparer.Ordinal);
        var statesByLogicalBinary = new Dictionary<string, Dictionary<string, string>>(pathComparer);
        var statesByPhysicalBinary = new Dictionary<string, List<Dictionary<string, string>>>(pathComparer);

        string StateKey(string binaryPath, string architecture)
        {
            return binaryPath + "\u001f" + architecture;
        }

        List<string> ValuesForArchitecture(
            Dictionary<string, List<string>> values,
            string architecture)
        {
            if (values.TryGetValue(architecture, out List<string> architectureValues))
            {
                return architectureValues;
            }
            if (values.TryGetValue("default", out List<string> defaultValues))
            {
                return defaultValues;
            }
            return new List<string>();
        }

        foreach (string binaryPath in binaryPaths)
        {
            try
            {
                var installIds = ParseLibrariesByArchitecture(
                    RunInspection("-D", binaryPath),
                    acceptUnindented: true);
                var dependencies = ParseLibrariesByArchitecture(
                    RunInspection("-L", binaryPath),
                    acceptUnindented: false);
                string loadCommands = RunInspection("-l", binaryPath);
                var fileTypes = ParseMachOFileTypesByArchitecture(RunInspection("-hv", binaryPath));
                var runtimeSearchPaths = ParseRuntimeSearchPathsByArchitecture(loadCommands);
                var weakLibraries = ParseWeakLibrariesByArchitecture(loadCommands);
                var architectures = dependencies.Keys
                    .Concat(runtimeSearchPaths.Keys)
                    .Concat(weakLibraries.Keys)
                    .Concat(installIds.Keys)
                    .Concat(fileTypes.Keys)
                    .Distinct(StringComparer.Ordinal)
                    .ToList();
                if (architectures.Count == 1 && architectures[0] == "default")
                {
                    string[] thinArchitectures = InspectArchitectures(binaryPath);
                    if (thinArchitectures.Length != 1)
                    {
                        throw new InvalidOperationException(
                            $"Could not identify one architecture for unsectioned native inspection output: {binaryPath}");
                    }
                    architectures[0] = thinArchitectures[0];
                }
                if (architectures.Count == 0)
                {
                    architectures.Add("default");
                }

                var binaryStates = new Dictionary<string, string>(StringComparer.Ordinal);
                statesByLogicalBinary[Path.GetFullPath(binaryPath)] = binaryStates;
                string physicalBinaryPath = ResolvePhysicalPath(binaryPath);
                if (!statesByPhysicalBinary.TryGetValue(
                    physicalBinaryPath,
                    out List<Dictionary<string, string>> physicalStates))
                {
                    physicalStates = new List<Dictionary<string, string>>();
                    statesByPhysicalBinary[physicalBinaryPath] = physicalStates;
                }
                physicalStates.Add(binaryStates);
                foreach (string architecture in architectures)
                {
                    string state = StateKey(binaryPath, architecture);
                    var architectureInstallIds = new HashSet<string>(
                        ValuesForArchitecture(installIds, architecture),
                        StringComparer.Ordinal);
                    dependenciesByState[state] = ValuesForArchitecture(dependencies, architecture)
                        .Where(dependency => !architectureInstallIds.Contains(dependency))
                        .Distinct(StringComparer.Ordinal)
                        .ToList();
                    runtimeSearchPathsByState[state] = ValuesForArchitecture(runtimeSearchPaths, architecture)
                        .Distinct(StringComparer.Ordinal)
                        .ToList();
                    weakDependenciesByState[state] = new HashSet<string>(
                        ValuesForArchitecture(weakLibraries, architecture),
                        StringComparer.Ordinal);
                    binaryByState[state] = binaryPath;
                    architectureByState[state] = architecture;
                    hasInstallIdByState[state] = architectureInstallIds.Count > 0;
                    isMachOBundleByState[state] = HasMachOFileType(
                        fileTypes,
                        architecture,
                        "BUNDLE",
                        "MH_BUNDLE");
                    isMachOExecutableByState[state] = HasMachOFileType(
                        fileTypes,
                        architecture,
                        "EXECUTE",
                        "MH_EXECUTE");
                    binaryStates[architecture] = state;
                }
            }
            catch (InvalidOperationException exception)
            {
                Log.LogError(exception.Message);
                return false;
            }
        }

        IEnumerable<string> CompatibleValidationArchitectureNames(string architecture)
        {
            yield return architecture;
            if (string.Equals(architecture, "x86_64h", StringComparison.Ordinal))
            {
                yield return "x86_64";
            }
            else if (string.Equals(architecture, "arm64e", StringComparison.Ordinal))
            {
                yield return "arm64";
            }
        }

        string StateForDependency(string binaryPath, string architecture)
        {
            string logicalBinaryPath = Path.GetFullPath(binaryPath);
            if (!statesByLogicalBinary.TryGetValue(logicalBinaryPath, out Dictionary<string, string> states))
            {
                states = new Dictionary<string, string>(StringComparer.Ordinal);
                statesByLogicalBinary[logicalBinaryPath] = states;
            }
            string matchingState = CompatibleValidationArchitectureNames(architecture)
                .Where(states.ContainsKey)
                .Select(compatibleArchitecture => states[compatibleArchitecture])
                .FirstOrDefault();
            if (matchingState != null)
            {
                return matchingState;
            }
            string physicalBinaryPath = ResolvePhysicalPath(logicalBinaryPath);
            if (!statesByPhysicalBinary.TryGetValue(
                    physicalBinaryPath,
                    out List<Dictionary<string, string>> physicalStates))
            {
                return null;
            }
            string physicalState = CompatibleValidationArchitectureNames(architecture)
                .SelectMany(compatibleArchitecture => physicalStates
                    .SelectMany(item => item)
                    .Where(item => string.Equals(
                        item.Key,
                        compatibleArchitecture,
                        StringComparison.Ordinal))
                    .Select(item => item.Value))
                .FirstOrDefault();
            if (physicalState == null)
            {
                return null;
            }
            string aliasState = StateKey(logicalBinaryPath, architecture);
            dependenciesByState[aliasState] = dependenciesByState[physicalState];
            runtimeSearchPathsByState[aliasState] = runtimeSearchPathsByState[physicalState];
            weakDependenciesByState[aliasState] = weakDependenciesByState[physicalState];
            binaryByState[aliasState] = logicalBinaryPath;
            architectureByState[aliasState] = architectureByState[physicalState];
            hasInstallIdByState[aliasState] = hasInstallIdByState[physicalState];
            isMachOBundleByState[aliasState] = isMachOBundleByState[physicalState];
            isMachOExecutableByState[aliasState] = isMachOExecutableByState[physicalState];
            states[architecture] = aliasState;
            return aliasState;
        }

        var ownRuntimeSearchRootsByContext = new Dictionary<string, List<string>>(StringComparer.Ordinal);
        List<string> OwnRuntimeSearchRoots(string state, string launchExecutableDirectory)
        {
            string cacheKey = state + "\u001e" + launchExecutableDirectory;
            if (ownRuntimeSearchRootsByContext.TryGetValue(cacheKey, out List<string> cachedRoots))
            {
                return cachedRoots;
            }
            string binaryPath = binaryByState[state];
            var roots = new List<string>();
            foreach (string runtimeSearchPath in runtimeSearchPathsByState[state])
            {
                string resolvedRoot = null;
                try
                {
                    resolvedRoot = ResolveRuntimeSearchRoot(
                        runtimeSearchPath,
                        binaryPath,
                        launchExecutableDirectory);
                }
                catch (Exception exception) when (
                    exception is ArgumentException
                    || exception is NotSupportedException)
                {
                    resolvedRoot = null;
                }
                if (resolvedRoot != null)
                {
                    if (!roots.Contains(resolvedRoot, pathComparer))
                    {
                        roots.Add(resolvedRoot);
                    }
                    continue;
                }

                string relativeBinaryPath = binaryPath.StartsWith(
                        bundleFullPath + Path.DirectorySeparatorChar,
                        pathComparison)
                    ? binaryPath.Substring(bundleFullPath.Length + 1)
                    : binaryPath;
                Log.LogError(
                    $"The macOS application bundle is not self-contained: '{relativeBinaryPath}' contains non-distributable runtime search path '{runtimeSearchPath}'. "
                    + "Use a normalized bundle-relative or allowed system runtime search path before signing.");
                validationSucceeded = false;
            }
            ownRuntimeSearchRootsByContext[cacheKey] = roots;
            return roots;
        }

        var validatedContexts = new HashSet<string>(StringComparer.Ordinal);
        var reachedAsDependency = new HashSet<string>(StringComparer.Ordinal);

        bool IsLoadablePluginState(string state)
        {
            return !isMachOExecutableByState[state]
                && (isMachOBundleByState[state]
                || binaryByState[state].Split(
                    new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar },
                    StringSplitOptions.RemoveEmptyEntries)
                .Any(segment => segment.EndsWith(".bundle", StringComparison.OrdinalIgnoreCase)));
        }

        string LaunchExecutableDirectory(string state)
        {
            string binaryPath = binaryByState[state];
            string enclosingExecutableDirectory = GetExecutableDirectory(binaryPath);
            string binaryDirectory = Path.GetDirectoryName(binaryPath)!;
            return !hasInstallIdByState[state]
                && !IsLoadablePluginState(state)
                && !string.Equals(binaryDirectory, enclosingExecutableDirectory, pathComparison)
                    ? binaryDirectory
                    : enclosingExecutableDirectory;
        }

        bool IsIndependentLaunchBundle(string directory)
        {
            string extension = Path.GetExtension(directory);
            return string.Equals(extension, ".app", StringComparison.OrdinalIgnoreCase)
                || string.Equals(extension, ".appex", StringComparison.OrdinalIgnoreCase)
                || string.Equals(extension, ".xpc", StringComparison.OrdinalIgnoreCase)
                || string.Equals(extension, ".service", StringComparison.OrdinalIgnoreCase);
        }

        string LaunchScopeForState(string state)
        {
            string directory = Path.GetDirectoryName(binaryByState[state])!;
            while (IsWithinBundle(directory))
            {
                if (string.Equals(directory, bundleFullPath, pathComparison))
                {
                    return bundleFullPath;
                }
                if (IsIndependentLaunchBundle(directory))
                {
                    return directory;
                }
                string parent = Path.GetDirectoryName(directory);
                if (string.IsNullOrWhiteSpace(parent) || parent == directory)
                {
                    break;
                }
                directory = parent;
            }
            return bundleFullPath;
        }

        void ValidateDependencyChain(
            string state,
            IEnumerable<string> inheritedRuntimeSearchRoots,
            string launchExecutableDirectory)
        {
            string binaryPath = binaryByState[state];
            string architecture = architectureByState[state];
            var effectiveRuntimeSearchRoots = DistinctRuntimeSearchRoots(
                OwnRuntimeSearchRoots(state, launchExecutableDirectory).Concat(
                    inheritedRuntimeSearchRoots));
            string contextKey = state + "\u001e" + launchExecutableDirectory + "\u001e" + string.Join(
                "\u001d",
                effectiveRuntimeSearchRoots);
            if (!validatedContexts.Add(contextKey))
            {
                return;
            }

            foreach (string dependency in dependenciesByState[state])
            {
                string resolvedBundlePath;
                bool rejectedExistingCandidate;
                bool dependencyResolved = TryResolveDependency(
                        dependency,
                        binaryPath,
                        architecture,
                        launchExecutableDirectory,
                        effectiveRuntimeSearchRoots,
                        out resolvedBundlePath,
                        out rejectedExistingCandidate);
                if (dependencyResolved && resolvedBundlePath == null)
                {
                    continue;
                }
                if (!dependencyResolved
                    && !rejectedExistingCandidate
                    && weakDependenciesByState[state].Contains(dependency))
                {
                    continue;
                }

                string dependencyState = resolvedBundlePath == null
                    ? null
                    : StateForDependency(resolvedBundlePath, architecture);
                if (dependencyState != null)
                {
                    reachedAsDependency.Add(dependencyState);
                    ValidateDependencyChain(
                        dependencyState,
                        effectiveRuntimeSearchRoots,
                        launchExecutableDirectory);
                    continue;
                }

                string relativeBinaryPath = binaryPath.StartsWith(
                        bundleFullPath + Path.DirectorySeparatorChar,
                        pathComparison)
                    ? binaryPath.Substring(bundleFullPath.Length + 1)
                    : binaryPath;
                Log.LogError(
                    $"The macOS application bundle is not self-contained: '{relativeBinaryPath}' ({architecture}) depends on non-distributable or unresolved library '{dependency}'. "
                    + "Rebuild with the official Microsoft .NET SDK/runtime, or bundle and rewrite the dependency before signing.");
                validationSucceeded = false;
            }
        }

        var launchStates = dependenciesByState.Keys
            .Where(state => isMachOExecutableByState[state]
                && !hasInstallIdByState[state]
                && !IsLoadablePluginState(state)
                && string.Equals(
                    Path.GetDirectoryName(binaryByState[state]),
                    LaunchExecutableDirectory(state),
                    pathComparison))
            .ToList();
        foreach (string state in launchStates)
        {
            ValidateDependencyChain(
                state,
                new string[0],
                LaunchExecutableDirectory(state));
        }
        foreach (string state in dependenciesByState.Keys.ToList())
        {
            bool validateForEveryFeasibleLauncher = IsLoadablePluginState(state)
                || hasInstallIdByState[state];
            bool requiresHostLaunchContext = !isMachOExecutableByState[state]
                || hasInstallIdByState[state];
            if (!launchStates.Contains(state, StringComparer.Ordinal)
                && (!reachedAsDependency.Contains(state) || validateForEveryFeasibleLauncher))
            {
                string launchExecutableDirectory = LaunchExecutableDirectory(state);
                string moduleDirectory = Path.GetDirectoryName(binaryByState[state])!;
                var architectureLaunchStates = launchStates.Where(launchState =>
                        CompatibleValidationArchitectureNames(architectureByState[launchState])
                            .Contains(architectureByState[state], StringComparer.Ordinal))
                    .ToList();
                var sameDirectoryLaunchStates = architectureLaunchStates.Where(launchState => string.Equals(
                        Path.GetDirectoryName(binaryByState[launchState]),
                        moduleDirectory,
                        pathComparison))
                    .ToList();
                var enclosingLaunchStates = architectureLaunchStates.Where(launchState => string.Equals(
                                LaunchExecutableDirectory(launchState),
                                launchExecutableDirectory,
                                pathComparison))
                            .ToList();
                string launchScope = LaunchScopeForState(state);
                var sameScopeLaunchStates = architectureLaunchStates.Where(launchState =>
                        isMachOExecutableByState[launchState]
                        && string.Equals(
                            LaunchScopeForState(launchState),
                            launchScope,
                            pathComparison))
                    .ToList();
                var feasibleLaunchStates = !requiresHostLaunchContext
                    ? new List<string>()
                    : sameDirectoryLaunchStates
                        .Concat(enclosingLaunchStates)
                        .Concat(sameScopeLaunchStates)
                        .Distinct(StringComparer.Ordinal)
                        .ToList();
                if (feasibleLaunchStates.Count == 0)
                {
                    ValidateDependencyChain(
                        state,
                        new string[0],
                        launchExecutableDirectory);
                }
                else
                {
                    foreach (string launchState in feasibleLaunchStates)
                    {
                        string feasibleLaunchExecutableDirectory = LaunchExecutableDirectory(launchState);
                        ValidateDependencyChain(
                            state,
                            OwnRuntimeSearchRoots(launchState, feasibleLaunchExecutableDirectory),
                            feasibleLaunchExecutableDirectory);
                    }
                }
            }
        }

        if (!validationSucceeded)
        {
            return false;
        }

      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="RoiBuildActionsResolveMacApplicationBundlePath">
    <PropertyGroup>
      <RoiBuildActionsMacApplicationBundlePath Condition="'$(RoiBuildActionsMacApplicationBundlePath)' == '' and '$(AppBundleDir)' != ''">$(AppBundleDir)</RoiBuildActionsMacApplicationBundlePath>
      <RoiBuildActionsMacApplicationBundlePath Condition="'$(RoiBuildActionsMacApplicationBundlePath)' != '' and !$([System.IO.Path]::IsPathRooted('$(RoiBuildActionsMacApplicationBundlePath)'))">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(RoiBuildActionsMacApplicationBundlePath)'))</RoiBuildActionsMacApplicationBundlePath>
      <RoiBuildActionsMacApplicationBundlePath Condition="'$(RoiBuildActionsMacApplicationBundlePath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutputPath)', '$(AssemblyName).app'))</RoiBuildActionsMacApplicationBundlePath>
    </PropertyGroup>
  </Target>

  <Target Name="RoiBuildActionsResolveMacBundleVersions"
          Condition="'$(RoiBuildActionsEnableMacBundleVersionSynchronization)' == 'true'">
    <PropertyGroup>
      <_RoiBuildActionsMacBundleShortVersion Condition="'$(RoiBuildActionsMacBundleShortVersion)' != ''">$(RoiBuildActionsMacBundleShortVersion)</_RoiBuildActionsMacBundleShortVersion>
      <_RoiBuildActionsMacBundleShortVersion Condition="'$(_RoiBuildActionsMacBundleShortVersion)' == ''">$(Version)</_RoiBuildActionsMacBundleShortVersion>
      <_RoiBuildActionsMacBundleVersion Condition="'$(RoiBuildActionsMacBundleVersion)' != ''">$(RoiBuildActionsMacBundleVersion)</_RoiBuildActionsMacBundleVersion>
      <_RoiBuildActionsMacBundleVersion Condition="'$(_RoiBuildActionsMacBundleVersion)' == ''">$(Version)</_RoiBuildActionsMacBundleVersion>
      <_RoiBuildActionsMacBundleVersionPartialInfoPlistPath Condition="'$(RoiBuildActionsMacBundleVersionPartialInfoPlistPath)' != '' and $([System.IO.Path]::IsPathRooted('$(RoiBuildActionsMacBundleVersionPartialInfoPlistPath)'))">$(RoiBuildActionsMacBundleVersionPartialInfoPlistPath)</_RoiBuildActionsMacBundleVersionPartialInfoPlistPath>
      <_RoiBuildActionsMacBundleVersionPartialInfoPlistPath Condition="'$(_RoiBuildActionsMacBundleVersionPartialInfoPlistPath)' == '' and '$(RoiBuildActionsMacBundleVersionPartialInfoPlistPath)' != ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(RoiBuildActionsMacBundleVersionPartialInfoPlistPath)'))</_RoiBuildActionsMacBundleVersionPartialInfoPlistPath>
      <_RoiBuildActionsMacBundleVersionPartialInfoPlistPath Condition="'$(_RoiBuildActionsMacBundleVersionPartialInfoPlistPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'roi-build-actions', 'BundleVersion.$(_RoiBuildActionsMacBundleShortVersion).$(_RoiBuildActionsMacBundleVersion).partial.plist'))</_RoiBuildActionsMacBundleVersionPartialInfoPlistPath>
    </PropertyGroup>
    <Error Condition="'$(_RoiBuildActionsMacBundleShortVersion)' == ''"
           Text="Version or RoiBuildActionsMacBundleShortVersion must provide the macOS CFBundleShortVersionString." />
    <Error Condition="'$(_RoiBuildActionsMacBundleVersion)' == ''"
           Text="Version or RoiBuildActionsMacBundleVersion must provide the macOS CFBundleVersion." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_RoiBuildActionsMacBundleShortVersion)', '^[0-9]+\.[0-9]+\.[0-9]+$'))"
           Text="The macOS CFBundleShortVersionString '$(_RoiBuildActionsMacBundleShortVersion)' is invalid. Use three numeric components, or set RoiBuildActionsMacBundleShortVersion to an explicit mapping." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_RoiBuildActionsMacBundleVersion)', '^[0-9]{1,4}(\.[0-9]{1,2}){0,2}$'))"
           Text="The macOS CFBundleVersion '$(_RoiBuildActionsMacBundleVersion)' is invalid. Use one to three numeric components (four digits in the first component and two in later components), or set RoiBuildActionsMacBundleVersion to an explicit monotonically increasing mapping." />
  </Target>

  <Target Name="RoiBuildActionsPrepareMacBundleVersionManifest"
          BeforeTargets="_CompileAppManifestInputs"
          DependsOnTargets="RoiBuildActionsResolveMacBundleVersions"
          Condition="'$(Configuration)' == 'Release' and ('$(RoiBuildActionsEnableMacNotarizedPackage)' == 'true' or '$(RoiBuildActionsEnableMacPackageNotarization)' == 'true' or '$(RoiBuildActionsEnableMacDistributionPackage)' == 'true') and '$(RoiBuildActionsEnableMacBundleVersionSynchronization)' == 'true'">
    <RoiBuildActionsWriteMacBundleVersionManifestTask
        ManifestPath="$(_RoiBuildActionsMacBundleVersionPartialInfoPlistPath)"
        BundleShortVersion="$(_RoiBuildActionsMacBundleShortVersion)"
        BundleVersion="$(_RoiBuildActionsMacBundleVersion)" />
    <ItemGroup>
      <PartialAppManifest Include="$(_RoiBuildActionsMacBundleVersionPartialInfoPlistPath)">
        <Overwrite>true</Overwrite>
      </PartialAppManifest>
      <FileWrites Include="$(_RoiBuildActionsMacBundleVersionPartialInfoPlistPath)" />
    </ItemGroup>
  </Target>

  <Target Name="_RoiBuildActionsValidateMacBundleVersionsForPackaging"
          AfterTargets="Codesign"
          BeforeTargets="$(RoiBuildActionsMacPackageCreationTarget)"
          DependsOnTargets="RoiBuildActionsValidateMacBundleVersions"
          Condition="'$(Configuration)' == 'Release' and ('$(RoiBuildActionsEnableMacNotarizedPackage)' == 'true' or '$(RoiBuildActionsEnableMacPackageNotarization)' == 'true' or '$(RoiBuildActionsEnableMacDistributionPackage)' == 'true') and '$(RoiBuildActionsEnableMacBundleVersionSynchronization)' == 'true'" />

  <Target Name="RoiBuildActionsValidateMacBundleVersions"
          DependsOnTargets="RoiBuildActionsResolveMacApplicationBundlePath;RoiBuildActionsResolveMacBundleVersions;RoiBuildActionsVendorDetectedHomebrewBrotli"
          Condition="'$(Configuration)' == 'Release' and '$(RoiBuildActionsEnableMacBundleVersionSynchronization)' == 'true'">
    <PropertyGroup>
      <_RoiBuildActionsMacBuiltInfoPlistPath>$([MSBuild]::NormalizePath('$(RoiBuildActionsMacApplicationBundlePath)', 'Contents', 'Info.plist'))</_RoiBuildActionsMacBuiltInfoPlistPath>
    </PropertyGroup>
    <RoiBuildActionsValidateMacBundleVersionTask
        ManifestPath="$(_RoiBuildActionsMacBuiltInfoPlistPath)"
        PlutilCli="$(RoiBuildActionsPlutilCli)"
        ExpectedBundleShortVersion="$(_RoiBuildActionsMacBundleShortVersion)"
        ExpectedBundleVersion="$(_RoiBuildActionsMacBundleVersion)" />
  </Target>

  <Target Name="_RoiBuildActionsVendorDetectedHomebrewBrotliForPackaging"
          AfterTargets="Codesign"
          BeforeTargets="RoiBuildActionsValidateMacNativeDependencies;$(RoiBuildActionsMacPackageCreationTarget)"
          DependsOnTargets="RoiBuildActionsVendorDetectedHomebrewBrotli"
          Condition="'$(_RoiBuildActionsIsMacOS)' == 'true' and '$(Configuration)' == 'Release' and ('$(RoiBuildActionsEnableMacNotarizedPackage)' == 'true' or '$(RoiBuildActionsEnableMacPackageNotarization)' == 'true' or '$(RoiBuildActionsEnableMacDistributionPackage)' == 'true') and '$(RoiBuildActionsEnableMacHomebrewBrotliVendoring)' == 'true' and '$(RoiBuildActionsDisableMacHomebrewBrotliVendoring)' != 'true'" />

  <Target Name="RoiBuildActionsVendorDetectedHomebrewBrotli"
          DependsOnTargets="RoiBuildActionsResolveMacApplicationBundlePath"
          Condition="'$(_RoiBuildActionsIsMacOS)' == 'true' and '$(Configuration)' == 'Release' and '$(RoiBuildActionsEnableMacHomebrewBrotliVendoring)' == 'true' and '$(RoiBuildActionsDisableMacHomebrewBrotliVendoring)' != 'true'">
    <Error Condition="!Exists('$(RoiBuildActionsMacApplicationBundlePath)')"
           Text="The macOS application bundle whose Homebrew Brotli dependencies should be vendored does not exist: $(RoiBuildActionsMacApplicationBundlePath)" />
    <PropertyGroup>
      <_RoiBuildActionsMacBrotliSigningIdentity Condition="'$(CodesignKey)' != ''">$(CodesignKey)</_RoiBuildActionsMacBrotliSigningIdentity>
      <_RoiBuildActionsMacBrotliSigningIdentity Condition="'$(_RoiBuildActionsMacBrotliSigningIdentity)' == '' and '$(RoiBuildActionsMacApplicationSigningKey)' != ''">$(RoiBuildActionsMacApplicationSigningKey)</_RoiBuildActionsMacBrotliSigningIdentity>
      <_RoiBuildActionsMacBrotliSigningIdentity Condition="'$(_RoiBuildActionsMacBrotliSigningIdentity)' == ''">-</_RoiBuildActionsMacBrotliSigningIdentity>
      <_RoiBuildActionsMacFallbackEntitlements Condition="'$(CodeSignEntitlements)' != '' and $([System.IO.Path]::IsPathRooted('$(CodeSignEntitlements)'))">$(CodeSignEntitlements)</_RoiBuildActionsMacFallbackEntitlements>
      <_RoiBuildActionsMacFallbackEntitlements Condition="'$(CodeSignEntitlements)' != '' and !$([System.IO.Path]::IsPathRooted('$(CodeSignEntitlements)'))">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(CodeSignEntitlements)'))</_RoiBuildActionsMacFallbackEntitlements>
      <_RoiBuildActionsMacFallbackEntitlements Condition="'$(_RoiBuildActionsMacFallbackEntitlements)' == ''">-</_RoiBuildActionsMacFallbackEntitlements>
    </PropertyGroup>
    <ItemGroup>
      <_RoiBuildActionsMacBrotliAdditionalAllowedNativeDependencyPrefix Include="$(RoiBuildActionsMacAdditionalAllowedNativeDependencyPrefixes)"
                                                                         Condition="'$(RoiBuildActionsMacAdditionalAllowedNativeDependencyPrefixes)' != ''" />
    </ItemGroup>
    <RoiBuildActionsVendorHomebrewBrotliTask
        ApplicationBundlePath="$(RoiBuildActionsMacApplicationBundlePath)"
        ApplicationSigningIdentity="$(_RoiBuildActionsMacBrotliSigningIdentity)"
        FallbackEntitlementsPath="$(_RoiBuildActionsMacFallbackEntitlements)"
        HomebrewPrefix="$(RoiBuildActionsMacHomebrewPrefix)"
        AdditionalAllowedPrefixes="@(_RoiBuildActionsMacBrotliAdditionalAllowedNativeDependencyPrefix)"
        OtoolCli="$(RoiBuildActionsOtoolCli)"
        InstallNameToolCli="$(RoiBuildActionsInstallNameToolCli)"
        LipoCli="$(RoiBuildActionsLipoCli)"
        CodesignCli="$(RoiBuildActionsCodesignCli)" />
  </Target>

  <Target Name="_RoiBuildActionsValidateMacNativeDependenciesForPackaging"
          AfterTargets="Codesign"
          BeforeTargets="$(RoiBuildActionsMacPackageCreationTarget)"
          DependsOnTargets="RoiBuildActionsValidateMacNativeDependencies"
          Condition="'$(Configuration)' == 'Release' and ('$(RoiBuildActionsEnableMacNotarizedPackage)' == 'true' or '$(RoiBuildActionsEnableMacPackageNotarization)' == 'true' or '$(RoiBuildActionsEnableMacDistributionPackage)' == 'true') and '$(RoiBuildActionsEnableMacNativeDependencyValidation)' == 'true'" />

  <Target Name="RoiBuildActionsValidateMacNativeDependencies"
          DependsOnTargets="RoiBuildActionsResolveMacApplicationBundlePath;RoiBuildActionsVendorDetectedHomebrewBrotli"
          Condition="'$(Configuration)' == 'Release' and '$(RoiBuildActionsEnableMacNativeDependencyValidation)' == 'true'">
    <Error Condition="!Exists('$(RoiBuildActionsMacApplicationBundlePath)')"
           Text="The macOS application bundle whose native dependencies should be validated does not exist: $(RoiBuildActionsMacApplicationBundlePath)" />
    <ItemGroup>
      <_RoiBuildActionsMacAdditionalAllowedNativeDependencyPrefix Include="$(RoiBuildActionsMacAdditionalAllowedNativeDependencyPrefixes)"
                                                                   Condition="'$(RoiBuildActionsMacAdditionalAllowedNativeDependencyPrefixes)' != ''" />
    </ItemGroup>
    <RoiBuildActionsValidateMacNativeDependenciesTask
        CliPath="$(RoiBuildActionsOtoolCli)"
        LipoCliPath="$(RoiBuildActionsLipoCli)"
        ApplicationBundlePath="$(RoiBuildActionsMacApplicationBundlePath)"
        AdditionalAllowedPrefixes="@(_RoiBuildActionsMacAdditionalAllowedNativeDependencyPrefix)" />
  </Target>
</Project>
